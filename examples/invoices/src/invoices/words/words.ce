(** The words of the invoices in French, for the server (its errors, read by the door into the language of each
    request) and for the pages (the same catalogue: i18n.Say(words.Words, lang, message)), the admin pages of the
    invoices too (pages.Run(words = Words)). Centauri's own words, and those of std/check's shapes, come with Centauri
    (i18n.Centauri), those of its admin pages with them (pages.Words). *)
use deps/www-celestial/centauri/src/i18n

(** The catalogue of the invoices.

      i18n.Say(Words, "fr", "Invoice 12 is paid already.") --> "La facture 12 est déjà payée."
      i18n.Say(Words, "fr", "{N} unpaid invoices", {N: 1}) --> "1 facture impayée" *)
Words = i18n.Catalog("fr", [
  ["Invoice {Number} is paid already.", "La facture {Number} est déjà payée."],
  ["Invoice {Number} is paid: it stays as it is.", "La facture {Number} est payée : elle reste telle qu’elle est."],
  ["Invoice {Number} is paid: it stays.", "La facture {Number} est payée : elle reste."],
  ["Another client has this e-mail.", "Un autre client a cette adresse e-mail."],
  ["This client has invoices: it stays.", "Ce client a des factures : il reste."],
  ["An invoice of this client came meanwhile: it stays.", "Une facture de ce client est arrivée entre-temps : il reste."],
  ["This invoice has no scan.", "Cette facture n’a pas de scan."],
  ["This answer names no invoice.", "Cette réponse ne nomme aucune facture."],
  ["A due date on or after the date.", "Une échéance le jour de la facture ou après."],
  ["The total may not pass 1,000,000,000.", "Le total ne peut pas dépasser 1 000 000 000."],
  ["This client was deleted meanwhile.", "Ce client a été supprimé entre-temps."],
  ["{N} unpaid invoices", {one: "{N} facture impayée", other: "{N} factures impayées"}],
  ["Invoices — admin", "Factures — administration"],
  ["Invoices", "Factures"],
  ["Invoice", "Facture"],
  ["Number", "Numéro"],
  ["Client", "Client"],
  ["Bill to", "Facturé à"],
  ["Status", "Statut"],
  ["Total", "Total"],
  ["Mark paid", "Marquer payée"],
  ["Unpaid", "Impayées"],
  ["Unpaid invoices", "Factures impayées"],
  ["Unpaid by office (€)", "Impayés par cabinet (€)"],
  ["Unpaid by office", "Impayés par cabinet"],
  ["office", "cabinet"],
  ["Office", "Cabinet"],
  ["Due", "Échéance"],
  ["Paid.", "Payée."],
  ["paid", "payée"],
  ["unpaid", "impayée"],
  ["draft", "brouillon"],
  ["Choose an invoice to mark it paid.", "Choisissez une facture pour la marquer payée."],
  ["Mark invoice {Number} of office {Office} paid", "Marquer payée la facture {Number} du cabinet {Office}"],
  ["The CSV export of the invoices with the country of the client.", "L’export CSV des factures avec le pays du client."],
])
