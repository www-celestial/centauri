(* What the database keeps: clients, invoices and their lines, each of its tenant (an office), and two rules. *)
use deps/www-celestial/cepheus/cesia/cepheus
use deps/www-celestial/centauri/src/app

(** A client. Search is its name folded (text.Fold), for the search as one types; Key, unique, is "tenant/e-mail";
    Overdue is given by the rule Overdue, never written. *)
Client = app.Kind("client", {Tenant: cepheus.Link(), Name: cepheus.Text(), Search: cepheus.Text(), Email: cepheus.Text(),
  Key: cepheus.Text(unique = true), City: cepheus.Text(), Overdue: cepheus.Bool()})

(** An invoice: BillTo is the client's name when it was made, as an invoice keeps it; Status "unpaid", "late" or
    "paid"; Total the sum of its lines. *)
Invoice = app.Kind("invoice", {Tenant: cepheus.Link(), Number: cepheus.Int(), Client: cepheus.Link(), BillTo: cepheus.Text(),
  Search: cepheus.Text(), Date: cepheus.Date(), Due: cepheus.Date(), Status: cepheus.Text(), Total: cepheus.Money(2), PaidAt: cepheus.Date()})

(** A line of an invoice. *)
Line = app.Kind("line", {Tenant: cepheus.Link(), Invoice: cepheus.Link(), Position: cepheus.Int(), Label: cepheus.Text(),
  Quantity: cepheus.Int(), Price: cepheus.Money(2)})

(** A client with a late invoice is overdue: the database adds the fact, and takes it away with the last late one. *)
Overdue = cepheus.Rule("overdue", 2, (c, i) -> {Where: [[i, Invoice.Client, c], [i, Invoice.Status, "late"]], Then: [c, Client.Overdue, true]})

(** No invoice of a client without a name (deleted): a group that deletes a client who has one, or gives one to a
    deleted client, is refused, whatever the order of two requests that do both at once. *)
NoInvoiceOfDeleted = cepheus.Rule("no-invoice-of-a-deleted-client", 3, (c, i, n) -> {Where: [[i, Invoice.Client, c], cepheus.Not([c, Client.Name, n])], Then: cepheus.Never})

Kinds = [Client, Invoice, Line]
Rules = [Overdue, NoInvoiceOfDeleted]
