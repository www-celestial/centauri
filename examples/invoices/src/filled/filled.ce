(** The invoices on a database in memory filled as a month of a small platform would be: five offices, their clients and
    invoices (some paid), an accountant invited, a key of a program, two-factor and a passkey of an owner, the flag of the export opened to one office, sign-ins that failed, a request of another site, a job of mail that died
    and a report that waits. What the tutorial of the admin pages shows (tools/admin-serve.ce) and what their test in a
    browser plays (tools/admin-shot.ce). The super-admin is super@app.test, password "correct horse super". *)
use deps/www-celestial/cepheus/cesia/cepheus
use deps/www-celestial/centauri/src/api
use deps/www-celestial/centauri/src/app
use deps/www-celestial/centauri/src/apptest
use deps/www-celestial/centauri/src/auth
use deps/www-celestial/centauri/src/jobs
use src/invoices
use src/invoices/endpoints as e
use std/dict
use std/list
use std/math
use std/result
use std/sys
use std/value

defn App(port, rows = 0, more = {})
  (** The app in memory, its data made, ready to serve on port: an Ok of its test t. more adds settings, as those of
      TLS and HTTP/3 of tools/quic-check.ce. *)
  t = apptest.Start(invoices.App, settings = dict.Merge({Origin: "http://127.0.0.1:$port", AdminPath: "/admin", LogRequests: "false"}, more), now = missing)?
  boss = t.Super()?
  offices = [["ada@example.com", "Ada", "Martin & Co"], ["bruno@example.com", "Bruno", "Bruno Conseil"], ["chloe@example.com", "Chloé", "Atelier Chloé"],
    ["dan@example.com", "Dan", "Dan & Fils"], ["eva@example.com", "Eva", "Eva Studio"]]
  owners = []
  for o in offices
    owners = list.Append(t.SignUp({Email: o[1], Password: "correct horse battery", Name: o[2], Tenant: o[3]})?, owners)
  end
  ada = owners[1]
  bo = t.SignUp({Email: "bo@example.com", Password: "another long secret", Name: "Bo", Invite: ada.Call(api.Invite, {Email: "bo@example.com", Roles: ["accountant"]})?.Code})?
  _ = ada.Call(api.NewKey, {Name: "Accounting robot", Roles: ["accountant"], Days: 90})?
  (* Bruno turned two-factor on and keeps a passkey: what the admin takes away when he loses his phone *)
  bruno = owners[2]
  setup = bruno.Call(api.TotpStart)?
  _ = bruno.Call(api.TotpConfirm, {Code: auth.TotpCode(setup.Secret, t.Env.Now(), t.Env)?})?
  device = apptest.Device(t)?
  ceremony = bruno.Call(api.PasskeyNew)?
  _ = bruno.Call(api.PasskeyAdd, {Ticket: ceremony.Ticket, Credential: apptest.Made(device, ceremony.Options, t).Credential, Name: "Bruno's phone"})?
  _ = boss.Call(api.AdminFlag, {name: "export.country", Tenant: ada.Tenant, On: true})?
  lines = [{Label: "Design", Quantity: 3, Price: 400}, {Label: "Hosting", Quantity: 1, Price: 80.5}]
  for k in 1..value.Len(owners)
    o = owners[k]
    c = o.Call(e.AddClient, {Name: "Client $k", Email: "client$k@example.com", City: "Lyon"})?
    for m in 1..(3 + k)
      inv = o.Call(e.AddInvoice, {Client: c.Id, Date: "2026-10-0$(1 + math.Mod(m, 9))", Due: if math.Mod(m, 2) == 0 "2026-10-31" else "2026-12-01" end, Lines: lines})?
      if math.Mod(m, 3) == 0
        _ = o.Call(e.Pay, {id: inv.Id})?
      end
    end
  end
  k = 0
  while k < rows
    (* many clients of Ada's office, written 500 a group, as an import would *)
    m = list.Min([500, rows - k])
    ops = []
    for j in 1..m
      n = k + j
      ops = list.Concat(ops, app.Facts(invoices.Client, cepheus.New(j), {Tenant: ada.Tenant, Name: "Client n° $n", Search: "client n° $n", Email: "c$n@example.org",
        Key: "$(ada.Tenant)/c$n@example.org", City: if math.Mod(n, 2) == 0 "Paris" else "Lyon" end, Country: "FR"}))
    end
    cepheus.Write(ops, t.Db)?
    k += m
  end
  (* signs of trouble: sign-ins that fail, a request of another site, a job that died, one that waits *)
  for k in 1..4
    _ = t.SignIn("ada@example.com", "not the password at all")
  end
  _ = t.Raw("POST", "/clients", body = "{}", headers = [{Name: "origin", Value: "https://evil.example"}, {Name: "sec-fetch-site", Value: "cross-site"}])
  _ = cepheus.Insert(jobs.Job, {Kind: "centauri.mail", Args: "{\"To\":\"ada@example.com\"}", State: "dead", RunAt: sys.Now() - 3600, Tries: 10,
    Error: "550 mailbox unavailable", Key: "mail-dead-1"}, t.Db)?
  _ = cepheus.Insert(jobs.Job, {Kind: "report", Args: "{}", State: "ready", RunAt: sys.Now() + 86400, Tries: 0, Error: "", Key: "report-tomorrow"}, t.Db)?
  result.Ok(t)
end
