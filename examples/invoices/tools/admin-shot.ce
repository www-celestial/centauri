(** The test of the admin pages in a browser: the invoices and their admin served in this program (tools/admin-serve.ce,
    a database in memory filled with a month), Chrome without a window opens /admin, driven by its DevTools protocol over
    std/websocket; tools/admin-play.js, evaluated in the page, plays a super-admin who signs in, visits each page, disables
    a user, changes an invoice in place (markup typed in it stays a text), marks one paid by the app's own action, reads
    the audit trail and signs out; each page visited fits the window. A picture of each page goes to OUT (shots/ by
    default). LANG, en by default, is the language of the browser: with fr the pages speak French, and the player reads
    them in French. With DOCS, a folder, it plays instead the steps that the book shows, and puts in DOCS the picture of
    the part of the page that each shows (admin-NAME.png), as Centauri's tools/shots.sh asks for the book in English
    and in French. CHROME names the browser, a Chrome or a chrome-headless-shell; its profile is in PROFILE
    (/tmp/centauri-admin-shot). Build the pages first: cesia build --target wasm admin/page.ce. *)
use deps/www-celestial/centauri/src/app
use src/filled
use std/dict
use std/encode
use std/fiber
use std/http
use std/io
use std/json
use std/list
use std/net
use std/result
use std/sys
use std/text
use std/value
use std/websocket

defn env(name, default)
  v = sys.Env(name)
  if value.IsText(v) and v != "" v else default end
end

defn ask(conn, id, method, params)
  (** A command of the DevTools protocol and its result, the messages before it left aside. *)
  _ = websocket.Send(json.Text({id: id, method: method, params: params}), conn)
  while true
    m = json.Parse(fiber.Receive(conn.Messages, timeout = 60)?)?
    if value.IsDict(m) and "id" in m and m["id"] == id
      return if "error" in m result.Err({Kind: "cdp", Message: json.Text(m["error"])}) else result.Ok(m["result"]) end
    end
  end
end

defn evaluated(conn, id, expression)
  (** The value of an expression evaluated in the page, its promise awaited. *)
  r = ask(conn, id, "Runtime.evaluate", {expression: expression, awaitPromise: true, returnByValue: true})?
  result.Ok(dict.GetOr("value", "", r["result"]))
end

defn pictured(conn, id, path, clip = missing)
  (** A picture of the page, or of the box clip of it ({x, y, width, height} in pixels), in a file. *)
  params = if value.IsMissing(clip) {format: "png"} else {format: "png", clip: dict.Put("scale", 1, clip)} end
  s = ask(conn, id, "Page.captureScreenshot", params)?
  sys.Write(path, encode.Unbase64(s["data"])?)
end

(* The steps the book shows, each [step, its argument, the name of its picture, the part of the page it shows]: the
   part from a node to another, or to a height, by role and name (a name that ends with * by its start), right of the
   menu unless wide. *)
docSteps = [["lang", "en", missing, missing],
  ["signInForm", missing, "signin", {top: ["heading", "Invoices — admin"], bottom: ["button", "Sign in"], wide: true}],
  ["submit", missing, missing, missing], ["signedIn", missing, missing, missing],
  ["visit", "Dashboard", "dashboard", {top: ["heading", "Dashboard"], bottom: ["img", "Requests a second"]}],
  ["visit", "Users", missing, missing], ["askDisable", missing, "users-disable", {top: ["heading", "Users"], bottom: ["button", "No"]}], ["yes", missing, missing, missing],
  ["openUser", missing, "user-factors", {top: ["heading", "User *"], bottom: ["button", "No"]}], ["yes", missing, missing, missing],
  ["openTenant", missing, "tenant-invite", {top: ["heading", "Tenant *"], bottom: ["text", "Done."]}],
  ["visit", "Events", "events", {top: ["heading", "Events"], height: 330}], ["live", missing, "events-live", {top: ["heading", "Events"], height: 250}],
  ["visit", "Log", "log", {top: ["heading", "Log"], height: 300}],
  ["visit", "Jobs", missing, missing], ["askRetry", missing, "jobs-retry", {top: ["heading", "Jobs"], bottom: ["button", "No"]}], ["yes", missing, missing, missing],
  ["visit", "Webhooks", "webhooks", {top: ["heading", "Webhooks"], height: 330}], ["visit", "Files", "files", {top: ["heading", "Files"], height: 220}],
  ["visit", "Settings", "settings", {top: ["heading", "Settings"], height: 360}],
  ["visit", "Data", missing, missing], ["edit", "Martin & Co, accounts", "data-edit", {top: ["heading", "Invoices"], bottom: ["textbox", "Total"]}],
  ["visit", "Unpaid", missing, missing], ["askPay", missing, "unpaid-pay", {top: ["heading", "Unpaid invoices"], bottom: ["button", "No"]}], ["yes", missing, missing, missing],
  ["visit", "Audit", "audit", {top: ["heading", "Audit trail"], height: 260}],
  ["visit", "Keys", missing, missing], ["askRevoke", missing, "keys-revoke", {top: ["heading", "Keys of programs"], bottom: ["button", "No"]}], ["yes", missing, missing, missing],
  ["visit", "Flags", missing, missing], ["flag", missing, "flags-on", {top: ["heading", "Feature flags"], bottom: ["text", "Done."]}],
  ["signOut", missing, missing, missing], ["signedOut", missing, missing, missing],
  ["secondStep", missing, "second-step", {top: ["heading", "Invoices — admin"], bottom: ["button", "Send"], wide: true}]]

defn waitReady(conn, n, start)
  (** Waits for the page to have loaded its canvas: the next number of a command. *)
  ready = false
  k = n
  while not ready and sys.Now() - start < 60
    sys.Sleep(0.2)
    k += 1
    got = evaluated(conn, k, "document.readyState === 'complete' && !!document.querySelector('canvas')")
    ready = result.IsOk(got) and got.Value == true
  end
  k + 1
end

defn main()
  (** Serves, opens, plays, pictures: an Ok of the lines of the steps. *)
  out = env("OUT", "shots")
  lang = env("LANG", "en")
  docs = env("DOCS", "")
  profile = env("PROFILE", "/tmp/centauri-admin-shot")
  l = net.Listen(0)?
  port = net.Port(l)
  t = filled.App(port)?
  fiber.Spawn(() -> http.Serve(app.App(t.Env), listener = l))
  _ = sys.Mkdir(out)
  _ = sys.Remove("$profile/DevToolsActivePort")
  proc = sys.Start(env("CHROME", "chrome"), args = ["--headless=new", "--no-sandbox", "--use-angle=swiftshader", "--enable-unsafe-swiftshader",
    "--window-size=1280,900", "--remote-debugging-port=0", "--user-data-dir=$profile", "--lang=$lang", "--accept-lang=$lang", "http://127.0.0.1:$port/admin"])?
  start = sys.Now()
  while not sys.Exists("$profile/DevToolsActivePort") and sys.Now() - start < 15
    sys.Sleep(0.05)
  end
  debug = text.Split("\n", sys.Read("$profile/DevToolsActivePort")?)[1]
  targets = json.Parse(http.Fetch("http://127.0.0.1:$debug/json")?.Body)?
  page = [x for x in targets if x["type"] == "page"][1]
  conn = websocket.Dial(page["webSocketDebuggerUrl"])?
  lines = []
  n = waitReady(conn, 1, start)
  evaluated(conn, n, sys.Read("tools/admin-play.js")?)?
  steps = [["lang", lang, "signin"], ["signIn", missing, "signin"], ["signedIn", missing, "dashboard"], ["lang", lang, "dashboard"], ["visit", "Dashboard", "dashboard"], ["visit", "Users", "users"], ["disable", missing, "users-disabled"],
    ["visit", "Tenants", "tenants"], ["visit", "Events", "events"], ["visit", "Log", "log"], ["visit", "Jobs", "jobs"], ["visit", "Webhooks", "webhooks"],
    ["visit", "Files", "files"], ["visit", "Settings", "settings"], ["visit", "Data", "data"], ["edit", missing, "data-invoice"], ["markup", missing, "data-invoice"],
    ["visit", "Unpaid", "unpaid"], ["pay", missing, "unpaid-paid"], ["visit", "Audit", "audit"], ["audit", missing, "audit-after"],
    ["visit", "Keys", "keys"], ["revoke", missing, "keys-revoked"], ["visit", "Flags", "flags"], ["flag", missing, "flags-on"], ["user", missing, "user-factors"], ["signOut", missing, "signout"], ["signedOut", missing, "signout"]]
  if docs != ""
    steps = [if s[1] == "lang" ["lang", lang, missing, missing] else s end for s in docSteps]
  end
  for s in steps
    n += 2
    if s[1] == "signedIn" or s[1] == "signedOut"
      (* the page loaded again with its new cookie: the player goes in it again *)
      sys.Sleep(1)
      n = waitReady(conn, n, start)
      evaluated(conn, n, sys.Read("tools/admin-play.js")?)?
      n += 2
    end
    got = evaluated(conn, n, "adminPlay($(json.Text(s[1])), $(json.Text(s[2])))")?
    io.Print(got)
    lines = list.Append(got, lines)
    if docs != "" and value.IsSome(s[3])
      sys.Sleep(0.3)
      box = json.Parse(evaluated(conn, n + 1, "adminPlay('clip', $(json.Text(s[4])))")?)?
      if value.IsMissing(box)
        io.Print("FAIL the part of the page for $(s[3])")
        lines = list.Append("FAIL the part of the page for $(s[3])", lines)
      else
        pictured(conn, n + 2, "$docs/admin-$(s[3]).png", clip = box)?
      end
      n += 2
    else if docs == "" and s[1] != "signIn" and s[1] != "signOut" and s[1] != "lang" and s[1] != "markup"
      pictured(conn, n + 1, "$out/admin-$(s[3]).png")?
    end
  end
  (* the browser closed by its own protocol, its processes with it, then stopped for sure *)
  version = json.Parse(http.Fetch("http://127.0.0.1:$debug/json/version")?.Body)?
  whole = websocket.Dial(version["webSocketDebuggerUrl"])
  if result.IsOk(whole)
    _ = websocket.Send(json.Text({id: 1, method: "Browser.close", params: {}}), whole.Value)
    sys.Sleep(0.5)
  end
  sys.Stop(proc)
  result.Ok(lines)
end

got = main()
if result.IsErr(got)
  io.PrintError("admin-shot: $(got.Error)")
  sys.Exit(1)
end
sys.Exit(if list.All([text.StartsWith("ok", l) for l in got.Value]) 0 else 1 end)
