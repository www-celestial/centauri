(** The invoices with their admin pages, on a database in memory filled with a month (src/filled), served at
    http://127.0.0.1:PORT/admin (8090 by default): the page of the tutorial of the admin. The super-admin is
    super@app.test, password "correct horse super"; build the pages first, cesia build --target wasm admin/page.ce.
    ROWS adds that many clients to an office, for the measures of a long table. *)
use deps/www-celestial/centauri/src/app
use src/filled
use std/http
use std/io
use std/net
use std/result
use std/sys
use std/text
use std/value

defn main()
  port = text.Number(if value.IsText(sys.Env("PORT")) sys.Env("PORT") else "8090" end)
  rows = if value.IsText(sys.Env("ROWS")) text.Number(sys.Env("ROWS")) else 0 end
  t = filled.App(port, rows = rows)?
  l = net.Listen(port, host = "127.0.0.1")?
  io.Print("http://127.0.0.1:$port/admin")
  http.Serve(app.App(t.Env), listener = l)
end

got = main()
if result.IsErr(got)
  io.PrintError("admin-serve: $(got.Error)")
  sys.Exit(1)
end
