(** The invoices with their admin pages, on a database in memory filled as a month of a small platform would be, served
    at http://127.0.0.1:PORT/admin (8090 by default): the page of the tutorial of the admin, and what the tests of the
    admin pages in a browser play (tools/admin-shot.ce). The super-admin is super@app.test, password "correct horse
    super"; build the pages first, cesia build --target wasm admin/page.ce. ROWS adds that many clients to an office,
    for the measures of a long table. *)
use deps/www-celestial/cepheus/cesia/cepheus
use deps/www-celestial/centauri/src/api
use deps/www-celestial/centauri/src/app
use deps/www-celestial/centauri/src/apptest
use deps/www-celestial/centauri/src/jobs
use src/invoices
use src/invoices/endpoints as e
use std/fiber
use std/http
use std/io
use std/list
use std/math
use std/net
use std/result
use std/sys
use std/text
use std/value

defn Filled(port, rows = 0)
  (** The app in memory, its data made, ready to serve on port: an Ok of its test t. *)
  t = apptest.Start(invoices.App, settings = {Origin: "http://127.0.0.1:$port", AdminPath: "/admin", LogRequests: "false"}, now = missing)?
  _ = t.Super()?
  offices = [["ada@example.com", "Ada", "Martin & Co"], ["bruno@example.com", "Bruno", "Bruno Conseil"], ["chloe@example.com", "Chloé", "Atelier Chloé"],
    ["dan@example.com", "Dan", "Dan & Fils"], ["eva@example.com", "Eva", "Eva Studio"]]
  owners = []
  for o in offices
    owners = list.Append(t.SignUp({Email: o[1], Password: "correct horse battery", Name: o[2], Tenant: o[3]})?, owners)
  end
  ada = owners[1]
  bo = t.SignUp({Email: "bo@example.com", Password: "another long secret", Name: "Bo", Invite: ada.Call(api.Invite, {Email: "bo@example.com", Roles: ["accountant"]})?.Code})?
  lines = [{Label: "Design", Quantity: 3, Price: 400}, {Label: "Hosting", Quantity: 1, Price: 80.5}]
  for k in 1..value.Len(owners)
    o = owners[k]
    c = o.Call(e.AddClient, {Name: "Client $k", Email: "client$k@example.com", City: "Lyon"})?
    for m in 1..(3 + k)
      inv = o.Call(e.AddInvoice, {Client: c.Id, Date: "2026-10-0$(1 + math.Mod(m, 9))", Due: if math.Mod(m, 2) == 0 "2026-10-31" else "2026-12-01" end, Lines: lines})?
      if math.Mod(m, 3) == 0
        _ = o.Call(e.Pay, {id: inv.Id})?
      end
    end
  end
  for n in 1..rows
    _ = ada.Call(e.AddClient, {Name: "Client n° $n", Email: "c$n@example.org", City: if math.Mod(n, 2) == 0 "Paris" else "Lyon" end})?
  end
  (* signs of trouble: sign-ins that fail, a request of another site, a job that died, one that waits *)
  for k in 1..4
    _ = t.SignIn("ada@example.com", "not the password at all")
  end
  _ = t.Raw("POST", "/clients", body = "{}", headers = [{Name: "origin", Value: "https://evil.example"}, {Name: "sec-fetch-site", Value: "cross-site"}])
  _ = cepheus.Insert(jobs.Job, {Kind: "centauri.mail", Args: "{\"To\":\"ada@example.com\"}", State: "dead", RunAt: sys.Now() - 3600, Tries: 10,
    Error: "550 mailbox unavailable", Key: "mail-dead-1"}, t.Db)?
  _ = cepheus.Insert(jobs.Job, {Kind: "report", Args: "{}", State: "ready", RunAt: sys.Now() + 86400, Tries: 0, Error: "", Key: "report-tomorrow"}, t.Db)?
  result.Ok(t)
end

defn main()
  port = text.Number(if value.IsText(sys.Env("PORT")) sys.Env("PORT") else "8090" end)
  rows = if value.IsText(sys.Env("ROWS")) text.Number(sys.Env("ROWS")) else 0 end
  t = Filled(port, rows = rows)?
  l = net.Listen(port, host = "127.0.0.1")?
  io.Print("http://127.0.0.1:$port/admin")
  http.Serve(app.App(t.Env), listener = l)
end

got = main()
if result.IsErr(got)
  io.PrintError("admin-serve: $(got.Error)")
  sys.Exit(1)
end
