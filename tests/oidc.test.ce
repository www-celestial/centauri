(** Signing in with a provider, against what an attacker tries: a token of another app or of another sign-in
    (substitution), an answer named by another provider (mix-up), a flow finished twice (replay), a sign-in started in
    the attacker's browser and finished in the victim's (CSRF of the callback, login CSRF), a return to another site
    (open redirect), keys a token brings with it or no signature at all (JWKS spoofing, alg none, HS256 with a public
    key), a token past its time, an address the provider doesn't vouch for (account takeover), a provider's text in
    an answer. And the keys turned by the provider, read again. A provider of OpenID Connect in Cesia plays Google, over
    https on this machine, with a certificate of an authority made for the tests (.cesia/tls, by openssl): it signs its
    ID tokens with its own key, and checks PKCE and the client's secret. *)
use deps/www-celestial/cepheus/cesia/cepheus
use src/api
use src/app
use src/apptest
use src/auth
use std/bug
use std/crypto
use std/dict
use std/encode
use std/fiber
use std/http
use std/json
use std/list
use std/net
use std/result
use std/sys
use std/text
use std/tls
use std/value

ssl = crypto.OpenSsl()!   (* OpenSSL, for the provider's keys. *)

(* Two keys of RSA of 2048 bits, made once for the file, as Google's are: the provider's, and the one it turns to. *)
pairs = [crypto.KeyPair("RS256", ssl)!, crypto.KeyPair("RS256", ssl)!]

App = app.Of([auth.Module()], name = "sso")

(* The provider of a test: RS256, its first key. *)
provider() = apptest.Provider(apptest.Start(App)!, alg = "RS256", pair = pairs[1])!

(* The app, set to sign in with a provider, named Acme. *)
started(p, settings = {}) = apptest.Start(App, settings = dict.Merge(dict.Put("OidcName", "Acme", p.Settings), settings))

begin(t, start = {}) = apptest.Begun(t, start = start)
codeOf(p, b, claims = {}, how = {}) = apptest.CodeFor(p, b, claims = claims, how = how)
finish(t, b, x, cookie = missing) = apptest.Finished(t, b, x, cookie = cookie)
signedIn(t, p, claims = {}, how = {}, start = {}) = apptest.ProviderSignIn(t, p, claims = claims, how = how, start = start)

problemOf(out) = json.Parse(out.Body)!.detail

defn isSignedUpThenIn()
  p = provider()
  t = started(p)?
  bug.Assert(value.Equal(t.Anyone().Call(api.Providers)?, [{Name: "oidc", Title: "Acme"}]), "the providers")
  first = signedIn(t, p, start = {Return: "/invoices?late=1"})
  a = json.Parse(first.Body)?
  bug.Assert(first.Status == 201 and a.Return == "/invoices?late=1" and a.Checked == true, "made, checked: $(first.Status) $(first.Body)")
  again = signedIn(t, p)
  b = json.Parse(again.Body)?
  bug.Assert(again.Status == 201 and b.User == a.User and b.Return == "/", "the same user: $(again.Body)")
  sids = [h.Value for h in again.Headers if h.Name == "set-cookie" and text.StartsWith("sid=", h.Value)]
  bug.Assert(value.Len(sids) == 1, "a session: $(again.Headers)")
  cookie = text.Split(";", sids[1])[1]
  f = json.Parse(t.Raw("GET", "/auth/factors", headers = [{Name: "cookie", Value: cookie}]).Body)?
  bug.Assert(value.Len(f.Identities) == 1, "one identity: $f")
  value.Len(f.Identities) == 1 and f.Identities[1].Provider == "oidc" and not f.Password
end


defn isLinkedOnlyByAVerifiedAddress()
  p = provider()
  t = started(p)?
  ana = t.SignUp({Email: "ana@example.com", Password: "correct horse 12", Name: "Ana"})?
  unverified = signedIn(t, p, claims = {"email_verified": false})
  bug.Assert(unverified.Status == 403, "no takeover by an address not vouched for: $(unverified.Status) $(unverified.Body)")
  linked = signedIn(t, p)
  bug.Assert(linked.Status == 201 and json.Parse(linked.Body)?.User == ana.User, "linked by the verified address: $(linked.Body)")
  never = started(p, settings = {OidcLink: "never"})?
  never.SignUp({Email: "ana@example.com", Password: "correct horse 12", Name: "Ana"})?
  signedIn(never, p).Status == 409
end

defn isTokenOfAnotherAppOrSignInRefused()
  p = provider()
  t = started(p)?
  other = signedIn(t, p, claims = {aud: "another-app"})
  b1 = begin(t)
  b2 = begin(t)
  swapped = finish(t, b1, {State: b1.Q.state, Code: codeOf(p, b1, claims = {nonce: b2.Q.nonce})})
  late = signedIn(t, p, claims = {exp: apptest.Epoch - 120})
  future = signedIn(t, p, claims = {iat: apptest.Epoch + 3600})
  wrongIss = signedIn(t, p, claims = {iss: "https://accounts.google.com"})
  bug.Assert(text.Contains("another app", problemOf(other)) and text.Contains("nonce", problemOf(swapped)), "$(other.Body) $(swapped.Body)")
  value.Equal([other.Status, swapped.Status, late.Status, future.Status, wrongIss.Status], [401, 401, 401, 401, 401])
end

defn isMixUpRefused()
  p = provider()
  t = started(p)?
  b = begin(t)
  out = finish(t, b, {State: b.Q.state, Code: codeOf(p, b), Iss: "https://evil.example"})
  out.Status == 401 and text.Contains("another issuer", problemOf(out))
end

defn isFinishedOnce()
  p = provider()
  t = started(p)?
  b = begin(t)
  x = {State: b.Q.state, Code: codeOf(p, b)}
  first = finish(t, b, x)
  again = finish(t, b, x)
  first.Status == 201 and again.Status == 403
end

defn isLoginCsrfRefused()
  p = provider()
  t = started(p)?
  attacker = begin(t)
  victim = begin(t)
  planted = finish(t, attacker, {State: attacker.Q.state, Code: codeOf(p, attacker)}, cookie = victim.Cookie)
  none = t.Raw("POST", "/auth/oidc/finish", body = json.Text({State: attacker.Q.state, Code: codeOf(p, attacker)}))
  other = t.Raw("POST", "/auth/oidc/finish", body = json.Text({State: attacker.Q.state, Code: codeOf(p, attacker)}),
    headers = [{Name: "cookie", Value: attacker.Cookie}, {Name: "origin", Value: "https://evil.example"}])
  value.Equal([planted.Status, none.Status, other.Status], [403, 403, 403])
end

defn isReturnKeptInTheApp()
  p = provider()
  t = started(p)?
  returns = [json.Parse(signedIn(t, p, start = {Return: r}).Body)!.Return for r in ["//evil.example/x", "https://evil.example", "/\\evil.example", "/ok"]]
  value.Equal(returns, ["/", "/", "/", "/ok"])
end

defn isForgedTokenRefused()
  p = provider()
  t = started(p)?
  codes = [signedIn(t, p, how = h).Status for h in [{Alg: "none"}, {Alg: "HS256"}, {Own: true}]]
  value.Equal(codes, [401, 401, 401])
end

defn isRotationRead()
  p = provider()
  t = started(p)?
  bug.Assert(signedIn(t, p).Status == 201, "with k1")
  apptest.Rotate(p, pairs[2])
  signedIn(t, p).Status == 201
end

defn isCallbackPassedOn()
  p = provider()
  t = started(p, settings = {OidcPage: "/signin/done"})?
  get = t.Raw("GET", "/auth/oidc/callback?code=abc&state=xyz&evil=1")
  post = t.Raw("POST", "/auth/oidc/callback", body = "code=abc&state=xyz&user=%7B%7D",
    headers = [{Name: "content-type", Value: "application/x-www-form-urlencoded"}, {Name: "origin", Value: "https://appleid.apple.com"}, {Name: "sec-fetch-site", Value: "cross-site"}])
  where = http.HeaderValue("location", get.Headers)
  bug.Assert(get.Status == 303 and where == "http://app.test/signin/done#code=abc&state=xyz", "to the page, in the fragment: $where")
  other = t.Raw("POST", "/auth/oidc/finish", body = "{}", headers = [{Name: "origin", Value: "https://appleid.apple.com"}])
  post.Status == 303 and text.Contains("#code=abc&state=xyz&user=%7B%7D", http.HeaderValue("location", post.Headers)) and other.Status == 403
end

defn isProviderTextNotShown()
  p = provider()
  t = started(p)?
  b = begin(t)
  denied = finish(t, b, {State: b.Q.state, Error: "access_denied"})
  b2 = begin(t)
  odd = finish(t, b2, {State: b2.Q.state, Error: "<script>alert(1)</script>"})
  problemOf(denied) == "The provider refused: access_denied." and problemOf(odd) == "The provider refused." and not text.Contains("script", odd.Body)
end

defn isSecondFactorAfterTheProvider()
  p = provider()
  t = started(p, settings = {TwoFactorRoles: "owner"})?
  out = signedIn(t, p)
  first = json.Parse(out.Body)?
  bug.Assert(out.Status == 401 and first.second.Setup == true, "a new owner signs up, and sets up his second factor first: $(out.Body)")
  again = signedIn(t, p)
  again.Status == 401 and json.Parse(again.Body)?.second.Setup == true
end

defn isSettingMissingNamed()
  got = apptest.Start(App, settings = {SignInWith: "google,apple,nobody"})
  m = got.Error.Message
  text.Contains("APP_GOOGLE_ID", m) and text.Contains("APP_APPLE_KEY", m) and text.Contains("nobody is no provider", m)
end

defn isMicrosoftAndAppleRead()
  ms = dict.Put("Client", "c", auth.Microsoft) then dict.Put("Issuer", "https://login.microsoftonline.com/common/v2.0")
  conf = {issuer: "https://login.microsoftonline.com/{tenantid}/v2.0"}
  base = {iss: "https://login.microsoftonline.com/1234/v2.0", tid: "1234", aud: "c", sub: "s", exp: 2e9, nonce: "n", email: "ana@example.com"}
  work = auth.Claimed(base, ms, conf, "n", apptest.Epoch)?
  owned = auth.Claimed(dict.Put("xms_edov", true, base), ms, conf, "n", apptest.Epoch)?
  wrongTenant = auth.Claimed(dict.Put("tid", "9999", base), ms, conf, "n", apptest.Epoch)
  ap = dict.Put("Client", "com.acme", auth.Apple) then dict.Put("Issuer", "https://appleid.apple.com")
  apple = auth.Claimed({"iss": "https://appleid.apple.com", "aud": "com.acme", "sub": "001", "exp": 2e9, "nonce": "n", "email": "x@privaterelay.appleid.com", "email_verified": "true"}, ap, {}, "n", apptest.Epoch)?
  not work.Verified and owned.Verified and result.IsErr(wrongTenant) and apple.Verified
end

defn isAppleSecretSigned()
  o = crypto.OpenSsl()?
  pair = crypto.KeyPair("ES256", o)?
  pem = "-----BEGIN PRIVATE KEY-----\\n$(encode.Base64(pair.Secret))\\n-----END PRIVATE KEY-----"
  u = apptest.Start(App, settings = {SignInWith: "apple", AppleId: "com.acme.web", AppleTeam: "TEAM123", AppleKeyId: "KEY123", AppleKey: pem})?
  secret = auth.ClientSecret("apple", u.Env)?
  parts = auth.JwtParts(secret)?
  der = crypto.EcdsaDer(parts.Signature)?
  crypto.VerifyWith(der, parts.Signed, pair.Public, "ES256", o) and parts.Header.kid == "KEY123" and parts.Claims.iss == "TEAM123" and parts.Claims.sub == "com.acme.web" and
    parts.Claims.aud == "https://appleid.apple.com"
end

defn isFlowCookieGuarded()
  p = provider()
  t = started(p, settings = {Origin: "https://sso.example"})?
  b = begin(t)
  set = [h.Value for h in b.Out.Headers if h.Name == "set-cookie"][1]
  q = b.Q
  text.StartsWith("__Host-oidc=", set) and text.Contains("HttpOnly", set) and text.Contains("SameSite=Strict", set) and text.Contains("; Secure", set) and
    q["code_challenge_method"] == "S256" and text.ByteLength(q["code_challenge"]) == 43 and q["redirect_uri"] == "https://sso.example/auth/oidc/callback" and
    not text.Contains(text.Split(".", text.Split("=", text.Split(";", set)[1])[2])[2], json.Text(b.Q))
end
