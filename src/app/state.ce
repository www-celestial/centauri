(* What the requests of a process share. In Cesia a function never changes a variable of its module, so this state
   lives in one fiber that owns it, and a request asks it by a message, and in three tables of std/fiber, which every
   fiber reads and writes at once without one: the rate limits, the sessions it read last (for SessionCache seconds) and
   the values it remembers. A request at a route reads its session and counts all its limits there (door), with no
   message. The fiber holds the slots of the password hashes, the last lines of the log, the events already written,
   the failed sign-ins of the last minutes, and the clock of a test. Each process of cesia run --workers has its own: a
   limit of 600 a minute is then 600 a minute in each worker. *)
use std/dict
use std/fiber
use std/list
use std/math
use std/result
use std/sys
use std/value

defn State(slots = 2, waiting = 64, kept = 500, keys = 100000, clock = missing, rates = missing)
  (** A new state, in an Ok: slots, the password hashes that run at once (each takes 64 MiB); waiting, the hashes that
      wait at most for each slot, past which a sign-in gets a 503; kept, the lines of the log it keeps; keys, the most
      keys of the rate limits it holds, and the most sessions and values it keeps, past which those whose time passed
      go, then those due soonest (fiber.Table); clock, the time of a test, which Advance moves, else the time of the system; rates, the limits
      of an address, a user and a tenant that door counts, as {Ip, User, Tenant} of rateOf (600, 1,200 and 6,000 a
      minute unless given). *)
  ch = fiber.Channel(size = 4096)
  r = if value.IsMissing(rates) {Ip: rateOf(600, 60, 150), User: rateOf(1200, 60, 300), Tenant: rateOf(6000, 60, 1500)} else rates end
  st = {Ch: ch, Clock: missing, Rates: r, Nobody: limitsOf(missing, r), Limits: fiber.Table(keys), Sessions: fiber.Table(keys), Memo: fiber.Table(keys)}
  if not value.IsMissing(clock)
    st.Clock = fiber.Table(1)
    fiber.Remember("now", clock, 1e300, st.Clock)
  end
  fiber.Spawn(() -> own(ch, slots, slots * waiting, kept, keys, st))
  result.Ok(st)
end

(** A rate of door: per requests every period seconds and burst at once, as Limit and fiber.Admit take it. *)
rateOf(per, period, burst) = {Per: per, Period: period, Burst: burst}

defn ask(state, message)
  (** The answer of the state's fiber to a message. *)
  reply = fiber.Channel(size = 1)
  message.Reply = reply
  fiber.Send(message, state.Ch)
  fiber.Receive(reply).Value
end

(** The time of the state: the system's, or the test's clock, kept in a table of one key. *)
Now(state) = if value.IsMissing(state.Clock) sys.Now() else fiber.Recall("now", 0, state.Clock) end

defn Advance(seconds, state)
  (** Moves the clock of a test forward by seconds. *)
  t = Now(state) + seconds
  fiber.Remember("now", t, 1e300, state.Clock)
  t
end

(** A rate limit of the state: a key, as "ip:203.0.113.7", that may make per requests every period seconds, and burst
    at once. GCRA (the generic cell rate algorithm of ATM networks, ITU-T I.371) keeps one number a key, the time its
    next request is due: a request passes when it comes no earlier than that time minus the burst allowed.

      Limit("ip:203.0.113.7", 600, 60, 100).Per --> 600 *)
Limit(key, per, period, burst) = {Key: key, Per: per, Period: period, Burst: burst}

(** Do requests of these limits pass now, all of them: an answer {Ok, Retry, Key}, Retry the seconds to wait when one
    doesn't, Key the one that refused. A refused request counts in none of them. *)
Allow(limits, state) = fiber.Admit([l.Key for l in limits], limits, Now(state), state.Limits)

(** Takes a slot of the password hashes: true once one is free, false when too many wait already. *)
Slot(state) = ask(state, {Op: "slot"})

(** Gives back a slot of the password hashes. *)
Free(state) = fiber.Send({Op: "free"}, state.Ch)

(** Takes one of most places of a name, as the uploads that run at once: true when one was free, false else. *)
Take(name, most, state) = ask(state, {Op: "take", Name: name, Most: most})

(** Gives back a place of a name that Take gave. *)
Give(name, state) = fiber.Send({Op: "give", Name: name}, state.Ch)

(** Keeps a mail of a test, sent by the transport test: of mail (the box holds the last 1,000). *)
KeepMail(m, state) = fiber.Send({Op: "mail", Mail: m}, state.Ch)

(** The mails of a test, the oldest first. *)
Mails(state) = ask(state, {Op: "mails"})

(** Keeps a line of the log, a map. *)
Keep(line, state) = fiber.Send({Op: "line", Line: line}, state.Ch)

(** The lines the state keeps, the oldest first. *)
Lines(state) = ask(state, {Op: "lines"})

(** Is an event of this key worth writing now: true at most once every seconds, so that a flood of refusals writes one
    event a key and not one a request. *)
Fresh(key, seconds, state) = ask(state, {Op: "fresh", Key: key, Every: seconds})

(** Keeps a value under a key until a time (in seconds since 1970, the state's clock), for what a process reads often
    and changes seldom: the keys of an OpenID provider, the table of the feature flags. The state holds as many of
    them as the keys of its limits at most; past that, those whose time passed go, then those due soonest: each is read
    again at its next use. *)
Remember(key, v, until, state) = fiber.Remember(key, v, until, state.Memo)

(** The value kept under a key, or missing when there is none or its time passed. *)
Recall(key, state) = fiber.Recall(key, Now(state), state.Memo)

(** Forgets the value kept under a key: the next Recall gives missing. *)
Forget(key, state) = fiber.Forget(key, state.Memo)

(** Counts a failed sign-in in the failures of the last minute. *)
Failed(state) = fiber.Send({Op: "failed"}, state.Ch)

(** The failed sign-ins of the last minute (between 60 and 120 seconds of them, by whole minutes). *)
Failures(state) = ask(state, {Op: "failures"})

defn door(ip, state, session, store, user, endpoint, gen)
  (** What a request at its route asks the state, with no message: {Ok, Retry, Key, User, Hit, Gen, Now}. session, the
      key of its session (a hash of its cookie), is looked up among those the state keeps: when it is there and fresh,
      Hit is true and User the user it names (missing for a cookie that names nobody); when it is not, Hit is false, Gen
      the epoch of the kept sessions, and nothing is counted: the request reads its session, and comes back with it,
      store = {User, Until}, kept until Until if no session was forgotten since Gen. Then the limits of its address, of
      its user (of its key, for a program's: user.Key, at user.Rate) and his tenant (user, without a session to look
      up), and of its endpoint ({Name, Per, Period, Burst}), all of them or none, as Allow counts them. Now is the time
      of the state, a test's clock too. The arguments that don't apply are missing, gen 0. *)
  now = Now(state)
  c = missing
  if value.IsMissing(session)
    c = if value.IsMissing(user) state.Nobody else limitsOf(user, state.Rates) end
  else if value.IsMissing(store)
    c = fiber.Recall(session, now, state.Sessions)
    if value.IsMissing(c)
      return {Ok: true, Hit: false, Gen: fiber.Epoch(state.Sessions), Now: now}
    end
  else
    c = limitsOf(store.User, state.Rates)
    fiber.Remember(session, c, store.Until, state.Sessions, epoch = gen)
  end
  keys = list.Concat(["ip:$ip"], c.Keys)
  rates = c.Rates
  if not value.IsMissing(endpoint)
    keys = list.Append("e:$(endpoint.Name) $(if value.IsMissing(c.User) ip else c.User.Id end)", keys)
    rates = list.Append(endpoint, rates)
  end
  a = fiber.Admit(keys, rates, now, state.Limits)
  {Ok: a.Ok, Retry: a.Retry, Key: a.Key, User: c.User, Hit: true, Gen: gen, Now: now}
end

defn limitsOf(user, rates)
  (** A user and his limits past those of an address, made once for each session the state keeps: {User, Keys, Rates},
      Rates beginning with the address's. *)
  if value.IsMissing(user)
    return {User: missing, Keys: [], Rates: [rates.Ip]}
  end
  program = dict.Get("Key", user)
  tenant = dict.Get("Tenant", user)
  ku = if value.IsMissing(program) "u:$(user.Id)" else "k:$program" end
  ru = if value.IsMissing(program) rates.User else user.Rate end
  if value.IsMissing(tenant)
    {User: user, Keys: [ku], Rates: [rates.Ip, ru]}
  else
    {User: user, Keys: [ku, "t:$tenant"], Rates: [rates.Ip, ru, rates.Tenant]}
  end
end

(** Keeps the line of a request, as Keep, its fields given one by one: its time, number, method, route, status, ms,
    address and user (or missing). *)
kept(at, id, method, route, status, ms, ip, user, state) = fiber.Send({Op: "request", At: at, Id: id, Method: method, Route: route, Status: status,
  Ms: ms, Ip: ip, User: user}, state.Ch)

(** The lines kept since the line numbered after (0: all that are kept), the oldest first: {Seq, Lines}, Seq the number
    of the last line kept, to give as after the next time, so that a live tail of the log reads each line once. *)
Tail(after, state) = ask(state, {Op: "tail", After: after})

(** Forgets every session the state keeps: a sign-out, a role changed, a user disabled are then read again from the
    database at their next request. *)
forget(state) = fiber.Empty(state.Sessions)

(** Forgets every session the state of this process keeps, as forget: what a handler calls when it ends sessions
    without a signed-in user, as a new password set by the link of a mail. *)
ForgetSessions(state) = forget(state)

defn own(ch, slots, most, kept, keys, st)
  (** The fiber of the state: it answers its messages one after the other, so no two requests change it at once. *)
  free = slots
  queue = []
  lines = list.Fill(missing, kept)
  at = 0
  seq = 0
  seen = dict.Dict()
  minute = 0
  fails = [0, 0]
  box = []
  places = dict.Dict()
  while true
    got = fiber.Receive(ch)
    if result.IsErr(got)
      return missing
    end
    m = got.Value
    op = m.Op
    now = Now(st)
    if op == "request"
      at = math.Mod(at, kept) + 1
      lines[at] = m
      seq += 1
    else if op == "line"
      at = math.Mod(at, kept) + 1
      lines[at] = m.Line
      seq += 1
    else if op == "tail"
      n = list.Min([list.Max([seq - m.After, 0]), kept, seq])
      fiber.Send({Seq: seq, Lines: [shown(lines[math.Mod(at - n + k - 1 + kept, kept) + 1]) for k in 1..n]}, m.Reply)
    else if op == "slot"
      if free > 0
        free -= 1
        fiber.Send(true, m.Reply)
      else if value.Len(queue) < most
        queue = list.Append(m.Reply, queue)
      else
        fiber.Send(false, m.Reply)
      end
    else if op == "free"
      if value.Len(queue) > 0
        fiber.Send(true, queue[1])
        queue = list.Skip(1, queue)
      else
        free += 1
      end
    else if op == "lines"
      fiber.Send([shown(x) for x in list.Concat(list.Skip(at, lines), list.Take(at, lines)) if not value.IsMissing(x)], m.Reply)
    else if op == "fresh"
      last = dict.Get(m.Key, seen)
      ok = value.IsMissing(last) or now - last >= m.Every
      if ok
        if value.Len(seen) > keys
          seen = dict.Dict()
        end
        seen[m.Key] = now
      end
      fiber.Send(ok, m.Reply)
    else if op == "failed" or op == "failures"
      this = math.Floor(now / 60)
      if this != minute
        fails = if this == minute + 1 [fails[2], 0] else [0, 0] end
        minute = this
      end
      if op == "failed"
        fails[2] += 1
      else
        fiber.Send(fails[1] + fails[2], m.Reply)
      end
    else if op == "take"
      n = dict.GetOr(m.Name, 0, places)
      if n < m.Most
        places[m.Name] = n + 1
      end
      fiber.Send(n < m.Most, m.Reply)
    else if op == "give"
      places[m.Name] = list.Max([0, dict.GetOr(m.Name, 0, places) - 1])
    else if op == "mail"
      box = list.Append(m.Mail, if value.Len(box) >= 1000 list.Skip(1, box) else box end)
    else if op == "mails"
      fiber.Send(box, m.Reply)
    end
  end
end

defn shown(x)
  (** A line as Lines gives it: a request's kept field by field becomes the line of its log. *)
  if dict.Get("Op", x) != "request"
    return x
  end
  fields = {Id: x.Id, Method: x.Method, Route: x.Route, Status: x.Status, Ms: x.Ms, Ip: x.Ip}
  if not value.IsMissing(x.User)
    fields.User = x.User
  end
  {At: x.At, Level: if x.Status >= 500 "error" else "info" end, Message: "request", Fields: fields}
end
