(* How a request is served: the guards (health, CORS, the site it comes from, the limit of its address), then its
   route, where Centauri reads the session, checks the role, the limits of the user, his tenant and the endpoint,
   reads the input through its shape, gives a GET a database that only reads, calls the handler, and sends its value
   through the shape of the output, or its Err as Problem Details. Each request writes one line of the log and two
   metrics, and none of them holds a secret, a body, a query or a cookie. *)
use deps/www-celestial/cepheus/cesia/cepheus
use src/api
use std/check
use std/crypto
use std/dict
use std/encode
use std/fiber
use std/http
use std/json
use std/list
use std/log
use std/math
use std/metrics
use std/result
use std/sys
use std/text
use std/value

(** A value of a handler with more of its response: headers to add (as the cookie of a session), and a status other
    than the endpoint's.

      Reply({Id: 7}, headers = [{Name: "set-cookie", Value: "sid=; Max-Age=0"}]).Headers[1].Name --> "set-cookie" *)
Reply(v, headers = [], status = missing) = {CentauriReply: true, Value: v, Headers: headers, Status: status}

defn page(folder, rest)
  (** A file of the pages of the app (its dist/ folder), index.html for the paths that name no file: a page of the
      front shows each of its addresses itself. *)
  if ".." in text.Split("/", rest)
    return http.NotFound()
  end
  out = http.FileResponse("$folder/$(if rest == "" "index.html" else rest end)")
  if out.Status == 404 and not text.Contains(".", rest) http.FileResponse("$folder/index.html") else out end
end

defn json200(data, status = 200)
  (** A JSON response of Centauri's own. *)
  out = http.Json(data, status = status)
  out.Done = true
  out
end

defn refuse(status, message, rid, env, retry = missing)
  (** The response of a refusal at the door. *)
  out = Answer(Problem(if value.IsMissing(retry) {Kind: "api", Status: status, Message: message} else {Kind: "api", Status: status, Message: message, Retry: retry} end, rid))
  out.Done = true
  out
end

defn front(base, req, env)
  (** A request at the door: health, CORS, its site, the limit of its address, then its route, and the headers of
      security, the log and the metrics. *)
  start = sys.Now()
  rid = "$(env.Prefix)$(math.Mod(math.Floor(start * 1000000), 10000000000))"
  s = env.Settings
  peer = dict.GetOr("Peer", "", req)
  ip = if not s.TrustProxy and value.IsText(peer) and not text.Contains(":", peer) peer else Client(req, trustProxy = s.TrustProxy) end
  out = missing
  if req.Path == "/health/live"
    out = json200({Status: "live"})
  else if req.Path == "/health/ready"
    out = readiness(env)
  else if req.Method == "OPTIONS"
    out = Preflight(req, env.Cors)
  end
  if value.IsMissing(out)
    site = Site(req, s.Origin, env.Cors)
    if site == "other" and Changes(req) and not (value.Len(env.Cross) > 0 and dict.Has(req.Path, env.Cross))
      metrics.Add("centauri_refused_total", labels = {reason: "origin"})
      noted(env, "origin", "ip:$ip", "A request that changes something came from another site.", missing, missing, ip, req.Method)
      out = refuse(403, "This request comes from another site than the app's.", rid, env)
    else if value.Len(req) == 6
      (* the request of std/http, {Method, Path, Query, Headers, Body, Peer}, made again with three fields more, and
         the two that std/http's routes give it, so that none is added to a copy: a record made at once costs a
         tenth of three fields added *)
      out = base({Method: req.Method, Path: req.Path, Query: req.Query, Headers: req.Headers, Body: req.Body, Peer: req.Peer, Id: rid, Ip: ip,
        Site: site, Params: missing, Cookies: missing})
    else
      req.Id = rid
      req.Ip = ip
      req.Site = site
      out = base(req)
    end
  end
  if not dict.Has("Done", out)
    (* no route took it, so the limit of its address is counted here; a route counts it with the user's *)
    refused = limited(door(ip, env.State, missing, missing, missing, missing, 0), env, ip, req.Method, rid)
    if not value.IsMissing(refused)
      out = refused
    else if out.Status >= 400
      out = refuse(out.Status, if out.Status == 404 "There is no such address." else http.Reason(out.Status) end, rid, env)
    end
  end
  if env.Translating
    out = translated(out, req, env)
  end
  if not dict.Has("Secured", out)
    out = Secure(out, env.Guards, names = env.GuardNames)
  end
  if value.Len(env.Cors) > 0
    out = Shared(out, req, env.Cors)
  end
  ms = math.Round((sys.Now() - start) * 1000000) / 1000
  route = dict.GetOr("Route", req.Path, out)
  user = dict.Get("User", out)
  if s.LogRequests
    line = {Id: rid, Method: req.Method, Route: route, Status: out.Status, Ms: ms, Ip: ip}
    if not value.IsMissing(user)
      line.User = user
    end
    if out.Status >= 500
      log.Error("request", line)
    else
      log.Info("request", line)
    end
  end
  kept(start, rid, req.Method, route, out.Status, ms, ip, user, env.State)
  out
end

ipRate(per) = rateOf(per, 60, list.Max([1, math.Floor(per / 4)]))   (* The rate of a limit a minute: a burst of a quarter. *)

defn limited(d, env, ip, route, rid)
  (** The 429 of a request that the answer d of door refused, or missing when its limits let it pass. *)
  if d.Ok
    return missing
  end
  user = d.User
  metrics.Add("centauri_refused_total", labels = {reason: "limit"})
  noted(env, "limited", d.Key, "Too many requests.", if value.IsMissing(user) missing else user.Id end, tenantOf(user), ip, route)
  refuse(429, "Too many requests: wait $(d.Retry) seconds.", rid, env, retry = d.Retry)
end

defn readiness(env)
  (** /health/ready: 200 while the database answers and the process isn't stopping, else 503; what Docker and
      Kubernetes ask before they send it requests. *)
  db = cepheus.Get(Event, 1, env.Db)
  if result.IsOk(db) and not sys.StopAsked() json200({Status: "ready"}) else json200({Status: "not ready"}, status = 503) end
end

defn noted(env, kind, key, detail, user, tenant, ip, route)
  (** An event of the door, written at most once a minute a key: a flood of refusals writes one event, not one a
      request. *)
  if Fresh("$kind $key", 60, env.State)
    _ = Note(env, kind, detail, user = user, tenant = tenant, ip = ip, route = route)
  end
end

defn Note(env, kind, detail, user = missing, tenant = missing, ip = "", route = "")
  (** Writes an event of the history: an Ok of its id. *)
  fields = {At: env.Now(), Kind: kind, Ip: ip, Route: route, Detail: detail}
  if not value.IsMissing(user)
    fields.User = user
  end
  if not value.IsMissing(tenant)
    fields.Tenant = tenant
  end
  cepheus.Insert(Event, fields, env.Db, by = if value.IsMissing(user) 0 else user end, why = "event $kind")
end

defn allowedRole(need, user, roles)
  (** May a user (missing when nobody is signed in) call an endpoint of this role: Ok of true, or the status that
      refuses him. *)
  if need == api.Public
    return 0
  end
  if value.IsMissing(user)
    return 401
  end
  if need == api.Signed or (need == api.Super and user.Super) or need in user.Roles
    return 0
  end
  403
end

defn input(e, req)
  (** What a request brings to its handler, read through the endpoint's shapes: an Ok of it (missing when the endpoint
      takes nothing), or an Err of the route. *)
  if not value.IsMissing(e.Query)
    q = check.Read(e.Query, req.Query, texts = true)
    return if result.IsOk(q) q else Fail(400, "Check the query.", fields = q.Error) end
  end
  if value.IsMissing(e.In)
    return result.Ok(missing)
  end
  body = if req.Body == "" result.Ok({}) else missing end
  if value.IsMissing(body)
    kind = http.HeaderValue("content-type", req.Headers)
    if not (value.IsText(kind) and text.StartsWith("application/json", text.Lower(text.Trim(kind))))
      return Fail(415, "The body is JSON: send it with Content-Type: application/json.")
    end
    body = json.Parse(req.Body)
    if result.IsErr(body)
      return Fail(400, "The body is not JSON.")
    end
  end
  x = check.Read(e.In, body.Value)
  if result.IsOk(x) x else Fail(422, "Check the fields.", fields = x.Error) end
end

defn getDb(env)
  (** The database of a GET: a fork, whose writes go nowhere and are caught (dev and test); the connection of the
      token that only reads, whose writes Cepheus refuses (prod with APP_CEPHEUS_READ_TOKEN); or the app's own. *)
  mode = env.Settings.GetDb
  if mode == "fork" cepheus.Fork(env.Db) else if mode == "read" result.Ok(env.ReadDb) else result.Ok(env.Db) end
end

probe(db) = cepheus.Write([cepheus.Expect(1, Event.Kind)], db)?.Group   (* The number of the next group of a fork. *)

(* Base64 with - and _ for + and /, without =: a cursor goes in a query string as it is. *)
url64(s) = text.Replace("=", "", text.Replace("/", "_", text.Replace("+", "-", encode.Base64(s))))
defn unurl64(s)
  t = text.Replace("_", "/", text.Replace("-", "+", s))
  encode.Unbase64("$t$(text.Repeat(math.Mod(4 - math.Mod(text.ByteLength(t), 4), 4), "="))")
end

defn seal(row, e, user, env)
  (** The cursor after a row of a page: the row, sealed (XSalsa20-Poly1305) under a key of the app's for this endpoint
      and tenant, so that it shows nothing of the row and cannot be made by hand nor used in another list. *)
  url64(crypto.Seal(json.Text(row), listKey(e, user, env), env.Keys))
end

(* The key of the cursors of an endpoint for a tenant: the BLAKE2b of the app's key, the endpoint and the tenant, a
   function no one computes without the app's key. *)
listKey(e, user, env) = crypto.Blake2b("centauri list\n$(env.Key)\n$(e.Name)\n$(tenantOf(user))", env.Keys)

defn opened(cursor, e, user, env)
  (** The row of a cursor of seal: an Ok of it, or a 400. A cursor of before, the row sealed with the endpoint and the
      tenant under the app's key itself, is still read. *)
  bad = Fail(400, "This cursor is not one of this list: ask the first page again.")
  if not value.IsText(cursor) or text.ByteLength(cursor) > 4096
    return bad
  end
  raw = unurl64(cursor)
  if result.IsErr(raw)
    return bad
  end
  plain = crypto.Unseal(raw.Value, listKey(e, user, env), env.Keys)
  if result.IsOk(plain)
    row = json.Parse(plain.Value)
    return if result.IsOk(row) and value.IsDict(row.Value) row else bad end
  end
  plain = crypto.Unseal(raw.Value, env.Key, env.Keys)
  c = if result.IsOk(plain) json.Parse(plain.Value) else plain end
  if result.IsErr(c) or not value.IsDict(c.Value) or dict.Get("E", c.Value) != e.Name or not value.Equal(dict.Get("T", c.Value), tenantOf(user))
    return bad
  end
  result.Ok(c.Value.R)
end

tenantOf(user) = if value.IsMissing(user) 0 else dict.GetOr("Tenant", 0, user) end

defn answer(b, req, env)
  (** A request at its route, its Idempotency-Key honored. *)
  e = b.Endpoint
  rid = dict.GetOr("Id", "-", req)
  claim = if e.Method != "GET" and env.Settings.IdempotencyKey != "ignored" and not b.Upload claimed(b, req, env, rid) else missing end
  if not value.IsMissing(claim) and dict.Has("Out", claim)
    return claim.Out
  end
  out = served(b, e, req, env, rid)
  if not value.IsMissing(claim)
    settled(claim, out, env)
  end
  if not dict.Has("Route", out)
    out.Route = e.Name
    out.Done = true
  end
  out
end

defn served(b, e, req, env, rid)
  (** A request at its route: its session and its limits in one round trip to the state (two when its session is not
      kept there), its role, its input, its handler, its output. *)
  user = missing
  d = missing
  same = req.Site == "same" and not value.IsMissing(env.Who)
  if same and not value.IsMissing(env.SessionKey)
    key = env.SessionKey(req, env)
    d = door(req.Ip, env.State, key, missing, missing, b.Rate, 0)
    if not d.Hit
      who = env.Who(req, env)
      if result.IsErr(who)
        return failed(who.Error, rid, env, e)
      end
      until = d.Now + env.SessionCache
      if not value.IsMissing(who.Value) and value.IsNumber(dict.Get("Until", who.Value)) and who.Value.Until < until
        until = who.Value.Until
      end
      d = door(req.Ip, env.State, key, {User: who.Value, Until: until}, missing, b.Rate, d.Gen)
    end
  else
    if same
      who = env.Who(req, env)
      if result.IsErr(who)
        return failed(who.Error, rid, env, e)
      end
      user = who.Value
    end
    d = door(req.Ip, env.State, missing, missing, user, b.Rate, 0)
  end
  user = d.User
  if not d.Ok
    return limited(d, env, req.Ip, e.Name, rid)
  end
  out = routed(b, e, req, env, rid, user, d)
  if env.Translating and value.IsDict(user) and value.IsText(dict.Get("Lang", user))
    out.Lang = user.Lang
  end
  out
end

defn routed(b, e, req, env, rid, user, d)
  (** A request at its route once its user and its limits passed: its role, its input, its handler, its output. *)
  status = if e.Role == api.Public 0 else allowedRole(e.Role, user, env.Roles) end
  if status == 0 and value.IsDict(user) and dict.Has("Key", user) and b.Module == env.WhoModule
    metrics.Add("centauri_refused_total", labels = {reason: "role"})
    return refuse(403, "A key of a program calls the app's endpoints, not those of the accounts.", rid, env)
  end
  if status != 0
    metrics.Add("centauri_refused_total", labels = {reason: if status == 401 "signin" else "role" end})
    return refuse(status, if status == 401 "Sign in first." else "This is for the role $(e.Role)." end, rid, env)
  end
  s = env.Settings
  x = if b.Takes input(e, req) else nothing end
  if result.IsErr(x)
    return failed(x.Error, rid, env, e)
  end
  pageSize = b.Size
  after = missing
  if not value.IsMissing(pageSize) and value.IsText(dict.Get("After", req.Query)) and req.Query.After != ""
    a = opened(req.Query.After, e, user, env)
    if result.IsErr(a)
      return failed(a.Error, rid, env, e)
    end
    after = a.Value
  end
  reads = e.Method == "GET"
  db = env.Db
  before = missing
  if reads and s.GetDb != "same"
    got = getDb(env)
    if result.IsErr(got)
      return failed(got.Error, rid, env, e)
    end
    db = got.Value
    before = if s.GetDb == "fork" probe(db) else missing end
  end
  r = {Method: req.Method, Path: req.Path, Params: req.Params, Query: req.Query, Headers: req.Headers, Cookies: req.Cookies, Body: req.Body, Ip: req.Ip,
    Id: rid, Route: e.Name, User: user, Db: db, Why: if value.IsDict(user) and dict.Has("Key", user) "$(e.Name) #$rid key $(user.Key)" else "$(e.Name) #$rid" end, Settings: s, Now: d.Now, Keys: env.Keys,
    Limit: if value.IsMissing(pageSize) missing else pageSize + 1 end, After: after, Env: env}
  got = missing
  if b.Upload
    if not Take("upload", s.UploadsAtOnce, env.State)
      return failed({Kind: "api", Status: 503, Message: "Too many files are coming at once: send it again in a moment."}, rid, env, e)
    end
    file = upload(e, req, env)
    got = if result.IsErr(file) file else b.Handler(r, file.Value) end
    Give("upload", env.State)
  else
    got = if value.IsMissing(e.In) and value.IsMissing(e.Query) b.Handler(r) else b.Handler(r, x.Value) end
  end
  wrote = not value.IsMissing(before) and probe(db) != before + 1
  if not reads and not value.IsMissing(user) and b.Module == env.WhoModule
    forget(env.State)   (* a write of the accounts by a signed-in user, as a sign-out or a role changed: read again *)
  end
  streams = result.IsOk(got) and value.IsDict(got.Value) and dict.Has("CentauriRaw", got.Value) and dict.Has("Stream", got.Value.Response)
  if not value.IsMissing(before)
    if streams
      got = result.Ok(closedAfter(got.Value, db))   (* a file read as it goes reads its fork to its end *)
    else
      cepheus.Close(db)   (* a fork is kept until it is closed: one a GET would grow the process without end *)
    end
  end
  if result.IsErr(got)
    return failed(got.Error, rid, env, e)
  end
  if wrote
    log.Error("a GET wrote to the database", {Route: e.Name, Id: rid})
    return failed({Kind: "api", Status: 500, Message: "$(e.Name) wrote to the database: a GET only reads (A06)."}, rid, env, e)
  end
  v = if result.IsOk(got) got.Value else got end
  if value.IsDict(v) and dict.Has("CentauriRaw", v)
    out = v.Response
    out.Route = e.Name
    out.Done = true
    if not value.IsMissing(user)
      out.User = user.Id
    end
    metrics.Add("centauri_requests_total", labels = {route: e.Name, status: out.Status})
    return out
  end
  extra = []
  status = b.Status
  if value.IsDict(v) and dict.Has("CentauriReply", v)
    extra = v.Headers
    status = if value.IsMissing(v.Status) status else v.Status end
    v = v.Value
  end
  if not value.IsMissing(pageSize)
    rows = if value.IsArray(v) v else [] end
    v = {Rows: list.Take(pageSize, rows), After: if value.Len(rows) > pageSize seal(rows[pageSize], e, user, env) else missing end}
  end
  if value.Len(extra) == 0 and not value.IsMissing(b.Out)
    (* the common answer: its JSON, its headers with those of security made once, its route *)
    out = {Status: status, Body: json.Text(b.Out(v)), Headers: env.JsonHeaders, Route: e.Name, Done: true, Secured: true,
      User: if value.IsMissing(user) missing else user.Id end}
    metrics.Add("centauri_requests_total", labels = if status == b.Status b.Labels else {route: e.Name, status: status} end)
    return out
  end
  out = if value.IsMissing(e.Out) {Status: if status == 200 204 else status end, Body: "", Headers: []}
    else if e.Out.Kind == "file" {Status: status, Body: if value.IsText(v) v else "" end, Headers: [{Name: "content-type", Value: e.Out.Type}]}
    else http.Json(b.Out(v), status = status) end
  for h in extra
    out = http.WithHeader(h.Name, h.Value, out)
  end
  if not value.IsMissing(user)
    out.User = user.Id
  end
  metrics.Add("centauri_requests_total", labels = if out.Status == b.Status b.Labels else {route: e.Name, status: out.Status} end)
  out
end

nothing = result.Ok(missing)   (* The input of an endpoint that takes none. *)

defn closedAfter(raw, db)
  (** A raw answer whose body goes in pieces, the fork of its GET closed once the last piece went, or the client left. *)
  produce = raw.Response.Stream
  out = raw
  response = raw.Response
  response.Stream = send -> streamedThenClosed(produce, send, db)
  out.Response = response
  out
end

defn streamedThenClosed(produce, send, db)
  got = fiber.Wait(fiber.Spawn(() -> produce(send)))
  cepheus.Close(db)
  if result.IsOk(got) got.Value else got end
end

(* The kinds of std/check that check.Out gives as they are. *)
plain = {text: true, int: true, float: true, money: true, bool: true, email: true, id: true, url: true, oneof: true}

defn outOf(shape)
  (** check.Out of a shape as a function made once, at the start, for an endpoint: a record of plain fields takes its
      fields, a record of others gives each its own, a list each item; any other shape is check.Out's. The same
      values, without reading the shape again at each request. *)
  if not value.IsDict(shape)
    return x -> check.Out(shape, x)
  end
  kind = dict.Get("Kind", shape)
  if kind == "record"
    pairs = dict.Pairs(shape.Fields)
    if list.All([value.IsDict(p.Value) and dict.Has(dict.GetOr("Kind", "", p.Value), plain) for p in pairs])
      names = [p.Key for p in pairs]
      return x -> if value.IsDict(x) taken(names, x) else check.Out(shape, x) end
    end
    fields = [{Key: p.Key, Out: outOf(p.Value)} for p in pairs]
    return x -> if value.IsDict(x) given(fields, x) else check.Out(shape, x) end
  end
  if kind == "list"
    item = outOf(shape.Of)
    return x -> if value.IsArray(x) [item(v) for v in x] else check.Out(shape, x) end
  end
  x -> check.Out(shape, x)
end

defn taken(names, x)
  (** The fields of x of these names that it has: x itself when it has those and no other, as a row that cepheus.Find
      gave in the shape of its endpoint. *)
  if value.Len(x) == value.Len(names)
    all = true
    for k in names
      all = all and dict.Has(k, x)
    end
    if all
      return x
    end
  end
  out = {}
  for k in names
    v = dict.Get(k, x)
    if not value.IsMissing(v)
      out[k] = v
    end
  end
  out
end

defn given(fields, x)
  (** Each field of x through its own function of outOf, those that give something. *)
  out = {}
  for f in fields
    v = dict.Get(f.Key, x)
    if not value.IsMissing(v)
      v = f.Out(v)
      if not value.IsMissing(v)
        out[f.Key] = v
      end
    end
  end
  out
end

defn failed(e, rid, env, endpoint)
  (** The response of an Err of a route, logged when it is the server's fault. *)
  p = Problem(e, rid, detailed = env.Profile.Detailed)
  if p.Status >= 500
    log.Error("request failed", {Id: rid, Route: endpoint.Name, Error: if value.IsDict(e) dict.GetOr("Message", "", e) else value.Text(e) end})
    Keep({At: sys.Now(), Level: "error", Message: "request failed", Fields: {Id: rid, Route: endpoint.Name, Error: if value.IsDict(e) dict.GetOr("Message", "", e) else value.Text(e) end}}, env.State)
  else if value.IsDict(e) and dict.Get("Kind", e) == "cepheus"
    log.Warn("refused by the database", {Id: rid, Route: endpoint.Name, Code: dict.Get("Code", e), Message: dict.Get("Message", e)})
  end
  metrics.Add("centauri_requests_total", labels = {route: endpoint.Name, status: p.Status})
  Answer(p)
end
