(* Settings: one way. Each setting is a field of a shape, read once at the start from a variable of the environment,
   APP_ and its name in capitals, CepheusUrl from APP_CEPHEUS_URL. A setting the environment doesn't give takes the
   app's default (Of's defaults), else Centauri's. A wrong or missing one stops the start, with every wrong one named;
   a secret (check.Secret) never reaches a log. Three profiles, dev, test and prod, and their only differences are
   Centauri's, written in Profiles. *)
use std/check
use std/dict
use std/list
use std/result
use std/sys
use std/text
use std/value

(** Centauri's own settings, those of every app. The modules add theirs (auth adds those of the accounts), and the
    app its own. *)
Core = {
  Profile: check.OneOf(["dev", "test", "prod"], optional = true, default = "dev"),
  Origin: check.Url(optional = true),
  Port: check.Int(0, 65535, optional = true, default = 8080),
  Host: check.Text(1, 255, optional = true, default = "127.0.0.1"),
  CepheusUrl: check.Text(1, 1000, optional = true),
  CepheusToken: check.Secret(optional = true),
  CepheusReadToken: check.Secret(optional = true),
  CepheusCa: check.Text(1, 1000, optional = true),
  Secret: check.Secret(32, 512, optional = true),
  Cert: check.Text(1, 1000, optional = true),
  Key: check.Text(1, 1000, optional = true),
  Http3: check.OneOf(["off", "on"], optional = true, default = "off"),
  Http3Port: check.Int(0, 65535, optional = true, default = 0),
  Http3Congestion: check.OneOf(["bbr", "cubic", "reno"], optional = true, default = "bbr"),
  WebTransport: check.OneOf(["off", "on"], optional = true, default = "off"),
  Cors: check.Text(0, 4000, optional = true, default = ""),
  TrustProxy: check.Bool(optional = true, default = false),
  LimitIp: check.Int(1, 1000000, optional = true, default = 600),
  LimitUser: check.Int(1, 1000000, optional = true, default = 1200),
  LimitTenant: check.Int(1, 10000000, optional = true, default = 6000),
  MaxBody: check.Int(1024, 1073741824, optional = true, default = 1048576),
  Timeout: check.Int(1, 3600, optional = true, default = 60),
  LogRequests: check.Bool(optional = true, default = true),   (* false in the profile test, unless given *)
  LogLines: check.Int(10, 100000, optional = true, default = 1000),
  GetDb: check.OneOf(["fork", "read", "same"], optional = true),
  AdminPort: check.Int(0, 65535, optional = true, default = 0),
  UploadPart: check.Int(65536, 16777216, optional = true, default = 1048576),
  UploadsAtOnce: check.Int(1, 100000, optional = true, default = 16),
  CallTimeout: check.Int(1, 600, optional = true, default = 10),
  CallPlain: check.OneOf(["refuse", "allow"], optional = true, default = "refuse"),
  CallAllow: check.Text(0, 4000, optional = true, default = ""),
  CallCa: check.Text(1, 1000, optional = true),
  IdempotencyKey: check.OneOf(["honored", "required", "ignored"], optional = true, default = "honored"),
  IdempotencyTime: check.Int(60, 31536000, optional = true, default = 86400),
  IdempotencyScope: check.OneOf(["account", "session"], optional = true, default = "account"),
  IdempotencyLease: check.Int(0, 31536000, optional = true, default = 0),
  Outbox: check.OneOf(["on", "off"], optional = true, default = "on"),
  OutboxCount: check.Int(1, 100000, optional = true, default = 100),
  OutboxBytes: check.Int(1024, 1073741824, optional = true, default = 1048576),
  OutboxWait: check.Int(1, 31536000, optional = true, default = 3600),
  ReconnectFirst: check.Int(10, 600000, optional = true, default = 500),
  ReconnectMax: check.Int(100, 3600000, optional = true, default = 30000),
  PingEvery: check.Int(1, 3600, optional = true, default = 15),
  DeadAfter: check.Int(2, 7200, optional = true, default = 30),
  ResumeTime: check.Int(0, 86400, optional = true, default = 120),
  ResumeBytes: check.Int(1024, 1073741824, optional = true, default = 1048576),
  Langs: check.Text(2, 400, optional = true, default = "en"),
  Csp: check.Text(1, 2000, optional = true, default = "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"),
  Otel: check.OneOf(["off", "on"], optional = true, default = "off"),
  OtelEndpoint: check.Text(8, 1000, optional = true, default = "http://127.0.0.1:4318"),
  OtelProtocol: check.OneOf(["protobuf", "json"], optional = true, default = "protobuf"),
  OtelCompression: check.OneOf(["none", "gzip"], optional = true, default = "none"),
  OtelHeaders: check.Secret(optional = true),
  OtelSample: check.Float(0, 1, optional = true, default = 1),
  OtelAlways: check.Text(0, 100, optional = true, default = "errors,slow"),
  OtelSlow: check.Int(1, 3600000, optional = true, default = 1000),
  OtelTrust: check.OneOf(["restart", "trust"], optional = true, default = "restart"),
  OtelSignals: check.Text(0, 100, optional = true, default = "traces,metrics,logs"),
  OtelService: check.Text(1, 200, optional = true),
  OtelQueue: check.Int(16, 1000000, optional = true, default = 2048),
  OtelEvery: check.Int(1, 3600, optional = true, default = 5),
  OtelMetricsEvery: check.Int(1, 86400, optional = true, default = 60),
  TelemetryIp: check.OneOf(["none", "truncated", "full"], optional = true, default = "none"),
  TelemetryUser: check.OneOf(["off", "on"], optional = true, default = "off"),
  TelemetryClient: check.OneOf(["on", "off"], optional = true, default = "on"),
  TelemetrySample: check.Float(0, 1, optional = true, default = 1),
  TelemetryEvery: check.Int(5, 3600, optional = true, default = 30),
  TelemetryConsent: check.OneOf(["ask", "none"], optional = true, default = "ask"),
  TelemetryKeep: check.Int(1, 760, optional = true, default = 30),
  TelemetryGeo: check.OneOf(["off", "country", "city"], optional = true, default = "city"),
  TelemetryGeoFile: check.Text(1, 1000, optional = true),
  TelemetryMost: check.Int(1, 10000000, optional = true, default = 6000),
}

(** What each profile changes, and nothing else does. Mail and the database of a test come with L2 and apptest. *)
Profiles = {
  dev: {Detailed: true, OpenApi: true, Https: false, GetDb: "fork"},
  test: {Detailed: true, OpenApi: true, Https: false, GetDb: "fork"},
  prod: {Detailed: false, OpenApi: false, Https: true, GetDb: "same"},
}

defn Env(name)
  (** The variable of the environment of a setting: APP_, then its name in capitals, a _ before each capital inside it.

        Env("CepheusUrl") --> "APP_CEPHEUS_URL"
        Env("Port") --> "APP_PORT" *)
  out = []
  bytes = text.Bytes(name)
  for k in 1..value.Len(bytes)
    b = bytes[k]
    if b >= 65 and b <= 90 and k > 1
      out = list.Append(95, out)
    end
    out = list.Append(if b >= 97 and b <= 122 b - 32 else b end, out)
  end
  "APP_$(text.FromBytes(out))"
end

defn Read(fields, given, defaults = {})
  (** The settings: an Ok of a map of every field to its value, or an Err of a list of what is wrong, each line naming
      its variable. given is a map of names to texts, as the environment gives them (sys.Env for each, by Load), or to
      values of their types (a test's), and
      defaults the app's defaults, values of their type. The profile's rules come after the shape's: in prod, the
      Origin is https, a Secret and a database are given.

        Read(Core, {Port: "9000"}).Value.Port --> 9000
        Read(Core, {Port: "high"}) then result.IsErr() --> true
        Read(Core, {Profile: "prod"}).Error[1] --> "APP_ORIGIN: an https:// address is needed in prod." *)
  values = {}
  for p in dict.Pairs(defaults)
    values[p.Key] = p.Value
  end
  for p in dict.Pairs(given)
    if not value.IsMissing(p.Value) and p.Value != ""
      values[p.Key] = p.Value
    end
  end
  got = check.Read(check.Record(fields), values, texts = true)
  if result.IsErr(got)
    return result.Err(["$(Env(p.Key)): $(text.Lower(text.ByteSlice(1, 1, p.Value)))$(text.ByteSlice(2, text.ByteLength(p.Value), p.Value))" for p in dict.Pairs(got.Error)])
  end
  s = got.Value
  if value.IsMissing(dict.Get("Origin", s))
    s.Origin = "http://localhost:$(s.Port)"
  end
  wrong = []
  if s.Profile == "prod"
    if not text.StartsWith("https://", s.Origin)
      wrong = list.Append("APP_ORIGIN: an https:// address is needed in prod.", wrong)
    end
    if value.IsMissing(dict.Get("Secret", s))
      wrong = list.Append("APP_SECRET: a secret of 32 bytes at least is needed in prod (the key of the cursors and of the challenges).", wrong)
    end
    if value.IsMissing(dict.Get("CepheusUrl", s))
      wrong = list.Append("APP_CEPHEUS_URL: the database is needed in prod, as cepheus://localhost:7400/app.", wrong)
    end
  end
  if s.Profile == "test" and not dict.Has("LogRequests", given) and not dict.Has("LogRequests", defaults)
    s.LogRequests = false
  end
  if value.IsMissing(dict.Get("GetDb", s))
    s.GetDb = if s.Profile == "prod" and not value.IsMissing(dict.Get("CepheusReadToken", s)) "read" else Profiles[s.Profile].GetDb end
  end
  if s.DeadAfter <= s.PingEvery
    wrong = list.Append("APP_DEAD_AFTER: more seconds than APP_PING_EVERY are needed, or a page would count each wait between two pings a break.", wrong)
  end
  if s.ReconnectMax < s.ReconnectFirst
    wrong = list.Append("APP_RECONNECT_MAX: at least APP_RECONNECT_FIRST milliseconds.", wrong)
  end
  if s.Http3 == "on" and value.IsMissing(dict.Get("Cert", s))
    wrong = list.Append("APP_HTTP3: needs APP_CERT and APP_KEY: QUIC has no clear text.", wrong)
  end
  if s.WebTransport == "on" and (s.Http3 != "on" or s.Http3Port != 0 and s.Http3Port != s.Port)
    wrong = list.Append("APP_WEBTRANSPORT: needs APP_HTTP3=on on APP_PORT itself (APP_HTTP3_PORT 0 or the same): a page asks for its session on its own origin.", wrong)
  end
  for word in [text.Trim(w) for w in text.Split(",", s.OtelAlways) if text.Trim(w) != ""]
    if not (word in ["errors", "slow"])
      wrong = list.Append("APP_OTEL_ALWAYS: errors, slow, both with a comma, or nothing, not $word.", wrong)
    end
  end
  for word in [text.Trim(w) for w in text.Split(",", s.OtelSignals) if text.Trim(w) != ""]
    if not (word in ["traces", "metrics", "logs"])
      wrong = list.Append("APP_OTEL_SIGNALS: traces, metrics and logs, with commas, not $word.", wrong)
    end
  end
  if not (text.StartsWith("http://", s.OtelEndpoint) or text.StartsWith("https://", s.OtelEndpoint))
    wrong = list.Append("APP_OTEL_ENDPOINT: the http:// or https:// address of a collector of OTLP, as http://127.0.0.1:4318.", wrong)
  end
  if s.GetDb == "read" and value.IsMissing(dict.Get("CepheusReadToken", s))
    wrong = list.Append("APP_GET_DB: read needs APP_CEPHEUS_READ_TOKEN, a token of Cepheus that reads only.", wrong)
  end
  if value.Len(wrong) > 0 result.Err(wrong) else result.Ok(s) end
end

defn Load(fields, defaults = {})
  (** The settings of the environment: each field read from its variable (Env), then as Read does. Needs the
      permission env=APP_... of each, which cesia do gives from the task's allow. *)
  given = {}
  for name in dict.Keys(fields)
    v = sys.Env(Env(name))
    if value.IsText(v)
      given[name] = v
    end
  end
  got = Read(fields, given, defaults = defaults)
  if result.IsErr(got)
    return got
  end
  s = got.Value
  s.Given = dict.Dict([{Key: k, Value: true} for k in dict.Keys(given)])
  result.Ok(s)
end

defn Rows(fields, s, defaults = {}, given = {})
  (** The settings as the admin sees them, one row each, the secrets masked. *)
  masked = check.Masked(check.Record(fields), s)
  rows = []
  for name in list.Sort(dict.Keys(fields))
    v = dict.Get(name, masked)
    from = if dict.Has(name, given) "env" else if dict.Has(name, defaults) "code" else "default" end
    rows = list.Append({Name: name, Env: Env(name), Value: if value.IsMissing(v) "" else value.Text(v) end, From: from}, rows)
  end
  rows
end
