(* The data that every app shares: the events of its history (sign-ins, failures, refusals, changes of roles), the
   counters that number things without a gap, and the reads that keep a tenant's things its own. *)
use deps/www-celestial/cepheus/cesia/cepheus
use std/bug
use std/list
use std/dict
use std/http
use std/json
use std/result
use std/text
use std/value

(** An event of the history: when, its kind ("signin", "signin-failed", "locked", "limited", "origin", "bot", "roles",
    or the app's own), who and in which tenant, from which address, by which route, and what happened, in words that
    hold no secret. Every write of the app is in Cepheus's history too, with who wrote it and why. *)
Event = Kind("centauri_event", {At: cepheus.Date(), Kind: cepheus.Text(), User: cepheus.Link(), Tenant: cepheus.Link(),
  Ip: cepheus.Text(), Route: cepheus.Text(), Detail: cepheus.Text()})

(** A counter: Key, unique, names it (a tenant's invoices: "70001/invoice"); Last is the last number it gave. *)
Counter = Kind("centauri_counter", {Key: cepheus.Text(unique = true), Last: cepheus.Int()})

(** The parts of the files of every app (files.ce), in the vault of Cepheus. *)
Parts = cepheus.Files("centauri_part") then dict.Put("name", "centauri_part") then dict.Put("fields", {Name: cepheus.Text(), Size: cepheus.Int(),
  Type: cepheus.Text(), Owner: cepheus.Link(), Content: cepheus.Text()})

(** The parts of the files in a fork, which holds no file: their bytes as facts. *)
Bytes = Kind("centauri_bytes", {Bytes: cepheus.Text()})

(** A migration run (migrate.ce): its name (unique), its state (running, done, failed), when it started and ended, the
    lease of the process that runs it, and its error. *)
MigrationRun = Kind("centauri_migration", {Name: cepheus.Text(unique = true), State: cepheus.Text(), Started: cepheus.Date(),
  Ended: cepheus.Date(), Lease: cepheus.Date(), Error: cepheus.Text()})

(** A request made with an Idempotency-Key (idem.ce): Key, unique, the hash of its caller, endpoint and key; Hash, that
    of its method, path and body; its state (running, done), and its answer kept to be given again. *)
Once = Kind("centauri_idempotency", {Key: cepheus.Text(unique = true), Hash: cepheus.Text(), State: cepheus.Text(), Status: cepheus.Int(),
  Body: cepheus.Text(), Type: cepheus.Text(), At: cepheus.Date()})

(** An upload cut short that its client may go on with (files.ce): Key, unique, as Once's; the parts stored so far,
    their ids in order, and the bytes they hold; the file's whole length, its type and name (its first bytes checked
    when they came), its parts' size, and when it began. *)
Uploading = Kind("centauri_upload", {Key: cepheus.Text(unique = true), Parts: cepheus.Text(), Held: cepheus.Int(), Length: cepheus.Int(),
  Type: cepheus.Text(), Name: cepheus.Text(), PartSize: cepheus.Int(), At: cepheus.Date()})

(** The kinds of package app. *)
(* The telemetry of the pages (telemetry.ce). *)
(** A load of a page, as its batches told it: its route, its speed, its device, its journey. *)
ClientView = Kind("centauri_client_view", {View: cepheus.Text(unique = true), Session: cepheus.Text(), Route: cepheus.Text(), Journey: cepheus.Text(),
  Ref: cepheus.Text(), Utm: cepheus.Text(), At: cepheus.Date(), Seconds: cepheus.Float(), Lcp: cepheus.Float(), Inp: cepheus.Float(),
  Cls: cepheus.Float(), Fcp: cepheus.Float(), Ttfb: cepheus.Float(), Proto: cepheus.Text(), NavType: cepheus.Text(), DocBytes: cepheus.Int(),
  Trace: cepheus.Text(), WasmFetch: cepheus.Float(), WasmBytes: cepheus.Int(), WasmStart: cepheus.Float(), FirstPaint: cepheus.Float(),
  Frames: cepheus.Int(), FrameP50: cepheus.Float(), FrameP95: cepheus.Float(), FrameMax: cepheus.Float(), LongTasks: cepheus.Int(),
  LongMs: cepheus.Float(), Requests: cepheus.Int(), Bytes: cepheus.Int(), Failed: cepheus.Int(), Slowest: cepheus.Text(), LiveConnect: cepheus.Float(),
  Reconnects: cepheus.Int(), Offline: cepheus.Int(), Browser: cepheus.Text(), Version: cepheus.Text(), Os: cepheus.Text(), Mobile: cepheus.Bool(),
  Screen: cepheus.Text(), Viewport: cepheus.Text(), Dpr: cepheus.Float(), Dark: cepheus.Bool(), Motion: cepheus.Bool(), Lang: cepheus.Text(),
  Zone: cepheus.Text(), Cores: cepheus.Int(), Memory: cepheus.Float(), Net: cepheus.Text(), Rtt: cepheus.Float(), Down: cepheus.Float(),
  Save: cepheus.Bool(), Country: cepheus.Text(), City: cepheus.Text(), Ip: cepheus.Text(), User: cepheus.Link(), UserTenant: cepheus.Link(),
  ActionCount: cepheus.Int(), Errors: cepheus.Int(), Untrusted: cepheus.Bool()})

(** An action of a page, from its click to its answer: its name, its time, whether it went, its trace and the server's. *)
ClientAction = Kind("centauri_client_action", {View: cepheus.Text(), Session: cepheus.Text(), Route: cepheus.Text(), At: cepheus.Date(), Name: cepheus.Text(),
  Ms: cepheus.Float(), Ok: cepheus.Bool(), Waited: cepheus.Bool(), Trace: cepheus.Text(), Server: cepheus.Text(), Untrusted: cepheus.Bool()})

(** An error a page saw: its kind, its message and stack masked, its place, how many times in the batch. *)
ClientError = Kind("centauri_client_error", {View: cepheus.Text(), Session: cepheus.Text(), Route: cepheus.Text(), At: cepheus.Date(), Type: cepheus.Text(),
  Message: cepheus.Text(), Stack: cepheus.Text(), Source: cepheus.Text(), Count: cepheus.Int(), Browser: cepheus.Text(), Version: cepheus.Text(),
  Os: cepheus.Text(), Untrusted: cepheus.Bool()})

Kinds = [Event, Counter, Parts, Bytes, MigrationRun, Once, Uploading, ClientView, ClientAction, ClientError]

defn IdOf(x)
  (** An id from outside, as a parameter of a path: an Int above 0 from a whole number or its digits, else missing.

        IdOf("65537") --> 65537
        IdOf("-1") --> missing
        IdOf("1e3") --> missing *)
  if value.IsInt(x)
    return if x > 0 x else missing end
  end
  if not value.IsText(x) or text.ByteLength(x) == 0 or text.ByteLength(x) > 18 or not value.IsMissing(text.ByteFindAny("0123456789", 1, x, not = true))
    return missing
  end
  n = text.Number(x)
  if value.IsInt(n) and n > 0 n else missing end
end

defn Own(kind, id, r)
  (** A thing of a kind that belongs to the tenant of who asks: an Ok of its fields and its Id, or a 404 when there is
      no such thing or it is another tenant's: a 404 and not a 403, so that nobody learns that it exists. The kind has a
      field Tenant, a link, which the handler writes from r.User.Tenant, never from the request. id may be a text, as
      a parameter of the path. This is the second wall of the rights (OWASP A01, the insecure direct object
      reference): the handler reads each thing named from outside through it, and apptest.Isolated proves the rest. *)
  bug.Assert(dict.Has("Tenant", kind), "app.Own reads a kind with a field Tenant.")
  n = IdOf(id)
  if value.IsMissing(n) or value.IsMissing(r.User)
    return Missing()
  end
  t = cepheus.Get(kind, n, r.Db)?
  if value.IsMissing(t) or not value.Equal(dict.Get("Tenant", t), r.User.Tenant)
    return Missing()
  end
  t.Id = n
  result.Ok(t)
end

defn counter(key, db)
  (** The counter of a key: an Ok of its id, made at its first use; two requests that make it at once get the same one,
      its key being unique. *)
  for attempt in 1..3
    found = cepheus.Find(1, c -> {Where: [[c, Counter.Key, key]], Give: {C: c}}, db)?
    if value.Len(found) > 0
      return result.Ok(found[1].C)
    end
    made = cepheus.Insert(Counter, {Key: key, Last: 0}, db, why = "counter $key")
    if result.IsOk(made) or made.Error.Code != "unique"
      return made
    end
  end
  result.Err({Kind: "cepheus", Code: "busy", Message: "The counter $key is being made."})
end

defn Next(name, into, r)
  (** The operation of cepheus.Write that gives a thing the next number of the tenant's counter name: into is
      [thing, property], an Int property. The database takes the number in the group that writes the thing, so the
      numbers follow each other without a gap (as the law of many countries asks of invoices), and two requests at
      once neither wait nor retry. An Ok of the operation, to write in the group that makes the thing, as
      cepheus.Write([app.Next("invoice", [cepheus.New(1), k.Invoice.Number], r)?, ...], r.Db). *)
  c = counter("$(r.User.Tenant)/$name", r.Db)?
  result.Ok(cepheus.Incr(c, Counter.Last, into = into))
end

defn Retry(f, times = 3)
  (** f() again while it gives an Err of a conflict (Code "conflict": the data changed between its read and its
      write), at most times in all: the read-decide-write of a handler, made safe without a lock. *)
  got = f()
  tries = 1
  while tries < times and result.IsErr(got) and dict.Get("Code", got.Error) == "conflict"
    got = f()
    tries += 1
  end
  got
end

defn Facts(kind, thing, fields)
  (** The operations of cepheus.Write that give a thing these fields of a kind: an Add for each value, one for each
      item of a list (a field of many values); a missing value adds nothing. The thing may be a new one of the group,
      cepheus.New(1).

        value.Len(Facts(Counter, cepheus.New(1), {Key: "a/b", Last: missing})) --> 1 *)
  ops = []
  for p in dict.Pairs(fields)
    v = p.Value
    if value.IsArray(v)
      for one in v
        ops = list.Append(cepheus.Add(thing, kind[p.Key], one), ops)
      end
    else if not value.IsMissing(v)
      ops = list.Append(cepheus.Add(thing, kind[p.Key], v), ops)
    end
  end
  ops
end

defn Gone(kind, id, db)
  (** The operations that take every fact of a kind from a thing, as it is now: an Ok of them, empty when it has none.
      Written with an Expect of a field, the group is refused if the thing changed meanwhile. *)
  t = cepheus.Get(kind, id, db)?
  if value.IsMissing(t)
    return result.Ok([])
  end
  ops = []
  for p in dict.Pairs(t)
    if value.IsArray(p.Value)
      for one in p.Value
        ops = list.Append(cepheus.Retract(id, kind[p.Key], one), ops)
      end
    else if not value.IsMissing(p.Value)
      ops = list.Append(cepheus.Retract(id, kind[p.Key], p.Value), ops)
    end
  end
  result.Ok(ops)
end

defn Unchanged(kind, id, current, r)
  (** The check of a change against what the page saw before it asked for it, its base (the header Centauri-Base, a
      JSON object of fields, which a live action sets from web.Act's base): an Ok of the Expects of each field, to
      write with the change, so that Cepheus refuses it if one changes before the write; or the Err of a conflict, a
      409 whose Conflict lists each field that changed already, its value seen and its value now, for the page to show
      beside its own. current is the thing as the page reads it, the values compared; id is the thing's. Without a
      base, an Ok of none: the change is made as before. An action queued while the page was away never overwrites in
      silence what someone changed meanwhile.

        Unchanged(Event, 7, {Kind: "b"}, {Headers: []}) --> result.Ok([])
        seen = {Headers: [{Name: "centauri-base", Value: "{\"Kind\":\"a\"}"}]}
        Unchanged(Event, 7, {Kind: "b"}, seen).Error.Conflict[1] --> {Field: "Kind", Base: "a", Now: "b"} *)
  raw = http.HeaderValue("centauri-base", dict.GetOr("Headers", [], r))
  if not value.IsText(raw)
    return result.Ok([])
  end
  base = if text.ByteLength(raw) > 8192 result.Err(missing) else json.Parse(raw) end
  if result.IsErr(base) or not value.IsDict(base.Value)
    return Fail(400, "A Centauri-Base is a JSON object of the fields seen, 8 KiB at most.")
  end
  fields = dict.GetOr("fields", {}, kind)
  conflict = []
  for p in dict.Pairs(base.Value)
    if not dict.Has(p.Key, fields)
      return Fail(422, "Check the fields seen.", fields = dict.Put(p.Key, "No field of this kind.", {}))
    end
    now = dict.Get(p.Key, current)
    if not sameValue(now, p.Value)
      conflict = list.Append({Field: p.Key, Base: p.Value, Now: now}, conflict)
    end
  end
  if value.Len(conflict) > 0
    return result.Err({Kind: "api", Status: 409, Message: "This changed meanwhile: see its values now.", Conflict: conflict})
  end
  if not dict.Has("Db", r)
    return result.Ok([])
  end
  held = cepheus.Get(kind, id, r.Db)?
  held = if value.IsMissing(held) {} else held end
  result.Ok([cepheus.Expect(id, kind[f], dict.Get(f, held)) for f in dict.Keys(base.Value)])
end

defn sameValue(a, b)
  (** Do two values of a field say the same: numbers by their value (120 and 120.0), the others as they are. *)
  if value.IsNumber(a) and value.IsNumber(b)
    return a == b
  end
  value.Equal(a, b)
end
