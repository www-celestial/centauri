(* Live screens: std/live mounted at /live by the framework, with the session and the rights. A page opens a screen with
   its cookie, from the app's origin (http.SameOrigin, at the upgrade), and asks its shows by the names of api.Live
   endpoints and their arguments, in the query of /live (shows=[{"Show": "invoices.unpaid", "Args": {}}]): each is
   checked, its role and the shape of its arguments, and its handler writes the question itself (the page never sends
   one). A show is a cepheus.Watch: the writes are the events, from any process of any server, without a broker. The
   page's actions are the app's endpoints by their names, sent through the same door as over HTTP (one handler, two
   transports). A sign-out, a session that ends, a role taken away end the screens of the session.

   A break of the connection is no end (std/live's version 2): the screen is kept ResumeTime seconds and ResumeBytes
   of frames, for the page that comes back with its token, the same account and the same shows, from any address; each
   action carries the key the page made when it was asked, the Idempotency-Key of its request, so that one sent again
   after a break runs once, and the values the page saw (Base, the header Centauri-Base) for app.Unchanged; an action
   stamped with another account (Who) is refused, so that the next user of a browser never sends the actions of the
   one before. The page gets its settings (the outbox, the delays) with its screen. *)
use deps/www-celestial/cepheus/cesia/cepheus
use src/api
use std/check
use std/crypto
use std/dict
use std/encode
use std/fiber
use std/http
use std/json
use std/list
use std/live
use std/log
use std/result
use std/sys
use std/text
use std/value

(** A live screen served: an endpoint of api.Live and its handler, handler(s, args), s the screen ({User, Db, Ended,
    Settings, Env, Now}) and args read through the endpoint's shape, that gives a cepheus.Watch (an Ok of it, or its
    channel of changes), the watch made with until = s.Ended so that it ends with the screen.

      Live(api.Live("notes.mine", role = api.Signed), (s, args) -> missing).Endpoint.Name --> "notes.mine" *)
Live(endpoint, handler) = {Endpoint: endpoint, Handler: handler}

(* The bounds of a screen, as the front keeps them: 64 shows a screen, 16 screens a session. *)
mostShows = 64
mostScreens = 16

refusedLive(message) = result.Err({Kind: "live", Message: message})   (* The Err of a screen that can't open. *)

defn Request(e, x)
  (** The method, the path and the body of a call of an endpoint with x: the parameters of its path taken from x by their
      names, the rest the query of a GET or a DELETE, or the JSON body of the others.

        Request(api.Get("/notes/:id"), {id: 7}).Path --> "/notes/7"
        Request(api.Get("/notes", query = missing), {Q: "a b"}).Path --> "/notes?Q=a%20b" *)
  rest = if value.IsDict(x) x else {} end
  path = e.Path
  for name in api.Params(e.Path)
    v = dict.Get(name, rest)
    path = text.Replace(":$name", encode.UrlEncode(if value.IsMissing(v) "" else value.Text(v) end), path)
    rest = dict.Drop(name, rest)
  end
  if e.Method == "GET" or e.Method == "DELETE"
    q = text.Join("&", ["$(p.Key)=$(encode.UrlEncode(value.Text(p.Value)))" for p in dict.Pairs(rest) if not value.IsMissing(p.Value) and not value.IsArray(p.Value) and not value.IsDict(p.Value)])
    return {Method: e.Method, Path: if q == "" path else "$path?$q" end, Body: ""}
  end
  {Method: e.Method, Path: path, Body: if value.IsMissing(e.In) and value.Len(rest) == 0 "" else json.Text(rest) end}
end

defn asked(query)
  (** The shows a page asks in the query of /live: an Ok of a list of {Show, Args}, or an Err. *)
  raw = if value.IsDict(query) dict.Get("shows", query) else missing end
  if value.IsMissing(raw)
    return result.Ok([])
  end
  if not value.IsText(raw) or text.ByteLength(raw) > 65536
    return refusedLive("The shows of a screen are a JSON list of {Show, Args}, 64 KiB at most.")
  end
  parsed = json.Parse(raw)
  if result.IsErr(parsed) or not value.IsArray(parsed.Value)
    return refusedLive("The shows of a screen are a JSON list of {Show, Args}.")
  end
  if value.Len(parsed.Value) > mostShows
    return refusedLive("A screen shows $mostShows shows at most.")
  end
  out = []
  for one in parsed.Value
    if not value.IsDict(one) or not value.IsText(dict.Get("Show", one))
      return refusedLive("Each show of a screen is {Show, Args}.")
    end
    out = list.Append({Show: one.Show, Args: dict.GetOr("Args", {}, one)}, out)
  end
  result.Ok(out)
end

defn screen(s, env, lives)
  (** The shows of a screen that a page opens: its session read from the cookie of its request, each show asked
      checked (it exists, its role, its arguments), its watch made by its handler; a guard ends them when the session
      ends. A list of live.Show, or an Err the page gets. *)
  req = s.Request
  who = env.Who(req, env)
  if result.IsErr(who) or value.IsMissing(who.Value)
    return result.Err({Kind: "live", Status: 401, Message: "Sign in first."})
  end
  user = who.Value
  shows = asked(dict.Get("Query", req))?
  key = "screens:$(dict.GetOr("Session", user.Id, user))"
  if not Take(key, mostScreens, env.State)
    return refusedLive("This session has $mostScreens screens open already.")
  end
  ended = fiber.Channel()
  stop = fiber.Channel()
  fiber.Spawn(() -> ending(s.Ended, stop, ended, key, env))
  sv = {User: user, Db: env.Db, Ended: ended, Settings: env.Settings, Env: env, Now: env.Now()}
  out = []
  roles = []
  for one in shows
    b = dict.Get(one.Show, lives)
    if value.IsMissing(b)
      fiber.Close(stop)
      return refusedLive("There is no show $(one.Show).")
    end
    e = b.Endpoint
    if allowedRole(e.Role, user, env.Roles) != 0
      fiber.Close(stop)
      return refusedLive("The show $(one.Show) is for the role $(e.Role).")
    end
    args = if value.IsMissing(e.In) result.Ok(one.Args) else check.Read(e.In, one.Args) end
    if result.IsErr(args)
      fiber.Close(stop)
      return result.Err({Kind: "api", Status: 422, Message: "Check the arguments of the show $(one.Show).", Fields: args.Error})
    end
    got = b.Handler(sv, args.Value)
    if result.IsErr(got)
      fiber.Close(stop)
      return got
    end
    v = if result.IsOk(got) got.Value else got end
    changes = if value.IsDict(v) and dict.Has("Changes", v) v.Changes else v end
    out = list.Append(live.Show(one.Show, changes), out)
    roles = list.Append(e.Role, roles)
  end
  fiber.Spawn(() -> guarding(req, user, roles, stop, ended, env))
  out
end

defn ending(left, stop, ended, key, env)
  (** Closes the screen's own Ended once the page left or the guard stopped it, and gives its place back. *)
  _ = fiber.Select([left, stop])
  fiber.Close(ended)
  Give(key, env.State)
end

defn guarding(req, user, roles, stop, ended, env)
  (** The guard of a screen: its session read again at each change of its facts, as the who-module tells them (a
      sign-out, a role taken), and when it ends by its time; the shows end when the session is gone or no longer
      holds a role of a show. *)
  changed = if value.IsMissing(env.Ends) missing else env.Ends(user, env, ended) end
  while true
    wait = list.Max([0.01, dict.GetOr("Until", env.Now() + 3600, user) - env.Now()])
    waits = if value.IsMissing(changed) [ended] else [ended, changed] end
    got = fiber.Select(waits, timeout = list.Min([wait, 3600]))
    if result.IsErr(got) and got.Error.Kind != "timeout"
      if got.Error.Channel == ended
        return missing
      end
      changed = missing
    end
    if result.IsOk(got) and got.Value.Channel == ended
      return missing
    end
    if result.IsOk(got)
      while result.IsOk(fiber.Receive(changed, timeout = 0))
      end
    end
    who = env.Who(req, env)
    if result.IsOk(who) and value.IsMissing(who.Value)
      fiber.Close(stop)
      return missing
    end
    if result.IsOk(who)
      user = who.Value
      if list.Any([allowedRole(r, user, env.Roles) != 0 for r in roles])
        fiber.Close(stop)
        return missing
      end
    end
  end
end

defn act(e, handle, s, args, translating)
  (** An action of a page: the endpoint e called through the app's door with the cookie of the screen, as a request
      of HTTP of the same origin would be: an Ok of its answer, or an Err {Kind: "api", Status, Message, Fields}, with
      Instance, the number of the request to quote, and Retry, the seconds to wait after a 429. *)
  q = Request(e, args)
  parts = text.Split("?", q.Path)
  r = s.Request
  cookie = http.HeaderValue("cookie", r.Headers)
  host = http.HeaderValue("host", r.Headers)
  headers = [{Name: "host", Value: if value.IsText(host) host else "" end}, {Name: "sec-fetch-site", Value: "same-origin"},
    {Name: "content-type", Value: "application/json"}, {Name: "user-agent", Value: "live"}]
  if value.IsText(cookie)
    headers = list.Append({Name: "cookie", Value: cookie}, headers)
  end
  if value.IsText(dict.Get("Key", s))
    headers = list.Append({Name: "idempotency-key", Value: s.Key}, headers)
  end
  if value.IsDict(dict.Get("Base", s))
    headers = list.Append({Name: "centauri-base", Value: json.Text(s.Base)}, headers)
  end
  (* the language of the page's browser, so that an app of several languages answers the action in it *)
  lang = if translating http.HeaderValue("accept-language", r.Headers) else missing end
  if value.IsText(lang)
    headers = list.Append({Name: "accept-language", Value: lang}, headers)
  end
  out = handle({Method: q.Method, Path: parts[1], Query: if value.Len(parts) > 1 parts[2] else "" end, Headers: headers, Body: q.Body,
    Peer: dict.GetOr("Peer", "", r)})
  data = if out.Body == "" result.Ok(missing) else json.Parse(out.Body) end
  if out.Status < 400
    return if result.IsOk(data) data else result.Ok(out.Body) end
  end
  p = if result.IsOk(data) and value.IsDict(data.Value) data.Value else {} end
  e = {Kind: "api", Status: out.Status, Message: dict.GetOr("detail", http.Reason(out.Status), p), Fields: dict.GetOr("errors", {}, p)}
  if value.IsText(dict.Get("instance", p))
    e.Instance = p.instance
  end
  if value.IsNumber(dict.Get("retry", p))
    e.Retry = p.retry
  end
  if value.IsArray(dict.Get("conflict", p))
    e.Kind = "conflict"
    e.Conflict = p.conflict
  end
  result.Err(e)
end

defn actions(env, handle)
  (** The actions of the screens: every endpoint of the app that answers JSON, by its name. *)
  out = {}
  for b in env.Served
    e = b.Endpoint
    if not dict.Has("Types", e) and not (value.IsDict(e.Out) and dict.Get("Kind", e.Out) == "file")
      out[e.Name] = (s, args) -> act(e, handle, s, args, env.Words.Translating)
    end
  end
  out
end

defn mounted(routes, env, handle)
  (** The routes of an app with its screens at /live, when it has live endpoints. *)
  if value.Len(env.App.Lives) == 0
    return routes
  end
  lives = dict.Dict([{Key: b.Endpoint.Name, Value: b} for b in env.App.Lives])
  st = env.Settings
  client = {Outbox: st.Outbox, OutboxCount: st.OutboxCount, OutboxBytes: st.OutboxBytes, OutboxWait: st.OutboxWait,
    ReconnectFirst: st.ReconnectFirst, ReconnectMax: st.ReconnectMax, PingEvery: st.PingEvery, DeadAfter: st.DeadAfter}
  live.Route("/live", s -> screen(s, env, lives), routes, actions = actions(env, handle), resume = st.ResumeTime, buffer = st.ResumeBytes,
    same = (old, new) -> sameScreen(old, new, env), who = s -> whoOf(s.Request, env), client = client)
end

defn userOf(req, env)
  (** The account of a request's session, or missing. *)
  who = env.Who(req, env)
  if result.IsOk(who) and value.IsDict(who.Value) who.Value else missing end
end

defn sameScreen(old, new, env)
  (** Is the page that comes back with a screen's token the screen's own: the same account, signed in still, and the
      same shows? Its address may have changed (wifi to 4G), its cookie too. *)
  a = userOf(old, env)
  b = userOf(new, env)
  value.IsSome(a) and value.IsSome(b) and a.Id == b.Id and value.Equal(dict.Get("shows", dict.GetOr("Query", {}, old)), dict.Get("shows", dict.GetOr("Query", {}, new)))
end

defn whoOf(req, env)
  (** The account of a screen, as its page stamps its actions: a tag that tells two accounts apart and names neither. *)
  u = userOf(req, env)
  if value.IsMissing(u) missing else text.ByteSlice(1, 32, encode.Hex(crypto.Blake2b("centauri who\n$(u.Id)", env.Keys))) end
end
