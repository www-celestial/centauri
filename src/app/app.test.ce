(* The core through its Handler, on a fork of Empty: no network, no server. Who is played by a module whose who reads
   a header, x-as: "anyone" is nobody, a number the user of that id in tenant 7, "super" an administrator. *)
use deps/www-celestial/cepheus/cesia/cepheus
use src/api
use std/bug
use std/check
use std/dict
use std/fiber
use std/http
use std/json
use std/list
use std/result
use std/text
use std/value

Note = Kind("note", {Tenant: cepheus.Link(), Text: cepheus.Text(), Number: cepheus.Int()})

NewNote = check.Record({Text: check.Text(1, 100)})
NoteOut = check.Record({Id: check.Id(), Text: check.Text(), Number: check.Int()})
Add = api.Post("/notes", body = NewNote, out = NoteOut, role = "member")
List = api.Get("/notes", query = check.Record({Starts: check.Text(0, 20, optional = true)}), out = api.Page(NoteOut, 2), role = "member")
One = api.Get("/notes/:id", out = NoteOut, role = "member")
Sneaky = api.Get("/sneaky", role = api.Public)
Hello = api.Post("/hello", body = check.Record({Name: check.Text(1, 20)}), out = check.Record({Text: check.Text()}), role = api.Public, limit = 3)
Boom = api.Get("/boom", role = api.Public)

defn add(r, x)
  id = cepheus.New(1)
  made = cepheus.Write([cepheus.Add(id, Note.Tenant, r.User.Tenant), cepheus.Add(id, Note.Text, x.Text), Next("note", [id, Note.Number], r)?], r.Db, by = r.User.Id, why = r.Why)?
  Own(Note, made.Things[1], r)
end

page(r, q) = cepheus.Find(4, (n, t, no, tn) -> {Where: [[n, Note.Tenant, tn], cepheus.In(tn, [r.User.Tenant]), [n, Note.Text, t], [n, Note.Number, no]],
  Give: {Id: n, Text: t, Number: no, Tenant: tn}, Sort: [no], Limit: r.Limit, After: r.After}, r.Db)

defn who(req, t7, t8)
  as = http.HeaderValue("x-as", req.Headers)
  if value.IsMissing(as) or as == "anyone"
    return result.Ok(missing)
  end
  if as == "super"
    return result.Ok({Id: 1, Tenant: missing, Roles: [], Super: true})
  end
  result.Ok({Id: text.Number(as), Tenant: if as == "8" t8 else t7 end, Roles: Expand(["member"], DefaultRoles), Super: false})
end

notes(t7, t8) = Module("notes", kinds = [Note], who = (req, env) -> who(req, t7, t8), serve = [Serve(Add, add), Serve(List, page),
  Serve(One, r -> Own(Note, r.Params.id, r)), Serve(Sneaky, r -> cepheus.Write([cepheus.Add(cepheus.New(1), Note.Text, "x")], r.Db)),
  Serve(Hello, (r, x) -> {Text: "Hello, $(x.Name)!", Admin: true}), Serve(Boom, r -> result.Err({Kind: "io", Message: "the disk is on fire"}))])

defn app(given = {})
  (** The app on a fork, with settings of the profile test, and two tenants, things of the fork. *)
  db = cepheus.Fork(cepheus.Empty, list.Concat(Kinds, [Note]))?
  t7 = cepheus.Insert(Note, {Text: "tenant 7"}, db)?
  t8 = cepheus.Insert(Note, {Text: "tenant 8"}, db)?
  a = Of([notes(t7, t8)], name = "notes")
  s = Read(a.Fields, dict.Merge({Profile: "test", Origin: "http://shop.test"}, given), defaults = a.Defaults)?
  env = Start(a, s, db, clock = 1794528000)?
  result.Ok({Handle: Handler(env), Env: env})
end

defn ask(a, method, target, body = missing, as = "5", headers = [], kind = "application/json")
  (** A request as a page of the app sends it. *)
  parts = text.Split("?", target)
  h = list.Concat([{Name: "host", Value: "shop.test"}, {Name: "x-as", Value: as}], headers)
  if not value.IsMissing(body)
    h = list.Append({Name: "content-type", Value: kind}, h)
  end
  a.Handle({Method: method, Path: parts[1], Query: if value.Len(parts) > 1 parts[2] else "" end, Headers: h,
    Body: if value.IsMissing(body) "" else if value.IsText(body) body else json.Text(body) end, Peer: "203.0.113.7"})
end

data(response) = json.Parse(response.Body).Value
header(name, response) = http.HeaderValue(name, response.Headers)

defn isMadeOwnedAndNumbered()
  a = app()?
  one = ask(a, "POST", "/notes", body = {Text: "milk", Tenant: 99})
  two = ask(a, "POST", "/notes", body = {Text: "eggs"})
  other = ask(a, "POST", "/notes", body = {Text: "theirs"}, as = "8")
  bug.Assert(one.Status == 201 and data(one).Number == 1 and data(two).Number == 2 and data(other).Number == 1, "numbered by tenant: $(one.Body) $(two.Body) $(other.Body)")
  mine = ask(a, "GET", "/notes/$(data(one).Id)")
  theirs = ask(a, "GET", "/notes/$(data(one).Id)", as = "8")
  junk = ask(a, "GET", "/notes/abc")
  mine.Status == 200 and data(mine).Text == "milk" and theirs.Status == 404 and junk.Status == 404 and not text.Contains("Tenant", mine.Body)
end

defn isInputChecked()
  a = app()?
  bad = ask(a, "POST", "/notes", body = {Text: ""})
  notJson = ask(a, "POST", "/notes", body = "{nope")
  plain = ask(a, "POST", "/notes", body = "Text=x", kind = "application/x-www-form-urlencoded")
  p = data(bad)
  bug.Assert(header("content-type", bad) == "application/problem+json", "Problem Details")
  bad.Status == 422 and p.errors.Text == "Text of 1 to 100 bytes." and p.status == 422 and notJson.Status == 400 and plain.Status == 415
end

defn isPagedBySealedCursors()
  a = app()?
  for t in ["a", "b", "c"]
    ask(a, "POST", "/notes", body = {Text: t})
  end
  first = data(ask(a, "GET", "/notes"))
  second = data(ask(a, "GET", "/notes?After=$(first.After)"))
  stranger = ask(a, "GET", "/notes?After=$(first.After)", as = "8")
  forged = ask(a, "GET", "/notes?After=eyJJZCI6MX0")
  bug.Assert(value.Len(first.Rows) == 2 and value.Len(second.Rows) == 1 and second.Rows[1].Text == "c" and not ("After" in second), "pages: $first $second")
  bug.Assert(not text.Contains("tenant", first.After) and not ("Tenant" in first.Rows[1]), "the cursor and the rows show nothing more")
  stranger.Status == 400 and forged.Status == 400
end

defn isGetThatWritesRefused()
  a = app()?
  out = ask(a, "GET", "/sneaky")
  out.Status == 500 and text.Contains("a GET only reads", data(out).detail)
end

defn isRoleChecked()
  a = app()?
  anyone = ask(a, "GET", "/notes", as = "anyone")
  admin = ask(a, "GET", "/admin/app", as = "5")
  super = ask(a, "GET", "/admin/app", as = "super")
  anyone.Status == 401 and admin.Status == 403 and super.Status == 200 and data(super).Name == "notes"
end

defn isRoleWrittenWrongRefused()
  typo = api.Get("/x", role = "acountant")
  made = fiber.Wait(fiber.Spawn(() -> Of([Module("x", serve = [Serve(typo, r -> missing)])])))
  result.IsErr(made)
end

defn isOutputFilteredAndErrorsHidden()
  a = app()?
  hello = ask(a, "POST", "/hello", body = {Name: "Ana"})
  boom = ask(a, "GET", "/boom")
  bug.Assert(hello.Status == 201 and value.Equal(data(hello), {Text: "Hello, Ana!"}), "only the declared fields: $(hello.Body)")
  prod = app(given = {Profile: "prod", Origin: "https://shop.test", Secret: text.Repeat(32, "s"), CepheusUrl: "cepheus://x"})?
  hidden = ask(prod, "GET", "/boom")
  boom.Status == 500 and text.Contains("the disk is on fire", data(boom).detail) and hidden.Status == 500 and not text.Contains("fire", hidden.Body)
end

defn isSecurityHeaders()
  a = app()?
  out = ask(a, "GET", "/health/live")
  https = ask(app(given = {Profile: "prod", Origin: "https://shop.test", Secret: text.Repeat(32, "s"), CepheusUrl: "cepheus://x"})?, "GET", "/health/live")
  bug.Assert(text.Contains("frame-ancestors 'none'", header("content-security-policy", out)) and header("x-content-type-options", out) == "nosniff", "CSP, nosniff")
  bug.Assert(header("cache-control", out) == "no-store" and value.IsMissing(header("strict-transport-security", out)), "no HSTS over http")
  text.Contains("max-age=63072000", header("strict-transport-security", https))
end

defn isOtherSiteRefused()
  a = app(given = {Cors: "https://partner.example"})?
  forged = ask(a, "POST", "/notes", body = {Text: "x"}, headers = [{Name: "origin", Value: "https://evil.example"}])
  fetched = ask(a, "POST", "/notes", body = {Text: "x"}, headers = [{Name: "sec-fetch-site", Value: "cross-site"}, {Name: "origin", Value: "https://evil.example"}])
  partner = ask(a, "POST", "/notes", body = {Text: "x"}, headers = [{Name: "sec-fetch-site", Value: "cross-site"}, {Name: "origin", Value: "https://partner.example"}])
  pre = ask(a, "OPTIONS", "/notes", headers = [{Name: "origin", Value: "https://partner.example"}, {Name: "access-control-request-method", Value: "POST"}])
  same = ask(a, "POST", "/notes", body = {Text: "x"}, headers = [{Name: "origin", Value: "http://shop.test"}])
  bug.Assert(forged.Status == 403 and fetched.Status == 403, "another site: $(forged.Status) $(fetched.Status)")
  bug.Assert(partner.Status == 401 and header("access-control-allow-origin", partner) == "https://partner.example", "a partner has no session")
  pre.Status == 204 and value.IsMissing(header("access-control-allow-credentials", pre)) and same.Status == 201
end

defn isLimited()
  a = app(given = {LimitIp: "40"})?
  codes = [ask(a, "POST", "/hello", body = {Name: "x"}, as = "anyone").Status for k in 1..5]
  bug.Assert(value.Equal(codes, [201, 201, 201, 429, 429]), "the endpoint's 3 a minute: $codes")
  door = [ask(a, "GET", "/health/ready").Status for k in 1..3]
  rest = [ask(a, "GET", "/notes") for k in 1..8]
  bug.Assert(value.Equal([x.Status for x in rest], [200, 200, 200, 200, 200, 200, 200, 429]), "a burst of 10 from one address, the 2 refused by the endpoint not counted: $([x.Status for x in rest])")
  value.Equal(door, [200, 200, 200]) and value.IsText(header("retry-after", rest[8]))
end

defn isNotFoundAProblem()
  a = app()?
  out = ask(a, "GET", "/nowhere")
  wrong = ask(a, "DELETE", "/notes")
  out.Status == 404 and data(out).status == 404 and wrong.Status == 405 and header("content-type", wrong) == "application/problem+json"
end

defn isOpenApiInTestOnly()
  a = app()?
  doc = ask(a, "GET", "/openapi.json")
  prod = ask(app(given = {Profile: "prod", Origin: "https://shop.test", Secret: text.Repeat(32, "s"), CepheusUrl: "cepheus://x"})?, "GET", "/openapi.json")
  doc.Status == 200 and data(doc).paths["/notes"].post.operationId == "POST /notes" and prod.Status == 404
end

defn isAdminOfTheApp()
  a = app(given = {Secret: text.Repeat(32, "k")})?
  ask(a, "POST", "/notes", body = {Text: "milk"})
  settings = data(ask(a, "GET", "/admin/settings", as = "super"))
  secret = [s for s in settings if s.Name == "Secret"][1]
  kinds = data(ask(a, "GET", "/admin/kinds", as = "super"))
  things = data(ask(a, "GET", "/admin/data/note", as = "super"))
  logs = data(ask(a, "GET", "/admin/logs?Search=POST", as = "super"))
  ends = data(ask(a, "GET", "/admin/endpoints", as = "super"))
  bug.Assert(secret.Value == "(secret)" and secret.Env == "APP_SECRET", "masked: $secret")
  bug.Assert(value.Equal([k.Name for k in kinds], ["centauri_event", "centauri_counter", "note"]), "kinds")
  value.Len(things.Rows) == 1 and text.Contains("milk", things.Rows[1].Fields) and value.Len(logs) >= 1 and list.Any([e.Name == "POST /notes" for e in ends])
end
