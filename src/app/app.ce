(** Centauri's core: an app is a list of modules, each a record of its kinds, its rules and its routes; a route is an
    endpoint of a contract (package api) and the function that answers it. No class, no annotation, no container of
    dependencies: what a handler uses comes in its request r, as r.User (who asks: Id, Tenant, Roles, Super), r.Db
    (the database), r.Why (what writes, for the history), r.Params, r.Settings. Run reads the settings, connects to
    Cepheus and serves; apptest.Start runs the same app in memory.

      Hello = api.Get("/hello", out = check.Record({Text: check.Text()}), role = api.Public)
      hello(r) = {Text: "Hello!"}
      Of([Module("hello", serve = [Serve(Hello, hello)])]).Endpoints[1].Name --> "GET /hello" *)
use deps/www-celestial/cepheus/cesia/cepheus
use src/api
use std/bug
use std/check
use std/crypto
use std/dict
use std/encode
use std/fiber
use std/http
use std/http3
use std/io
use std/json
use std/list
use std/log
use std/math
use std/metrics
use std/otel
use std/quic
use std/result
use std/sys
use std/text
use std/tls
use std/value

(** A route: an endpoint of a contract and its handler. The handler is handler(r) for an endpoint that takes nothing,
    handler(r, x) for one with a body or a query, x read through its shape. It gives a value, which leaves through the
    endpoint's out (only the fields it declares), or an Err (Fail, or one of Cepheus, passed on by ?). A page endpoint
    (out = api.Page) gives its rows, at most r.Limit of them after r.After, as cepheus.Find gives them with Limit:
    r.Limit, After: r.After; Centauri makes the page and its cursor.

      Serve(api.Get("/ping", role = api.Public), r -> missing).Endpoint.Path --> "/ping" *)
Serve(endpoint, handler) = {Endpoint: endpoint, Handler: handler}

(** A kind of Cepheus that keeps its name and fields for the administration, which lists the kinds and their things:
    cepheus.Kind, and keys more, in small letters so that they meet no field. secret names the fields that hold a
    secret, as the hash of a password or a token: the administration never sends them to a page (it shows "(secret)")
    and never changes them.

      Kind("note", {Text: cepheus.Text()})["name"] --> "note"
      Kind("key", {Hash: cepheus.Text()}, secret = ["Hash"])["secret"] --> ["Hash"] *)
Kind(name, fields, secret = []) = cepheus.Kind(name, fields) then dict.Put("name", name) then dict.Put("fields", fields) then dict.Put("secret", secret)

(** A module: its name, its kinds and rules of Cepheus, its routes (Serve), and for a module of the framework, who
    (the function that reads the session of a request, as auth gives it), key (a function of the request and env that
    gives a text naming its session, a hash of its cookie, or missing for none: the state of the process then keeps
    what who read for SessionCache seconds, and a write of a signed-in user through this module's routes forgets all
    of it), settings (the shapes of its own settings), start (a function of env that runs in its own fiber once the
    app serves, as a keeper that ends old sessions), jobs (the kinds of background jobs it writes, jobs.Kind, which the
    module of package jobs runs), ends (for the who-module: ends(user, env, until), a channel that gets a value at each
    change of a user's session, so that his live screens end with it), verify (a function of env that gives an Ok, or an Err of lines that stop the start,
    as a time zone that can't be read), migrations (app.Migration, run once each, in order, before the app
    serves), pages, a function of env that gives the pages the module serves, {Path, Folder}, a folder of files
    built beforehand served at a path a setting chooses (Pages), or missing for none, and messages, the catalogue of
    its words in other languages (i18n.Catalog).

      Module("notes", serve = []).Name --> "notes" *)
Module(name, kinds = [], rules = [], serve = [], who = missing, settings = {}, start = missing, key = missing, jobs = [], verify = missing,
  migrations = [], ends = missing, pages = missing, messages = missing) = {Name: name, Kinds: kinds, Rules: rules, Serve: serve, Who: who, Settings: settings, Start: start, Key: key,
  Jobs: jobs, Verify: verify, Migrations: migrations, Ends: ends, Pages: pages, Messages: messages}

(** The roles of an app unless it names its own: each role with the roles it includes. owner and admin manage the
    members of their tenant (the endpoints of auth need admin); member is the role of every user who signs up. *)
DefaultRoles = {owner: ["admin", "member"], admin: ["member"], member: []}

defn Expand(roles, table)
  (** Roles with every role they include, from a table of roles.

        Expand(["owner"], DefaultRoles) --> ["owner", "admin", "member"] *)
  out = []
  todo = roles
  while value.Len(todo) > 0
    r = todo[1]
    todo = list.Skip(1, todo)
    if not (r in out)
      out = list.Append(r, out)
      todo = list.Concat(todo, dict.GetOr(r, [], table))
    end
  end
  out
end

defn RolesOf(roles, env)
  (** Roles with every role they include, as Expand gives them, from the table that Start expanded once: what each
      request does with the roles of its member. *)
  if value.Len(roles) == 1
    return dict.GetOr(roles[1], roles, env.Expanded)
  end
  list.Unique(list.Flatten([dict.GetOr(r, [r], env.Expanded) for r in roles]))
end

defn Of(modules, settings = missing, roles = DefaultRoles, defaults = {}, name = "app", version = "0.1.0", pages = missing, messages = missing)
  (** An app: its modules, in order, then its own settings (a check.Record, or a map of names to shapes), its roles,
      the defaults of its settings (values of their types, which the environment overrides: an app that is single-
      tenant says defaults = {Tenancy: "single"}), its name and version (for OpenAPI and the admin), and pages, the
      folder of its front (dist/), served for the paths that no route takes, and messages, the catalogue of its words
      in other languages (i18n.Catalog, or several joined by i18n.Of), which the setting Langs turns on. An endpoint whose role is no role of the
      table, nor api.Public, api.Signed or api.Super, stops here: a role written wrong never opens a route. *)
  modules = withRunner(modules)
  fields = Core
  kinds = Kinds
  rules = []
  served = []
  jobs = []
  names = []
  lives = []
  for m in modules
    fields = dict.Merge(fields, m.Settings)
    kinds = list.Concat(kinds, [k for k in m.Kinds if not (dict.Get("name", k) in names)])
    names = list.Concat(names, [dict.Get("name", k) for k in m.Kinds if not value.IsMissing(dict.Get("name", k))])
    rules = list.Concat(rules, m.Rules)
    for j in dict.GetOr("Jobs", [], m)
      if not (j.Name in [k.Name for k in jobs])
        jobs = list.Append(j, jobs)
      end
    end
    for b in m.Serve
      if b.Endpoint.Method != "LIVE"
        served = list.Append({Endpoint: b.Endpoint, Handler: b.Handler, Module: m.Name}, served)
      else
        lives = list.Append({Endpoint: b.Endpoint, Handler: b.Handler, Module: m.Name}, lives)
      end
    end
  end
  if not value.IsMissing(settings)
    fields = dict.Merge(fields, if dict.Has("Kind", settings) and settings.Kind == "record" settings.Fields else settings end)
  end
  known = list.Concat([api.Public, api.Signed, api.Super], dict.Keys(roles))
  for b in list.Concat(served, lives)
    bug.Assert(b.Endpoint.Role in known, "$(b.Endpoint.Name): the role $(b.Endpoint.Role) is no role of the app ($(text.Join(", ", dict.Keys(roles)))).")
  end
  bug.Assert(value.Len(jobs) == 0 or "jobs" in [m.Name for m in modules], "The modules of this app have jobs ($(text.Join(", ", [j.Name for j in jobs]))), and no module runs them: add jobs.Module() to app.Of.")
  {Name: name, Version: version, Modules: modules, Fields: fields, Defaults: defaults, Roles: roles, Kinds: kinds, Rules: rules,
    Pages: pages, Served: served, Endpoints: [b.Endpoint for b in served], Jobs: jobs, Lives: lives, Messages: messages}
end

defn withRunner(modules)
  (** The modules of an app, and the module that runs their jobs when they have some and none of them is it: the one a
      module brings along (as auth brings that of package jobs, in its Runner), so that an app of accounts written
      before the jobs works as it did. *)
  names = [m.Name for m in modules]
  if "jobs" in names or not list.Any([value.Len(dict.GetOr("Jobs", [], m)) > 0 for m in modules])
    return modules
  end
  for m in modules
    if dict.Has("Runner", m)
      return list.Append(m.Runner, modules)
    end
  end
  modules
end

defn Start(a, s, db, readDb = missing, clock = missing)
  (** What every request of an app shares, env: its settings s (as Read gives them), its database, the database of a
      token that reads only (for GetDb = "read"), the state of the process, the keys of libsodium, and the time (the
      clock of a test, when given). An Ok of env; Handler(env) serves it. *)
  keys = crypto.Open()?
  hashSlots = dict.GetOr("HashSlots", 2, s)
  rates = {Ip: ipRate(s.LimitIp), User: ipRate(s.LimitUser), Tenant: ipRate(s.LimitTenant)}
  keyRate = ipRate(dict.GetOr("KeyLimit", 600, s))
  state = State(slots = hashSlots, kept = s.LogLines, clock = clock, rates = rates)?
  key = if value.IsMissing(dict.Get("Secret", s)) crypto.Random(32, keys) else crypto.Blake2b("centauri cursor $(s.Secret)", keys) end
  who = missing
  sessionKey = missing
  whoModule = missing
  ends = missing
  for m in a.Modules
    if value.IsMissing(who) and not value.IsMissing(m.Who)
      who = m.Who
      sessionKey = dict.Get("Key", m)
      whoModule = m.Name
      ends = dict.Get("Ends", m)
    end
  end
  served = [rated(b, whoModule) for b in list.Concat(list.Concat(adminOfApp(), telemetryOf()), a.Served)]
  cors = [text.Trim(o) for o in text.Split(",", s.Cors) if text.Trim(o) != ""]
  guards = Guards(s.Csp, text.StartsWith("https://", s.Origin))
  words = wordsOf(a, s)
  tracer = if s.Otel == "on" tracerOf(a, s)? else missing end
  browser = if value.IsSome(tracer) and s.TelemetryClient == "on" tracerOf(a, s, browser = true)? else missing end
  geo = if s.TelemetryGeo != "off" and value.IsText(dict.Get("TelemetryGeoFile", s)) OpenGeo(s.TelemetryGeoFile)? else missing end
  origin = http.ParseUrl(s.Origin)
  env = {App: a, Settings: s, Otel: tracer, Browser: browser, Geo: geo, SpanBase: if result.IsOk(origin) {"url.scheme": if origin.Value.Secure "https" else "http" end, "server.address": origin.Value.Host} else {} end, Db: db, ReadDb: readDb, State: state, Keys: keys, Key: key, Who: who, Roles: a.Roles, Forked: value.IsMissing(dict.Get("CepheusUrl", s)),
    Served: served, Cors: cors, Https: text.StartsWith("https://", s.Origin), Profile: Profiles[s.Profile], Pages: a.Pages,
    Started: sys.Now(), Prefix: "$(encode.Hex(crypto.Random(3, keys)))-", Guards: guards,
    Expanded: dict.Dict([{Key: r, Value: Expand([r], a.Roles)} for r in dict.Keys(a.Roles)]),
    Now: if value.IsMissing(clock) (() -> sys.Now()) else (() -> Now(state)) end,
    OpenApi: json.Text(api.OpenApi([if b.Accounts dict.Put("NoKey", true, b.Endpoint) else b.Endpoint end for b in served], title = a.Name, version = a.Version)),
    SessionKey: if dict.GetOr("SessionCache", 0, s) > 0 sessionKey else missing end, SessionCache: dict.GetOr("SessionCache", 0, s), SessionKeyOf: sessionKey,
    WhoModule: whoModule, Ends: ends, GuardNames: dict.Dict([{Key: g.Name, Value: true} for g in guards]),
    JsonHeaders: list.Concat([{Name: "content-type", Value: "application/json"}], guards),
    KeyRate: keyRate, Cross: dict.Dict([{Key: b.Endpoint.Path, Value: true} for b in served if dict.Get("Cross", b.Endpoint) == true]), Words: words}
  result.Ok(env)
end

defn tracerOf(a, s, browser = false)
  (** The tracer of std/otel that the settings ask for (Otel on): its resource the app's name (or OtelService), its
      version, the profile as its environment; an Ok, or an Err that stops the start. OtelHeaders holds name=value
      pairs with commas, each value percent-encoded, as OTEL_EXPORTER_OTLP_HEADERS writes them. The browsers' tracer,
      with browser, is the service's name with "-browser", which sends what the pages told (traces and logs) and
      nothing of the process's own. *)
  headers = []
  given = dict.Get("OtelHeaders", s)
  for pair in text.Split(",", if value.IsText(given) given else "" end)
    at = text.ByteFind("=", 1, pair)
    if value.IsSome(at)
      headers = list.Append({Name: text.Lower(text.Trim(text.ByteSlice(1, at - 1, pair))), Value: encode.UrlDecode(text.Trim(text.ByteSlice(at + 1, text.ByteLength(pair), pair)))}, headers)
    end
  end
  words = t -> [text.Trim(w) for w in text.Split(",", t) if text.Trim(w) != ""]
  name = if value.IsText(dict.Get("OtelService", s)) s.OtelService else a.Name end
  made = otel.Start(service = if browser "$name-browser" else name end, version = a.Version, environment = s.Profile, endpoint = s.OtelEndpoint,
    protocol = s.OtelProtocol, compression = s.OtelCompression, headers = headers, sample = s.OtelSample, always = words(s.OtelAlways),
    slow = s.OtelSlow / 1000, trust = s.OtelTrust, signals = if browser [w for w in words(s.OtelSignals) if w != "metrics"] else words(s.OtelSignals) end,
    queue = s.OtelQueue, every = s.OtelEvery, metricsEvery = s.OtelMetricsEvery, hooks = not browser)
  if result.IsErr(made) result.Err({Kind: "api", Message: "APP_OTEL: $(made.Error.Message)"}) else made end
end

defn rated(b, whoModule)
  (** A route with what each of its requests needs of its endpoint, made once: the rate of its own limit as door counts
      it (or missing), the size of its page (or missing), its status and the labels of its metric, whether it takes an
      input, whether it is one of the accounts' (which a key of a program may not call), and its output as a function
      (outOf). *)
  e = b.Endpoint
  status = api.Done(e)
  {Endpoint: e, Handler: b.Handler, Module: b.Module, Accounts: b.Module == whoModule, WhyHead: "$(e.Name) #", Rate: if value.IsMissing(e.Limit) missing else dict.Put("Name", e.Name, rateOf(e.Limit, 60, e.Limit)) end,
    Size: if value.IsDict(e.Out) dict.Get("Size", e.Out) else missing end, Status: status, Labels: {route: e.Name, status: status},
    Takes: not value.IsMissing(e.In) or not value.IsMissing(e.Query), Upload: dict.Has("Types", e), Out: if value.IsDict(e.Out) and dict.Get("Kind", e.Out) != "file" outOf(e.Out) else missing end}
end

defn App(env)
  (** The app as std/http serves it: its routes behind Centauri's door, its live screens at /live. *)
  routes = http.App()
  for b in env.Served
    routes = http.Route(b.Endpoint.Method, b.Endpoint.Path, if env.Words.Translating (req -> answerIn(b, req, env)) else (req -> answer(b, req, env)) end, routes,
      stream = dict.Get("Most", b.Endpoint))
    if b.Upload
      (* HEAD of an upload: the bytes the server holds of one cut short, through the same door *)
      routes = http.Route("HEAD", b.Endpoint.Path, req -> answer(b, req, env), routes)
    end
  end
  if env.Profile.OpenApi
    routes = http.Get("/openapi.json", req -> openapi(env), routes)
  end
  if value.Len(env.App.Lives) > 0
    handle = http.Handler(routes then doorOf(env))
    routes = mounted(routes, env, handle)
  end
  for m in env.App.Modules
    at = if value.IsMissing(dict.Get("Pages", m)) missing else m.Pages(env) end
    if not value.IsMissing(at) and at.Path != ""
      routes = Mount(at.Path, Shelf(at.Folder, env, files = dict.GetOr("Files", {}, at)), routes)
    end
  end
  if not value.IsMissing(env.Pages)
    routes = http.Get("/*", req -> page(env.Pages, req.Params["*"]), routes)
  end
  routes then doorOf(env)
end

(* The door of an app: front, and for an app of several languages its Problem Details translated after it; an app of
   English alone pays no test for it. *)
doorOf(env, routes) = if env.Words.Translating http.Wrap((next, req) -> translated(front(next, req, env), req, env), routes) else http.Wrap((next, req) -> front(next, req, env), routes) end

(** The function of a request that the app is: what http.Serve calls, and what a test calls without the network. *)
Handler(env) = http.Handler(App(env))

defn openapi(env)
  (** /openapi.json, in the profiles dev and test. *)
  out = {Status: 200, Body: env.OpenApi, Headers: [{Name: "content-type", Value: "application/json"}]}
  out.Done = true
  out
end

defn stop(lines)
  (** Stops the start with what is wrong, one line each. *)
  for l in lines
    io.PrintError("centauri: $l")
  end
  sys.Exit(2)
end

defn ready(what, x)
  (** The value of an Ok, or the start stops with what failed; the message of the Err holds no secret. *)
  if result.IsErr(x)
    stop(["$what: $(if value.IsDict(x.Error) dict.GetOr("Message", value.Text(x.Error), x.Error) else value.Text(x.Error) end)"])
  end
  x.Value
end

defn keeping(env)
  (** The keeper of the app, every minute: the idempotency keys past their time forgotten; every hour, the telemetry of
      the pages older than APP_TELEMETRY_KEEP days. *)
  minutes = 0
  while not sys.StopAsked()
    sys.Sleep(60)
    _ = ForgetKeys(env)
    minutes += 1
    if math.Mod(minutes, 60) == 1
      _ = PruneTelemetry(env)
    end
  end
end

defn Run(a)
  (** Serves an app until a stop signal: reads its settings from the environment (each from APP_ and its name; a
      wrong or missing one stops the start, with all of them named), connects to Cepheus with the kinds of every
      module (Cepheus declares those it lacks: adding a field needs no migration), defines the rules, starts the
      modules' keepers, and serves, with TLS when Cert and Key are given, and /metrics on 127.0.0.1:AdminPort when it
      is given. Without APP_CEPHEUS_URL in dev, the database is a fork in memory, which keeps nothing. *)
  started = sys.Now()
  got = Load(a.Fields, defaults = a.Defaults)
  if result.IsErr(got)
    stop(got.Error)
  end
  s = got.Value
  db = missing
  readDb = missing
  if value.IsMissing(dict.Get("CepheusUrl", s))
    log.Warn("no APP_CEPHEUS_URL: the database is in memory, and nothing is kept")
    db = ready("database", cepheus.Fork(cepheus.Empty, a.Kinds))
  else
    connected = cepheus.Connect(s.CepheusUrl, a.Kinds, token = dict.Get("CepheusToken", s), ca = dict.Get("CepheusCa", s))
    if result.IsErr(connected) and not value.IsMissing(Retyped(dict.GetOr("Message", "", connected.Error)))
      stop([Retyped(connected.Error.Message)])
    end
    db = ready("connect", connected)
    if s.GetDb == "read"
      readDb = ready("connect with the token that reads", cepheus.Connect(s.CepheusUrl, a.Kinds, token = s.CepheusReadToken, ca = dict.Get("CepheusCa", s)))
    end
  end
  if value.Len(a.Rules) > 0
    ready("rules", cepheus.Define(a.Rules, db))
  end
  env = ready("start", Start(a, s, db, readDb = readDb))
  wrong = []
  for m in a.Modules
    if not value.IsMissing(dict.Get("Verify", m))
      checked = m.Verify(env)
      if result.IsErr(checked)
        wrong = list.Concat(wrong, if value.IsArray(checked.Error) checked.Error else [value.Text(checked.Error)] end)
      end
    end
  end
  if value.Len(wrong) > 0
    stop(wrong)
  end
  ran = ready("migrations", Migrate(a, env))
  if value.Len(ran) > 0
    log.Info("migrations", {Ran: ran})
  end
  for m in a.Modules
    if not value.IsMissing(m.Start)
      fiber.Spawn(() -> m.Start(env))
    end
  end
  fiber.Spawn(() -> keeping(env))
  if s.AdminPort > 0
    fiber.Spawn(() -> http.Serve(http.App() then http.Get("/metrics", r -> http.Plain(metrics.Text())), port = s.AdminPort, host = "127.0.0.1"))
  end
  log.Info("ready", {App: a.Name, Profile: s.Profile, Port: s.Port, Ms: (sys.Now() - started) * 1000})
  served = Listen(env)
  if not value.IsMissing(env.Otel)
    otel.Flush(env.Otel, timeout = 5)   (* what waits leaves before the process does *)
  end
  ready("serve", served)
end

defn Listen(env, listener = missing)
  (** Serves an app that Start started, as Run does once it started it: on the Port and Host of its settings, or on a
      listener already open (a test's, on port 0); with TLS when Cert and Key are given; with HTTP/3 beside TCP when
      Http3 is on, and WebTransport for the live screens when WebTransport is on too. The same routes answer every
      way. An Ok once a stop signal ended it, or an Err when TLS can't start. *)
  s = env.Settings
  wrap = missing
  if not value.IsMissing(dict.Get("Cert", s))
    wrap = tls.Server(s.Cert, dict.Get("Key", s), tls.Open()?)?
  end
  h3 = if s.Http3 == "on" quicServer(s) else missing end
  http.Serve(App(env), port = s.Port, host = s.Host, timeout = s.Timeout, maxBody = s.MaxBody, wrap = wrap, listener = listener,
    http3 = h3, webtransport = not value.IsMissing(h3) and s.WebTransport == "on")
end

defn quicServer(s)
  (** The listener of HTTP/3, beside TCP, on UDP Http3Port (the TCP port by default, as browsers find it). An OpenSSL
      without QUIC's server (before 3.6, as the 3.0 of Ubuntu 22.04 and 24.04) or a port taken leaves TCP alone, with a
      warning: HTTP/3 is a way more, never the only one. *)
  made = quic.Open() then result.AndThen(q -> http3.Server(s.Cert, dict.Get("Key", s), q, port = if s.Http3Port == 0 s.Port else s.Http3Port end, host = s.Host))
  if result.IsErr(made)
    log.Warn("http3: off, TCP alone", {Error: made.Error.Message})
    return missing
  end
  log.Info("http3", {Port: made.Value.Port, WebTransport: s.WebTransport})
  made.Value
end
