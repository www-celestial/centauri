(* What every admin page uses: its words in the super-admin's language, an endpoint called through the live screen, a
   reply shown or its problem, a list of an endpoint of pages read page after page, a time in the viewer's zone, a
   value as a cell shows it. *)
use deps/www-celestial/ceres/src/web
use src/i18n
use std/date
use std/dict
use std/fiber
use std/json
use std/list
use std/math
use std/result
use std/text
use std/value

(* ---- The words of the pages. *)

defn cell(v)
  (** A cell of std/fiber, a channel of size 1 that always holds one value, as Ceres keeps its signals. *)
  c = fiber.Channel(size = 1)
  fiber.Send(v, c)
  c
end

defn peek(c)
  (** The value of a cell. *)
  v = fiber.Receive(c, timeout = 0).Value
  fiber.Send(v, c)
  v
end

(* The language of the pages and the catalogue of their texts, which Run sets once from the server's answer, before
   the first page shows: the one value every page reads. English until then, with Words (missing here: a package's
   files load in turn, and Words is in another). *)
spoken = cell({Catalog: missing, Lang: "en", French: false})

defn speak(lang, words)
  (** The pages in a language, as the server speaks it to the super-admin (lang, one of the app's languages, or
      missing for English), with the app's catalogue (words, i18n.Catalog or i18n.Of; missing for none) after
      Centauri's (Words), so that the app's text wins for a message in both. *)
  l = if value.IsText(lang) and lang != "" text.Lower(lang) else "en" end
  catalog = if value.IsMissing(words) Words else i18n.Of([Words, words]) end
  _ = fiber.Receive(spoken, timeout = 0)
  fiber.Send({Catalog: catalog, Lang: l, French: l == "fr" or text.StartsWith("fr-", l)}, spoken)
end

defn Say(message, args = missing)
  (** A text of the admin pages in the super-admin's language, as i18n.Say gives it from the pages' catalogue: with
      args, the values of the names of the message ({N}, {Email}); without, the message as it is, or a message already
      filled in, read against the catalogue's templates (an error of the server or of the screen). A message the
      catalogue lacks shows in English, never empty. The app's own pages say their texts with it, and the titles they
      give to Page, Kind, Column, Action and Run are said with it where they show.

        Say("Users") --> "Users"
        Say("{N} rows, all of them.", {N: 3}) --> "3 rows, all of them." *)
  w = peek(spoken)
  if w.Lang == "en" and value.IsMissing(args)
    return message   (* an English text without values is shown as it is: nothing to read *)
  end
  i18n.Say(if value.IsMissing(w.Catalog) Words else w.Catalog end, w.Lang, message, args = args)
end

french() = peek(spoken).French   (* Do the pages speak French, and write numbers and times as France does? *)

defn Num(n)
  (** A number as the pages' language writes it: in French a decimal comma and the thousands apart by a narrow
      no-break space, as CLDR writes them (12 345,5, which no line breaks), else as Cesia writes it (12345.5); "" for
      missing, and a text as it is.

        Num(12345.5) --> "12345.5" *)
  if value.IsMissing(n)
    return ""
  end
  if not value.IsNumber(n) or not french()
    return value.Text(n)
  end
  frenchNumber(n)
end

defn frenchNumber(n)
  (** A number as French writes it: 12 345,5. A number Cesia writes with an exponent stays as it is. *)
  t = value.Text(n)
  sign = if text.StartsWith("-", t) "-" else "" end
  body = if sign == "" t else text.ByteSlice(2, text.ByteLength(t), t) end
  cut = text.ByteFind(".", 1, body)
  whole = if value.IsMissing(cut) body else text.ByteSlice(1, cut - 1, body) end
  frac = if value.IsMissing(cut) "" else text.ByteSlice(cut + 1, text.ByteLength(body), body) end
  if whole == "" or not list.All([b >= 48 and b <= 57 for b in text.Bytes(whole)])
    return t
  end
  out = ""
  size = text.ByteLength(whole)
  for k in 1..size
    out = "$out$(text.ByteSlice(k, k, whole))"
    if k < size and math.Mod(size - k, 3) == 0
      out = "$out$narrow"
    end
  end
  "$sign$out$(if frac == "" "" else ",$frac" end)"
end

narrow = text.Char(0x202F)   (* The narrow no-break space that French puts between thousands. *)

(* The colors of the pages, roles of the theme: what is wrong, what waits, what is fine, and the gray of what explains. *)
red = "Danger"
amber = "Warn"
green = "Ok"
gray = "Muted"

(** Calls an endpoint of the app through the live screen of the page, as any client: a signal of its reply, missing
    until it comes, then an Ok of its value or an Err of its problem. The app checks the session, the role, the limits
    and the shapes again: the page is never trusted. A call made while the page is away from its app waits, with its
    key, and goes once it is back, run once; base, the values the page saw of what it changes, lets the app refuse it
    when they changed meanwhile (a conflict, which the band shows with Keep mine and Take theirs). *)
Call(endpoint, args, p, base = missing, mine = missing) = web.Act(endpoint.Name, args, p, base = base, mine = mine, read = endpoint.Method == "GET")

defn Problem(e)
  (** The text of a problem: its status and message, the fields that are wrong, the number of its request to quote,
      and the seconds to wait on a 429, in the pages' language (the server translates its own messages when it
      speaks the language; those of the screen, the pages do). *)
  if not value.IsDict(e)
    return value.Text(e)
  end
  if dict.Get("Kind", e) == "conflict"
    changed = text.Join("; ", [Say("{Field}: {Seen} then {Now}", {Field: f.Field, Seen: Cell(f.Base), Now: Cell(f.Now)}) for f in dict.GetOr("Conflict", [], e)])
    return Say("{Message} ({Changes})", {Message: Say(dict.GetOr("Message", "", e)), Changes: changed})
  end
  head = if value.IsNumber(dict.Get("Status", e)) "$(e.Status) " else "" end
  fields = dict.GetOr("Fields", {}, e)
  more = if value.IsDict(fields) and value.Len(fields) > 0 " ($(text.Join("; ", ["$(f.Key): $(Say(f.Value))" for f in dict.Pairs(fields)])))" else "" end
  inst = if value.IsText(dict.Get("Instance", e)) " — $(Say("request {Id}", {Id: e.Instance}))" else "" end
  retry = if value.IsNumber(dict.Get("Retry", e)) " — $(Say("wait {N} s", {N: Num(e.Retry)}))" else "" end
  "$head$(Say(dict.GetOr("Message", "", e)))$more$inst$retry"
end

(** A problem as the page shows it, in red. *)
Wrong(e) = web.Text(Problem(e), color = red)

defn Replied(reply, view, waiting = "…")
  (** A live part of a reply: waiting until it comes, its problem if it failed, else view(its value). *)
  () -> shownReply(web.Get(reply), view, waiting)
end

defn shownReply(r, view, waiting)
  (** A reply as Replied shows it. *)
  if value.IsMissing(r)
    return web.Text(waiting, color = gray)
  end
  if result.IsErr(r) Wrong(r.Error) else view(r.Value) end
end

(** The value of an Ok reply, or missing while it waits or when it failed. *)
OkOf(r) = if not value.IsMissing(r) and result.IsOk(r) r.Value else missing end

(* ---- A list of an endpoint of pages (api.Page), read a page after another. *)

defn Lister(endpoint, args, p, each = missing)
  (** The list of an endpoint of pages with these arguments: the pages asked so far, each {Reply, Rows}, Reply the signal
      of its reply and Rows a memo of its rows made once by each(row) when given, as the rows of the data browser are
      read from their JSON. All, true while every page is asked one after the other. *)
  out = {Endpoint: endpoint, Args: web.Signal(args), P: p, Each: each, Asked: web.Signal([]), All: web.Signal(false), Before: web.Signal([])}
  web.Set(out.Asked, [asked(out, args)])
  out
end

defn asked(l, args)
  (** A page of a list asked: its reply's signal, and the memo of its rows. *)
  reply = Call(l.Endpoint, args, l.P)
  each = l.Each
  {Reply: reply, Rows: web.Memo(() -> if value.IsMissing(each) rowsOf(web.Get(reply)) else [each(x) for x in rowsOf(web.Get(reply))] end)}
end

defn ListRows(l)
  (** A memo of the rows of the pages of a list that came, in their order; while a list asked again waits for its first
      page (the page away from its app, a slow answer), the rows it showed before, so that what is shown stays. *)
  web.Memo(() -> rowsNow(l))
end

defn rowsNow(l)
  (** The rows of a list's pages, or those it showed before while its first page waits. *)
  pages = web.Get(l.Asked)
  if value.IsMissing(web.Get(pages[1].Reply))
    return web.Get(l.Before)
  end
  list.Flatten([web.Get(a.Rows) for a in pages])
end

rowsOf(r) = if value.IsDict(OkOf(r)) dict.GetOr("Rows", [], r.Value) else [] end   (* The rows of a reply of a page. *)

defn lastReply(l)
  (** The reply of the last page asked, missing while it waits. *)
  pages = web.Get(l.Asked)
  web.Get(pages[value.Len(pages)].Reply)
end

defn More(l)
  (** Asks the next page of a list, when its last page came and has a next. *)
  r = lastReply(l)
  after = if value.IsDict(OkOf(r)) dict.Get("After", r.Value) else missing end
  if value.IsText(after)
    web.Set(l.Asked, list.Append(asked(l, dict.Put("After", after, web.Get(l.Args))), web.Get(l.Asked)))
  end
end

defn Again(l, args)
  (** The list asked again from its first page, with these arguments; its rows stay in sight until the first page
      comes. *)
  web.Set(l.Before, rowsNow(l))
  web.Set(l.All, false)
  web.Set(l.Args, args)
  web.Set(l.Asked, [asked(l, args)])
end

(** The most rows All asks for. *)
MostRows = 200000

defn ListState(l, rows)
  (** A line under a list: how many rows came, whether more wait (More asks the next page, All every page, 200,000
      rows at most), and the problem of the last page if it failed. *)
  () -> listLine(l, rows)
end

defn listLine(l, rows)
  r = lastReply(l)
  n = value.Len(web.Get(rows))
  all = web.Get(l.All)
  if value.IsMissing(r)
    return web.Text(Say("{N} rows, loading…", {N: Num(n)}), color = gray)
  end
  if result.IsErr(r)
    return web.Row([web.Text(Say("{N} rows.", {N: Num(n)}), color = gray), Wrong(r.Error)], gap = 8)
  end
  next = value.IsDict(r.Value) and value.IsText(dict.Get("After", r.Value))
  if next and all and n < MostRows
    More(l)
    return web.Row([web.Text(Say("{N} rows, the next page asked…", {N: Num(n)}), color = gray), web.Button(Say("Stop"), () -> web.Set(l.All, false))], gap = 8)
  end
  web.Row([web.Text(if next Say("{N} rows, more after.", {N: Num(n)}) else Say("{N} rows, all of them.", {N: Num(n)}) end, color = gray),
    if next web.Button(Say("More"), () -> More(l), key = "C-m") else missing end,
    if next web.Button(Say("All"), () -> web.Set(l.All, true)) else missing end], gap = 8)
end

(* ---- Times and cells. *)

defn Seconds(x)
  (** The seconds since 1970 of a time as the endpoints give it, ISO 8601 text, or a number already; missing else. *)
  if value.IsNumber(x)
    return x
  end
  if not value.IsText(x) or x == ""
    return missing
  end
  d = date.Parse(x)
  if result.IsOk(d) date.ToUnix(d.Value) else missing end
end

two(n) = if n < 10 "0$n" else "$n" end   (* A number of two figures. *)

(** The offset of the viewer's clock from UTC at an instant, in seconds: 3600 at +01:00. *)
OffsetAt(seconds) = date.Local(seconds).Offset

(** An instant as ISO 8601 in UTC, as the endpoints take it: 2026-11-25T07:00:00Z. *)
Utc(seconds) = date.Format(date.FromUnix(seconds))

defn Local(x)
  (** A time on the viewer's clock, as 2026-11-13 03:00:05, from ISO text or seconds: "" for none. A day, as Cepheus
      keeps one (00:00 UTC), is shown as the day, 2026-11-13, on no clock. In French, the day first, as France writes
      it: 13/11/2026 03:00:05, 13/11/2026. *)
  s = Seconds(x)
  if value.IsMissing(s)
    return ""
  end
  if math.Floor(s) == s and math.Mod(math.Floor(s), 86400) == 0
    day = date.FromUnix(s)
    return if french() "$(two(day.Day))/$(two(day.Month))/$(day.Year)" else date.FormatDate(day) end
  end
  d = date.Local(s)
  if french()
    return "$(two(d.Day))/$(two(d.Month))/$(d.Year) $(two(d.Hour)):$(two(d.Minute)):$(two(d.Second))"
  end
  "$(d.Year)-$(two(d.Month))-$(two(d.Day)) $(two(d.Hour)):$(two(d.Minute)):$(two(d.Second))"
end

defn DayFirst(t)
  (** A time typed day first, as France writes it, in the order of ISO 8601: 25/11/2026 08:00 is 2026-11-25 08:00;
      any other text as it is. The fields of times take both, in every language.

        DayFirst("25/11/2026 08:00") --> "2026-11-25 08:00"
        DayFirst("2026-11-25") --> "2026-11-25" *)
  b = text.Bytes(t)
  digit(k) = b[k] >= 48 and b[k] <= 57
  if value.Len(b) < 10 or b[3] != 47 or b[6] != 47 or not list.All([digit(k) for k in [1, 2, 4, 5, 7, 8, 9, 10]])
    return t
  end
  "$(text.ByteSlice(7, 10, t))-$(text.ByteSlice(4, 5, t))-$(text.ByteSlice(1, 2, t))$(text.ByteSlice(11, value.Len(b), t))"
end

defn Span(seconds)
  (** A length of time, short: 12 s, 5 min, 3 h, 2 d (2 j in French). *)
  if not value.IsNumber(seconds)
    return ""
  end
  d = math.Div(math.Floor(seconds), 1)
  if d < 120 Say("{N} s", {N: d}) else if d < 7200 Say("{N} min", {N: math.Div(d, 60)}) else if d < 172800 Say("{N} h", {N: math.Div(d, 3600)}) else Say("{N} d", {N: math.Div(d, 86400)}) end
end

(** A label before a field, of a fixed width, so that the fields of a form line up. *)
Label(t, width = 90) = web.Stack([web.Text(t, color = gray)], width = width)

defn Cell(v)
  (** A value as a cell shows it: a text as it is, a number (in French a decimal comma, in the font of code), true and
      false as yes and no in the pages' language, a list joined, anything else as JSON; missing as "". *)
  if value.IsMissing(v)
    ""
  else if value.IsText(v)
    v
  else if value.IsBool(v)
    if v Say("yes") else Say("no") end
  else if value.IsNumber(v)
    if french() and not value.IsInt(v) web.Text(Num(v), font = "code") else v end
  else if value.IsArray(v)
    text.Join(", ", [if value.IsNumber(x) Num(x) else value.Text(Cell(x)) end for x in v])
  else
    json.Text(v)
  end
end

defn Chosen(table, rows)
  (** The row a click chose in a table of local rows, in the order the table shows them (sorted by a title clicked),
      or missing. *)
  k = web.Get(table.Chosen)
  all = web.Get(rows)
  if value.IsMissing(k) or k < 1 or k > value.Len(all)
    return missing
  end
  order = web.Get(table.Sort)
  shown = if value.IsMissing(order) all else list.SortBy(r -> r[order.By], all) end
  shown = if value.IsSome(order) and order.Desc list.Reverse(shown) else shown end
  shown[k]
end

defn Confirm(asking, label, run)
  (** A button that asks first: a click shows label again with Yes and No beside it; Yes runs run(). asking is the
      signal of the question shown, one for a page. *)
  web.Button(label, () -> web.Set(asking, {Label: label, Run: run}))
end

defn Question(asking)
  (** The question a Confirm asked, with its Yes and No, while one is asked. *)
  () -> question(web.Get(asking), asking)
end

defn question(q, asking)
  if value.IsMissing(q)
    return missing
  end
  web.Row([web.Text(Say("{Label}?", {Label: q.Label}), font = "strong"), web.Button(Say("Yes"), defn ()
    web.Set(asking, missing)
    q.Run()
  end, key = "C-y", icon = "check"), web.Button(Say("No"), () -> web.Set(asking, missing), icon = "close")], gap = 8, pad = 6, fill = "Header", border = amber)
end
