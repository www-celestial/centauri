(** The super-admin's pages, as a module of the app: pages of Ceres compiled to WebAssembly, served at the path of the
    setting AdminPath (/admin by default, off for none), that talk to the app by the endpoints of the administration
    (api.AdminOfApp, api.AdminOfAccounts, the jobs') through the same door as any client, over the live screen of the
    page: the session of its cookie, the role super checked at each call, the limits, the shapes, the log. The module
    adds the live shows of the pages (api.AdminShows): the dashboard's points, a second's for 15 minutes, a minute's and
    ten minutes' for 7 days, sampled once for the whole process from the start of the app; the events as they are
    written, the log as it goes; and one endpoint, the dashboard's history as columns (api.AdminSeriesData), of the
    role super as every other: no other way in. An app lists Module() among its modules, after
    auth's. The pages are built by the app, from its own entry, so that it adds its pages, columns and actions
    (package src/admin/pages): cesia build --target wasm admin/page.ce writes admin/page.wasm and its loader beside
    it, which Module(folder = "admin") serves. The book's chapter The admin shows both. *)
use deps/www-celestial/cepheus/cesia/cepheus
use src/api
use src/app
use std/check
use std/dict
use std/fiber
use std/http
use std/json
use std/list
use std/log
use std/math
use std/metrics
use std/result
use std/sys
use std/text
use std/value

(** The settings of the admin pages: the path they are served at, as /admin, or off for none (the endpoints stay, for
    programs); their theme, dark (the default), light, or system, which follows the browser's; AdminDisk, a folder
    whose file system the dashboard watches (DiskUsed and DiskTotal), as the data folder of the Cepheus of this
    machine, none unless given: the app reads it, and needs --allow read on it. *)
Settings = {AdminPath: check.Text(1, 200, optional = true, default = "/admin"),
  AdminTheme: check.OneOf(["dark", "light", "system"], optional = true, default = "dark"), AdminDisk: check.Text(1, 4096, optional = true)}

(* The background of the page before its first frame, as the theme paints it: no flash of white in the dark. *)
backs = {dark: "#151515", light: "#d4d4d4", system: "#151515"}

off(env) = env.Settings.AdminPath == "off"   (* Are the pages turned off? *)

(** The points of a second a screen keeps unless it asks for more: five minutes. *)
Kept = 300

(** The points of a second the sampler keeps: fifteen minutes. *)
Seconds = 900

(** The points of a minute the sampler keeps: seven days. *)
Minutes = 10080

(** The points of ten minutes the sampler keeps: seven days, in 1,008 points where a page draws a week. *)
Tens = 1008

(** The points of a frame at most, while a screen gets those the sampler kept. *)
Chunk = 500

(** The lines of the log a screen keeps. *)
KeptLines = 500

defn Module(folder = "admin", entry = "page", title = missing)
  (** The module of the admin pages: folder holds the build of the app's entry (entry.wasm, entry.js and the glue
      beside them, from cesia build --target wasm folder/entry.ce), served at AdminPath with its index.html; title
      names the browser's tab, the app's name by default. *)
  app.Module("admin", settings = Settings, serve = [app.Live(api.AdminSeries, series), app.Live(api.AdminTail, tail),
    app.Live(api.AdminLogTail, logTail), app.Serve(api.AdminSeriesData, seriesData)], pages = env -> pagesOf(env, folder, entry, title), verify = env -> built(env, folder, entry),
    start = started)
end

defn built(env, folder, entry)
  (** The start goes on without the build of the pages, with a warning: the pages answer that they are to build. *)
  if not off(env) and not sys.Exists("$folder/$entry.wasm")
    log.Warn("the admin pages are not built: cesia build --target wasm $folder/$entry.ce", {Folder: folder})
  end
  result.Ok(missing)
end

defn pagesOf(env, folder, entry, title)
  (** The pages at AdminPath: the folder's files and the page that loads them, which holds no script of its own (the
      Content-Security-Policy allows none), no data and no secret: what it shows comes by the live screen, for a
      session of the role super only. *)
  path = env.Settings.AdminPath
  if off(env)
    return missing
  end
  name = http.Escape(if value.IsMissing(title) "Admin — $(env.App.Name)" else title end)
  ready = sys.Exists("$folder/$entry.wasm")
  (* The page races WebTransport against WebSocket for its live channel only when the app takes sessions. *)
  offer = if dict.Get("WebTransport", env.Settings) == "on" and dict.Get("Http3", env.Settings) == "on" "<meta name=\"webtransport\" content=\"on\">\n" else "" end
  theme = env.Settings.AdminTheme
  index = if ready "<!doctype html>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n$offer<title>$name</title>\n<link rel=\"stylesheet\" href=\"$path/admin.css\">\n<div id=\"page\"><canvas data-path=\"/\" data-theme=\"$theme\"></canvas></div>\n<script type=\"module\" src=\"$path/$entry.js\"></script>\n"
    else "<!doctype html>\n<meta charset=\"utf-8\">\n<title>$name</title>\n<p>The admin pages are not built: cesia build --target wasm $(http.Escape(folder))/$(http.Escape(entry)).ce\n" end
  light = if theme == "system" "@media (prefers-color-scheme: light) { html, body { background: #d4d4d4; } }\n" else "" end
  {Path: path, Folder: folder, Files: {"index.html": index, "admin.css": "html, body { margin: 0; height: 100%; background: $(backs[theme]); }\n$light#page { width: 100%; height: 100%; }\n"}}
end

(* ---- The dashboard: a point each second, and each minute, sampled once for the process. *)

defn totals(raw)
  (** The counters of std/metrics the dashboard reads, summed over their labels: requests, those of status 5xx, the
      refusals by reason, and the sign-ins that opened a session and those refused. *)
  out = {Requests: 0, Errors: 0, Origin: 0, Limit: 0, Signin: 0, Role: 0, SignedIn: 0, FailedSignIns: 0}
  for line in text.Lines(raw)
    if text.StartsWith("centauri_", line)
      cut = text.Split(" ", line)
      v = text.Number(cut[value.Len(cut)])
      v = if value.IsNumber(v) v else 0 end
      if text.StartsWith("centauri_requests_total", line)
        out.Requests += v
        if text.Contains("status=\"5", line)
          out.Errors += v
        end
      else if text.StartsWith("centauri_refused_total", line)
        for reason in ["Origin", "Limit", "Signin", "Role"]
          if text.Contains("reason=\"$(text.Lower(reason))\"", line)
            out[reason] += v
          end
        end
      else if text.StartsWith("centauri_signins_total", line)
        if text.Contains("result=\"ok\"", line)
          out.SignedIn += v
        else if text.Contains("result=\"failed\"", line)
          out.FailedSignIns += v
        end
      end
    end
  end
  out
end

defn quantile(sorted, q)
  (** The q-quantile of sorted numbers, the nearest rank (Hyndman and Fan's definition 1): 0 for none. *)
  n = value.Len(sorted)
  if n == 0 0 else sorted[list.Max([1, math.Ceil(q * n)])] end
end

(* The sketch of the times of a minute's requests, DDSketch (Masson, Rim and Lee, PVLDB 12(12), 2019): a time x, in
   milliseconds, counts in the bucket k = ceil(log x / log gamma), of the times in (gamma^(k-1), gamma^k], whose value
   2 gamma^k / (gamma + 1) is within alpha of each of them. A quantile of the minute is then within alpha of the exact
   one, its rank exact, whatever the number of times, in at most 1,383 buckets: the times are clamped to [0.001, 1e9]. *)
alpha = 0.01
gamma = (1 + alpha) / (1 - alpha)
lnGamma = math.Log(gamma)

defn sketched(sk, ms)
  (** A sketch with the times ms counted in. Sorted, as a second's are, a run of times of one bucket costs one look up. *)
  k = 0
  low = 0
  top = -1
  n = 0
  for x in ms
    if x > top or x <= low
      if n > 0
        sk[k] = dict.GetOr(k, 0, sk) + n
      end
      k = math.Ceil(math.Log(if x < 0.001 0.001 else if x > 1e9 1e9 else x end) / lnGamma)
      low = if k <= (-345) (-1e300) else gamma ^ (k - 1) end
      top = if k >= 1037 1e300 else gamma ^ k end
      n = 0
    end
    n += 1
  end
  if n > 0
    sk[k] = dict.GetOr(k, 0, sk) + n
  end
  sk
end

defn sketchQuantile(sk, n, q)
  (** The q-quantile of the n times a sketch counts, at the rank quantile takes, to the microsecond: 0 for none. *)
  if n == 0
    return 0
  end
  rank = list.Max([1, math.Ceil(q * n)])
  seen = 0
  for k in list.Sort(dict.Keys(sk))
    seen += sk[k]
    if seen >= rank
      return math.Round(2 * gamma ^ k / (gamma + 1) * 1000) / 1000
    end
  end
  0
end

defn jobCounts(env)
  (** The jobs ready, running and dead, when the app runs jobs: each a Count of Cepheus. *)
  out = {Ready: 0, Running: 0, Dead: 0}
  job = list.FindFirst(k -> dict.Get("name", k) == "centauri_job", env.App.Kinds)
  if value.IsMissing(job)
    return out
  end
  for state in ["ready", "running", "dead"]
    got = cepheus.Find(1, j -> {Where: [[j, job.State, state]], Give: {N: cepheus.Count()}}, env.Db)
    if result.IsOk(got) and value.Len(got.Value) > 0
      out[{ready: "Ready", running: "Running", dead: "Dead"}[state]] = got.Value[1].N
    end
  end
  out
end

defn second(at, now, before, ms, failures, jobs, screens)
  (** The point of a second that ends at at: the counters' growth since before, the times ms of its requests, sorted,
      the failed sign-ins of the last minute, the jobs, the live screens open. *)
  {At: at, Requests: now.Requests - before.Requests, Errors: now.Errors - before.Errors, Origin: now.Origin - before.Origin,
    Limit: now.Limit - before.Limit, Signin: now.Signin - before.Signin, Role: now.Role - before.Role, Failures: failures,
    P50: quantile(ms, 0.5), P99: quantile(ms, 0.99), Ready: jobs.Ready, Running: jobs.Running, Dead: jobs.Dead, Step: 1, Screens: screens,
    SignedIn: now.SignedIn - before.SignedIn, FailedSignIns: now.FailedSignIns - before.FailedSignIns}
end

(* The fields of a minute's point that sum those of its seconds; the others are its last second's. *)
summed = ["Requests", "Errors", "Origin", "Limit", "Signin", "Role", "SignedIn", "FailedSignIns"]

(** The minute that holds a time: its first second. *)
minuteOf(at) = math.Floor(at / 60) * 60

(** The ten minutes that hold a time: their first second. *)
tenOf(at) = math.Floor(at / 600) * 600

(** A span begun, of span seconds (a minute's, ten minutes'), that holds the second at: nothing counted yet. *)
opened(at, span = 60) = {At: math.Floor(at / span) * span, Requests: 0, Errors: 0, Origin: 0, Limit: 0, Signin: 0, Role: 0, SignedIn: 0, FailedSignIns: 0,
  Last: missing, Sketch: dict.Dict(), Times: 0}

defn summedIn(m, p)
  (** A span with the counts of a point of it summed in, the point its last. *)
  for f in summed
    m[f] += p[f]
  end
  m.Last = p
  m
end

defn folded(m, p, ms)
  (** A minute with a point of its seconds counted in, and the times ms of its requests. *)
  m = summedIn(m, p)
  m.Sketch = sketched(m.Sketch, ms)
  m.Times += value.Len(ms)
  m
end

defn joined(t, minute, p)
  (** Ten minutes with a minute of them counted in, p its point: the sketches of their times merged, the buckets of
      one added to those of the other, so that the quantiles of the ten minutes are those of all their requests. *)
  t = summedIn(t, p)
  t.Sketch = merged(t.Sketch, minute.Sketch)
  t.Times += minute.Times
  t
end

defn merged(sk, other)
  (** A sketch with the counts of another added, bucket by bucket: DDSketch merges with no loss. *)
  for k in dict.Keys(other)
    sk[k] = dict.GetOr(k, 0, sk) + other[k]
  end
  sk
end

defn closed(m, step = 60)
  (** The point of a span of step seconds: the sums of its points, its last one's Failures, jobs, screens and use of the
      machine, and the quantiles of the times of all its requests. *)
  l = m.Last
  out = {At: m.At, Requests: m.Requests, Errors: m.Errors, Origin: m.Origin, Limit: m.Limit, Signin: m.Signin, Role: m.Role, Failures: l.Failures,
    P50: sketchQuantile(m.Sketch, m.Times, 0.5), P99: sketchQuantile(m.Sketch, m.Times, 0.99), Ready: l.Ready, Running: l.Running, Dead: l.Dead,
    Step: step, Screens: l.Screens, SignedIn: m.SignedIn, FailedSignIns: m.FailedSignIns}
  for f in used
    if dict.Has(f, l)
      out[f] = l[f]
    end
  end
  out
end

(* The fields of a point of what the process uses, each where the system tells it. *)
used = ["Cpu", "Memory", "DiskUsed", "DiskTotal"]

defn usage(p, u, cpu, disk)
  (** A second's point with what the process uses: cpu its share of a core over the second, in percent, or missing;
      u what sys.Usage gives; disk an Ok of what sys.Disk gives, or missing. *)
  out = p
  if value.IsSome(cpu)
    out.Cpu = cpu
  end
  if value.IsSome(u.Memory)
    out.Memory = u.Memory
  end
  if value.IsSome(disk) and result.IsOk(disk)
    out.DiskUsed = disk.Value.Used
    out.DiskTotal = disk.Value.Total
  end
  out
end

(** The share of a core, in percent to the tenth, of the CPU seconds cpu taken over the seconds wall. *)
share(cpu, wall) = math.Round(cpu / list.Max([wall, 0.000001]) * 1000) / 10

(** The points of a ring with p after them, the most last ones. *)
ring(p, xs, most) = list.Append(p, if value.Len(xs) < most xs else list.Skip(value.Len(xs) - most + 1, xs) end)

(** The n last points of a ring. *)
last(n, xs) = list.Skip(list.Max([0, value.Len(xs) - n]), xs)

(** The board of a process's sampler: its rings, the seconds', the minutes' and the ten minutes', the number of points
    each made since the start, and Next, a channel closed when the next board is written. *)
board(env) = fiber.Recall("admin.series", 0, env.Own)

defn sampler(env)
  (** The board of the sampler of this process, the sampler started if it was not: one for the whole process, whatever
      the screens that watch it. *)
  b = board(env)
  if value.IsMissing(b)
    (* no wait between the Recall and the Remember: no other fiber runs in between, so two screens never start two *)
    b = {Seconds: [], SecondN: 0, Minutes: [], MinuteN: 0, Tens: [], TenN: 0, Next: fiber.Channel()}
    fiber.Remember("admin.series", b, 1e300, env.Own)
    fiber.Spawn(() -> supervising(env))
  end
  b
end

defn started(env)
  (** At the start of the app, its sampler, so that the dashboard has the hours before it was opened; with the pages
      off, at the first screen that asks for the points. *)
  if not off(env)
    _ = sampler(env)
  end
end

timedOut(got) = result.IsErr(got) and got.Error.Kind == "timeout"   (* Did a wait end by its time? *)

defn supervising(env)
  (** Runs the sampler for as long as the process runs (it ends with it: no stop to wait for); a bug that stops it is
      logged, and it starts again 10 seconds later, from the points it kept. *)
  while true
    done = fiber.Wait(fiber.Spawn(() -> sampling(env)))
    if result.IsOk(done)
      return missing
    end
    why = if value.IsDict(done.Error) dict.GetOr("Message", "", done.Error) else value.Text(done.Error) end
    log.Error("the sampler of the dashboard stopped: it starts again in 10 seconds", {Error: why})
    sys.Sleep(10)
  end
end

defn sampling(env)
  (** Each second, a tick of the sampler. *)
  st = begun(env)
  next = sys.Now() + 1
  while true
    sys.Sleep(list.Max([0, next - sys.Now()]))
    (* a second each: a process that was stopped (a machine asleep) takes up its seconds from now, in no burst *)
    next = if next + 1 > sys.Now() next + 1 else sys.Now() + 1 end
    st = ticked(env, st)
  end
end

defn begun(env)
  (** What the sampler of a process holds from one second to the next, as it starts: the board it wrote last, the
      counters and the number of the last line of the log read, the jobs, the minute and the ten minutes going on, and
      its ticks. *)
  {Board: board(env), Before: totals(metrics.Text()), Seq: app.Times(0, env.State).Seq, Jobs: {Ready: 0, Running: 0, Dead: 0}, Minute: missing, Ten: missing,
    Tick: 0, Cpu: sys.Usage().Cpu, Wall: sys.Now()}
end

defn ticked(env, st)
  (** A second of the sampler: a point of this process, the counters' growth since the last one and the times of the
      requests the log kept since; at the first second of a minute, the point of the minute before, and of the ten
      minutes before at the first second of ten others. The new board is
      written, and the Next of the one before closed, so that the screens that wait for it wake, all at once. *)
  st.Tick += 1
  times = app.Times(st.Seq, env.State)
  (* every request writes a line: while none came, no counter moved, and the metrics are not read *)
  now = if times.Seq == st.Seq st.Before else totals(metrics.Text()) end
  st.Seq = times.Seq
  ms = list.Sort(times.Ms)
  if math.Mod(st.Tick, 5) == 1
    (* the jobs counted at the first second, then every 5: the start of the app asks nothing of the database *)
    st.Jobs = jobCounts(env)
  end
  u = sys.Usage()
  wall = sys.Now()
  folder = dict.Get("AdminDisk", env.Settings)
  p = second(math.Floor(env.Now()), now, st.Before, ms, app.Failures(env.State), st.Jobs, app.Screens(env.State))
  p = usage(p, u, share(u.Cpu - st.Cpu, wall - st.Wall), if value.IsMissing(folder) missing else sys.Disk(folder) end)
  st.Before = now
  st.Cpu = u.Cpu
  st.Wall = wall
  t = advanced(st.Board, st.Minute, st.Ten, p, ms, fiber.Channel())
  fiber.Remember("admin.series", t.Board, 1e300, env.Own)
  fiber.Close(st.Board.Next)
  st.Board = t.Board
  st.Minute = t.Minute
  st.Ten = t.Ten
  st
end

defn advanced(b, minute, ten, p, ms, next)
  (** The board b after the point p of a second, ms the times of its requests, minute the minute it counts in and ten
      the ten minutes: {Board, Minute, Ten}, the new board's Next next. The point of a minute goes in the minutes' ring
      at the first second of another, and in its ten minutes; the point of ten minutes in their ring at the first
      second of ten others. A clock that jumps ends the spans it was in; none is made for the spans it jumped over. *)
  mins = b.Minutes
  minN = b.MinuteN
  tens = b.Tens
  tenN = b.TenN
  if value.IsSome(minute) and minuteOf(p.At) != minute.At
    mp = closed(minute)
    mins = ring(mp, mins, Minutes)
    minN += 1
    if value.IsSome(ten) and tenOf(minute.At) != ten.At
      tens = ring(closed(ten, step = 600), tens, Tens)
      tenN += 1
      ten = missing
    end
    ten = joined(if value.IsMissing(ten) opened(minute.At, span = 600) else ten end, minute, mp)
    minute = missing
  end
  if value.IsSome(ten) and tenOf(p.At) != ten.At
    tens = ring(closed(ten, step = 600), tens, Tens)
    tenN += 1
    ten = missing
  end
  {Board: {Seconds: ring(p, b.Seconds, Seconds), SecondN: b.SecondN + 1, Minutes: mins, MinuteN: minN, Tens: tens, TenN: tenN, Next: next},
    Minute: folded(if value.IsMissing(minute) opened(p.At) else minute end, p, ms), Ten: ten}
end

defn moved(a, an, b, bn, w)
  (** The points of a ring that a screen showing its last w gets, from the state a of it, its an-th point last, to the
      state b, its bn-th point last: {Added, Removed}, Removed the very rows it had. *)
  la = value.Len(a)
  lb = value.Len(b)
  va = list.Min([w, la])
  vb = list.Min([w, lb])
  gone = list.Max([0, list.Min([va, (bn - vb + 1) - (an - va + 1)])])
  came = list.Max([0, list.Min([vb, bn - an])])
  (* the rows themselves, by their places: a screen costs what changed, not its window *)
  {Added: [b[k] for k in (lb - came + 1)..lb], Removed: [a[k] for k in (la - va + 1)..(la - va + gone)]}
end

defn changes(old, new, want)
  (** What a screen that shows the last want.Seconds points of a second, want.Minutes of a minute and want.Tens of ten
      minutes of the board old gets for the board new. *)
  s = moved(old.Seconds, old.SecondN, new.Seconds, new.SecondN, want.Seconds)
  m = moved(old.Minutes, old.MinuteN, new.Minutes, new.MinuteN, want.Minutes)
  t = moved(old.Tens, old.TenN, new.Tens, new.TenN, want.Tens)
  {Added: list.Flatten([s.Added, m.Added, t.Added]), Removed: list.Flatten([s.Removed, m.Removed, t.Removed])}
end

ended(s) = not timedOut(fiber.Receive(s.Ended, timeout = 0))   (* Has the screen ended? *)

defn series(s, args)
  (** The show admin.series: the points of the sampler of the process (started here if it was not) that the screen
      asks, then what changes at each new board, until the screen ends. Each screen costs a fiber that sleeps between
      two boards, and nothing of the sampling. *)
  b = sampler(s.Env)
  out = fiber.Channel(size = 64)
  fiber.Spawn(() -> relaying(s, args, b, out))
  (* a screen that ended while its page read nothing never leaves its relay waiting on a channel full: emptied *)
  fiber.Spawn(defn ()
    _ = fiber.Receive(s.Ended)
    while result.IsOk(fiber.Receive(out, timeout = 0))
    end
  end)
  result.Ok(out)
end

defn relaying(s, want, b, out)
  (** Sends a screen the points it asks of the board b, Chunk a frame at most, the newest first: the seconds, the
      minutes, then the ten minutes; then at each new board the points that came and those that left its window. *)
  rows = list.Flatten([list.Reverse(last(want.Seconds, b.Seconds)), list.Reverse(last(want.Minutes, b.Minutes)), list.Reverse(last(want.Tens, b.Tens))])
  n = value.Len(rows)
  group = 1
  fiber.Send({Group: group, Rows: list.Take(Chunk, rows)}, out)
  at = Chunk
  while at < n
    if ended(s)
      fiber.Close(out)
      return missing
    end
    group += 1
    fiber.Send({Group: group, Added: [rows[k] for k in (at + 1)..list.Min([at + Chunk, n])], Removed: []}, out)
    at += Chunk
  end
  while true
    _ = fiber.Select([s.Ended, b.Next])
    if ended(s)
      fiber.Close(out)
      return missing
    end
    nb = board(s.Env)
    c = changes(b, nb, want)
    b = nb
    if value.Len(c.Added) + value.Len(c.Removed) > 0
      group += 1
      fiber.Send({Group: group, Added: c.Added, Removed: c.Removed}, out)
    end
  end
end

(* The fields of a point that each point has, as the columns of the history give them. *)
counted = ["Requests", "Errors", "Origin", "Limit", "Signin", "Role", "Failures", "SignedIn", "FailedSignIns", "P50", "P99", "Ready", "Running",
  "Dead", "Screens"]

defn columns(step, ps)
  (** Points of a step as the history gives them: {Step, Ats, Cols}, a list of numbers for each field, the times of the
      requests to the tenth of a millisecond; a field of what the process uses only when every point has it. *)
  cols = {}
  for f in counted
    cols[f] = if f == "P50" or f == "P99" [math.Round(p[f] * 10) / 10 for p in ps] else [p[f] for p in ps] end
  end
  for f in used
    if value.Len(ps) > 0 and list.All([dict.Has(f, p) for p in ps])
      cols[f] = [p[f] for p in ps]
    end
  end
  {Step: step, Ats: [p.At for p in ps], Cols: cols}
end

defn seriesData(r, q)
  (** GET /admin/series: the last Count points of a Step that the sampler of the process keeps (started here if it was
      not), the oldest first, as columns. *)
  if not (q.Step in [1, 60, 600])
    return app.Fail(422, "Check the query.", fields = {Step: "1, 60 or 600: the points of a second, of a minute, of ten minutes."})
  end
  b = sampler(r.Env)
  kept = if q.Step == 1 b.Seconds else if q.Step == 60 b.Minutes else b.Tens end
  result.Ok(columns(q.Step, if value.IsMissing(q.Count) kept else last(q.Count, kept) end))
end

(* ---- The events as they are written, and the log as it goes. *)

defn tail(s, args)
  (** The show admin.events: a watch of the events of the last hour. *)
  since = s.Now - 3600
  w = cepheus.Watch(6, (e, at, k, ip, route, d) -> {Where: [[e, app.Event.At, at], cepheus.Above(at, since), [e, app.Event.Kind, k], [e, app.Event.Ip, ip],
    [e, app.Event.Route, route], [e, app.Event.Detail, d]], Give: {Id: e, At: at, Kind: k, Ip: ip, Route: route, Detail: d}}, s.Db, until = s.Ended)?
  result.Ok(w.Changes)
end

defn logTail(s, args)
  (** The show admin.logs: the last lines of the log of this process, then each new one, each second. *)
  out = fiber.Channel(size = 64)
  fiber.Spawn(() -> tailing(s, out))
  result.Ok(out)
end

defn row(seq, l)
  (** A line of the log as the page gets it. *)
  {Seq: seq, At: l.At, Level: l.Level, Message: l.Message, Fields: json.Text(l.Fields)}
end

defn tailing(s, out)
  (** Sends the new lines each second, and takes back those past the last KeptLines. *)
  env = s.Env
  first = app.Tail(0, env.State)
  n = value.Len(first.Lines)
  kept = [row(first.Seq - n + k, first.Lines[k]) for k in 1..n]
  kept = list.Skip(list.Max([0, value.Len(kept) - KeptLines]), kept)
  seq = first.Seq
  group = 1
  fiber.Send({Group: group, Rows: kept}, out)
  while true
    got = fiber.Receive(s.Ended, timeout = 1)
    if not (result.IsErr(got) and got.Error.Kind == "timeout")
      fiber.Close(out)
      return missing
    end
    t = app.Tail(seq, env.State)
    m = value.Len(t.Lines)
    if m > 0
      added = [row(t.Seq - m + k, t.Lines[k]) for k in 1..m]
      kept = list.Concat(kept, added)
      over = list.Max([0, value.Len(kept) - KeptLines])
      gone = list.Take(over, kept)
      kept = list.Skip(over, kept)
      group += 1
      fiber.Send({Group: group, Added: added, Removed: gone}, out)
      seq = t.Seq
    end
  end
end
