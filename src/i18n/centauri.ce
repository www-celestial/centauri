(* Centauri's own words in French: the errors of its door, of its accounts and of std/check's shapes, the titles of
   HTTP's statuses, and its mails. An app's catalogue comes after it (Of), and wins for a message in both. *)

(** Centauri's catalogue: its messages and those of std/check, in French.

      Say(Centauri, "fr", "Check the fields.") --> "Vérifiez les champs."
      Say(Centauri, "fr", "Text of 1 to 120 bytes.") --> "Un texte de 1 à 120 octets."
      Say(Centauri, "fr", "Too many requests: wait 1 seconds.") --> "Trop de requêtes : attendez 1 seconde." *)
Centauri = Catalog({fr: {
  "Required.": "Obligatoire.",
  "Text of {Min} to {Max} bytes.": "Un texte de {Min} à {Max} octets.",
  "Text without control characters.": "Un texte sans caractère de contrôle.",
  "An id.": "Un identifiant.",
  "A whole number from {Min} to {Max}.": "Un nombre entier de {Min} à {Max}.",
  "A number from {Min} to {Max}.": "Un nombre de {Min} à {Max}.",
  "An amount from {Min} to {Max}, with at most {Scale} decimals.": {one: "Un montant de {Min} à {Max}, avec au plus {Scale} décimale.", other: "Un montant de {Min} à {Max}, avec au plus {Scale} décimales.", By: "Scale"},
  "true or false.": "true ou false.",
  "A date, as 2026-11-25.": "Une date, comme 2026-11-25.",
  "An instant, as 2026-11-25T18:30:00Z.": "Un instant, comme 2026-11-25T18:30:00Z.",
  "One of: {List}.": "L’une de ces valeurs : {List}.",
  "A list of {Min} to {Max} items.": "Une liste de {Min} à {Max} éléments.",
  "An object with fields.": "Un objet avec des champs.",
  "An e-mail address, as ada@example.com.": "Une adresse e-mail, comme ada@example.com.",
  "An address that starts with https://.": "Une adresse qui commence par https://.",
  "An address that starts with https:// or http://.": "Une adresse qui commence par https:// ou http://.",
  "A date.": "Une date.",

  "Bad Request": "Requête incorrecte",
  "Unauthorized": "Non authentifié",
  "Forbidden": "Interdit",
  "Not Found": "Introuvable",
  "Method Not Allowed": "Méthode non permise",
  "Conflict": "Conflit",
  "Gone": "Disparu",
  "Payload Too Large": "Contenu trop grand",
  "Content Too Large": "Contenu trop grand",
  "Unsupported Media Type": "Type de contenu non pris en charge",
  "Unprocessable Content": "Contenu non traitable",
  "Unprocessable Entity": "Contenu non traitable",
  "Precondition Required": "Condition préalable requise",
  "Too Many Requests": "Trop de requêtes",
  "Internal Server Error": "Erreur interne du serveur",
  "Service Unavailable": "Service indisponible",

  "Check the fields.": "Vérifiez les champs.",
  "Check the query.": "Vérifiez la requête.",
  "Check the form.": "Vérifiez le formulaire.",
  "The body is not JSON.": "Le corps n’est pas du JSON.",
  "The body is JSON: send it with Content-Type: application/json.": "Le corps est du JSON : envoyez-le avec Content-Type: application/json.",
  "Sign in first.": "Connectez-vous d’abord.",
  "This is for the role {Role}.": "Ceci est réservé au rôle {Role}.",
  "There is no such address.": "Cette adresse n’existe pas.",
  "There is no such thing.": "Cette chose n’existe pas.",
  "This request comes from another site than the app's.": "Cette requête vient d’un autre site que celui de l’application.",
  "Too many requests: wait {Seconds} seconds.": {one: "Trop de requêtes : attendez {Seconds} seconde.", other: "Trop de requêtes : attendez {Seconds} secondes."},
  "Too many attempts: wait {Seconds} seconds.": {one: "Trop d’essais : attendez {Seconds} seconde.", other: "Trop d’essais : attendez {Seconds} secondes."},
  "Too many failed sign-ins: wait {Seconds} seconds.": {one: "Trop de connexions échouées : attendez {Seconds} seconde.", other: "Trop de connexions échouées : attendez {Seconds} secondes."},
  "Too many sign-ins at once: try again in a moment.": "Trop de connexions en même temps : réessayez dans un instant.",
  "Too many files are coming at once: send it again in a moment.": "Trop de fichiers arrivent en même temps : renvoyez-le dans un instant.",
  "This cursor is not one of this list: ask the first page again.": "Ce curseur n’est pas celui de cette liste : redemandez la première page.",
  "This changed meanwhile: read it again, then try again.": "Ceci a changé entre-temps : relisez-le, puis réessayez.",
  "This value is taken already.": "Cette valeur est déjà prise.",
  "This is not yours to read or change.": "Ce n’est pas à vous de le lire ou de le changer.",
  "The database can't be reached: try again in a moment.": "La base de données est injoignable : réessayez dans un instant.",
  "This took too long: try again.": "Cela a pris trop de temps : réessayez.",
  "Busy: try again in a moment.": "Occupé : réessayez dans un instant.",
  "Something went wrong on our side.": "Une erreur s’est produite de notre côté.",
  "Something went wrong on our side. Request {Id}.": "Une erreur s’est produite de notre côté. Requête {Id}.",
  "This file is larger than {Most} bytes.": "Ce fichier dépasse {Most} octets.",
  "The file was cut short.": "Le fichier a été coupé.",

  "This e-mail and password don't match.": "Cette adresse e-mail et ce mot de passe ne correspondent pas.",
  "This e-mail has an account already: sign in.": "Cette adresse e-mail a déjà un compte : connectez-vous.",
  "A password of {Min} to 128 bytes.": "Un mot de passe de {Min} à 128 octets.",
  "Signing up is closed: ask an administrator.": "Les inscriptions sont fermées : demandez à un administrateur.",
  "Signing up is by invitation only: use the link of yours.": "L’inscription se fait seulement sur invitation : utilisez le lien de la vôtre.",
  "Someone signed up at the same moment: send again.": "Quelqu’un s’est inscrit au même moment : renvoyez.",
  "The tenant is being made: try again.": "L’espace est en cours de création : réessayez.",
  "This invitation is not yours, or it has ended.": "Cette invitation n’est pas la vôtre, ou elle a expiré.",
  "You are no member of this tenant.": "Vous n’êtes pas membre de cet espace.",
  "Check your e-mail address first: open the link of the mail we sent you.": "Vérifiez d’abord votre adresse e-mail : ouvrez le lien du message que nous vous avons envoyé.",
  "This link is not valid, or it has ended: ask for a new one.": "Ce lien n’est pas valide, ou il a expiré : demandez-en un nouveau.",
  "The old password is not this one.": "L’ancien mot de passe n’est pas celui-ci.",
  "Answer this challenge first, then send again with Proof.": "Répondez d’abord à ce défi, puis renvoyez avec Proof.",
  "Only who has the role {Role} gives it or takes it.": "Seul qui a le rôle {Role} le donne ou le retire.",
  "A tenant keeps one owner at least.": "Un espace garde au moins un propriétaire.",
  "A tenant keeps one owner at least: give the role owner to another member first.": "Un espace garde au moins un propriétaire : donnez d’abord le rôle owner à un autre membre.",
  "{Role} is no role of this app.": "{Role} n’est pas un rôle de cette application.",
  "You may not disable yourself.": "Vous ne pouvez pas vous désactiver vous-même.",
  "You may not take the role super from yourself.": "Vous ne pouvez pas vous retirer le rôle super.",

  "Check your e-mail address for {App}": "Vérifiez votre adresse e-mail pour {App}",
  "Hello {Name},\n\nTo check that this address is yours, open this link within {Hours} hours:\n\n{Link}\n\nIf you didn't sign up for {App}, ignore this mail.\n": {
    one: "Bonjour {Name},\n\nPour vérifier que cette adresse est la vôtre, ouvrez ce lien dans l’heure :\n\n{Link}\n\nSi vous ne vous êtes pas inscrit à {App}, ignorez ce message.\n",
    other: "Bonjour {Name},\n\nPour vérifier que cette adresse est la vôtre, ouvrez ce lien dans les {Hours} heures :\n\n{Link}\n\nSi vous ne vous êtes pas inscrit à {App}, ignorez ce message.\n", By: "Hours"},
  "A new password for {App}": "Un nouveau mot de passe pour {App}",
  "Hello {Name},\n\nTo set a new password, open this link within {Hours} hours:\n\n{Link}\n\nIf you didn't ask for it, ignore this mail: your password stays as it is.\n": {
    one: "Bonjour {Name},\n\nPour choisir un nouveau mot de passe, ouvrez ce lien dans l’heure :\n\n{Link}\n\nSi vous ne l’avez pas demandé, ignorez ce message : votre mot de passe reste le même.\n",
    other: "Bonjour {Name},\n\nPour choisir un nouveau mot de passe, ouvrez ce lien dans les {Hours} heures :\n\n{Link}\n\nSi vous ne l’avez pas demandé, ignorez ce message : votre mot de passe reste le même.\n", By: "Hours"},
  "Someone tried to sign up with your address at {App}": "Quelqu’un a essayé de s’inscrire à {App} avec votre adresse",
  "Hello {Name},\n\nSomeone tried to sign up for {App} with this address, which has an account already. If it was you, sign in, or set a new password here:\n\n{Link}\n\nIf it wasn't you, ignore this mail: nothing changed.\n": "Bonjour {Name},\n\nQuelqu’un a essayé de s’inscrire à {App} avec cette adresse, qui a déjà un compte. Si c’était vous, connectez-vous, ou choisissez un nouveau mot de passe ici :\n\n{Link}\n\nSi ce n’était pas vous, ignorez ce message : rien n’a changé.\n",
}})
