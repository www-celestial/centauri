(* Centauri's own words in French: the errors of its door, of its accounts and of std/check's shapes, the titles of
   HTTP's statuses, and its mails. An app's catalogue comes after it (Of), and wins for a message in both. *)

(** Centauri's catalogue: its messages and those of std/check, in French.

      Say(Centauri, "fr", "Check the fields.") --> "Vérifiez les champs."
      Say(Centauri, "fr", "Text of 1 to 120 bytes.") --> "Un texte de 1 à 120 octets."
      Say(Centauri, "fr", "Too many requests: wait 1 seconds.") --> "Trop de requêtes : attendez 1 seconde." *)
Centauri = Catalog("fr", [
  ["Required.", "Obligatoire."],
  ["Text of {Min} to {Max} bytes.", "Un texte de {Min} à {Max} octets."],
  ["Text without control characters.", "Un texte sans caractère de contrôle."],
  ["An id.", "Un identifiant."],
  ["A whole number from {Min} to {Max}.", "Un nombre entier de {Min} à {Max}."],
  ["A number from {Min} to {Max}.", "Un nombre de {Min} à {Max}."],
  ["An amount from {Min} to {Max}, with at most {Scale} decimals.", {one: "Un montant de {Min} à {Max}, avec au plus {Scale} décimale.", other: "Un montant de {Min} à {Max}, avec au plus {Scale} décimales.", By: "Scale"}],
  ["true or false.", "true ou false."],
  ["A date, as 2026-11-25.", "Une date, comme 2026-11-25."],
  ["An instant, as 2026-11-25T18:30:00Z.", "Un instant, comme 2026-11-25T18:30:00Z."],
  ["One of: {List}.", "L’une de ces valeurs : {List}."],
  ["A list of {Min} to {Max} items.", "Une liste de {Min} à {Max} éléments."],
  ["An object with fields.", "Un objet avec des champs."],
  ["An e-mail address, as ada@example.com.", "Une adresse e-mail, comme ada@example.com."],
  ["An address that starts with https://.", "Une adresse qui commence par https://."],
  ["An address that starts with https:// or http://.", "Une adresse qui commence par https:// ou http://."],
  ["A date.", "Une date."],
  ["Bad Request", "Requête incorrecte"],
  ["Unauthorized", "Non authentifié"],
  ["Forbidden", "Interdit"],
  ["Not Found", "Introuvable"],
  ["Method Not Allowed", "Méthode non permise"],
  ["Conflict", "Conflit"],
  ["Gone", "Disparu"],
  ["Payload Too Large", "Contenu trop grand"],
  ["Content Too Large", "Contenu trop grand"],
  ["Unsupported Media Type", "Type de contenu non pris en charge"],
  ["Unprocessable Content", "Contenu non traitable"],
  ["Unprocessable Entity", "Contenu non traitable"],
  ["Precondition Required", "Condition préalable requise"],
  ["Too Many Requests", "Trop de requêtes"],
  ["Internal Server Error", "Erreur interne du serveur"],
  ["Service Unavailable", "Service indisponible"],
  ["Check the fields.", "Vérifiez les champs."],
  ["Check the query.", "Vérifiez la requête."],
  ["Check the form.", "Vérifiez le formulaire."],
  ["The body is not JSON.", "Le corps n’est pas du JSON."],
  ["The body is JSON: send it with Content-Type: application/json.", "Le corps est du JSON : envoyez-le avec Content-Type: application/json."],
  ["Sign in first.", "Connectez-vous d’abord."],
  ["This is for the role {Role}.", "Ceci est réservé au rôle {Role}."],
  ["There is no such address.", "Cette adresse n’existe pas."],
  ["There is no such thing.", "Cette chose n’existe pas."],
  ["This request comes from another site than the app's.", "Cette requête vient d’un autre site que celui de l’application."],
  ["Too many requests: wait {Seconds} seconds.", {one: "Trop de requêtes : attendez {Seconds} seconde.", other: "Trop de requêtes : attendez {Seconds} secondes."}],
  ["Too many attempts: wait {Seconds} seconds.", {one: "Trop d’essais : attendez {Seconds} seconde.", other: "Trop d’essais : attendez {Seconds} secondes."}],
  ["Too many failed sign-ins: wait {Seconds} seconds.", {one: "Trop de connexions échouées : attendez {Seconds} seconde.", other: "Trop de connexions échouées : attendez {Seconds} secondes."}],
  ["Too many sign-ins at once: try again in a moment.", "Trop de connexions en même temps : réessayez dans un instant."],
  ["Too many files are coming at once: send it again in a moment.", "Trop de fichiers arrivent en même temps : renvoyez-le dans un instant."],
  ["This cursor is not one of this list: ask the first page again.", "Ce curseur n’est pas celui de cette liste : redemandez la première page."],
  ["This changed meanwhile: read it again, then try again.", "Ceci a changé entre-temps : relisez-le, puis réessayez."],
  ["This value is taken already.", "Cette valeur est déjà prise."],
  ["This is not yours to read or change.", "Ce n’est pas à vous de le lire ou de le changer."],
  ["The database can't be reached: try again in a moment.", "La base de données est injoignable : réessayez dans un instant."],
  ["This took too long: try again.", "Cela a pris trop de temps : réessayez."],
  ["Busy: try again in a moment.", "Occupé : réessayez dans un instant."],
  ["Something went wrong on our side.", "Une erreur s’est produite de notre côté."],
  ["Something went wrong on our side. Request {Id}.", "Une erreur s’est produite de notre côté. Requête {Id}."],
  ["This file is larger than {Most} bytes.", "Ce fichier dépasse {Most} octets."],
  ["The file was cut short.", "Le fichier a été coupé."],
  ["This changed meanwhile: see its values now.", "Cela a changé entre-temps : voyez ses valeurs maintenant."],
  ["A Centauri-Base is a JSON object of the fields seen, 8 KiB at most.", "Un Centauri-Base est un objet JSON des champs vus, de 8 Kio au plus."],
  ["Check the fields seen.", "Vérifiez les champs vus."],
  ["No field of this kind.", "Aucun champ de ce genre."],
  ["Upload-Offset and Upload-Length are numbers of bytes.", "Upload-Offset et Upload-Length sont des nombres d’octets."],
  ["This body is {Size} bytes: from Upload-Offset {Offset}, Upload-Length {Length} needs {Need}.", "Ce corps fait {Size} octets : depuis Upload-Offset {Offset}, Upload-Length {Length} en demande {Need}."],
  ["The server holds {Held} bytes of this upload: go on from there.", "Le serveur a {Held} octets de cet envoi : reprenez à partir de là."],
  ["This upload began as {Length} bytes of {Type}: go on with the same, or begin another with a new key.", "Cet envoi a commencé comme {Length} octets de {Type} : continuez avec les mêmes, ou commencez-en un autre avec une nouvelle clé."],
  ["An upload that goes on from an Upload-Offset needs its Idempotency-Key.", "Un envoi qui reprend à un Upload-Offset a besoin de son Idempotency-Key."],
  ["HEAD of an upload asks with the Idempotency-Key of the upload.", "Le HEAD d’un envoi se demande avec l’Idempotency-Key de l’envoi."],
  ["The file was cut short: the server holds {Held} of its {Size} bytes, send the rest from there.", "Le fichier a été coupé : le serveur a {Held} de ses {Size} octets, envoyez le reste à partir de là."],
  ["This e-mail and password don't match.", "Cette adresse e-mail et ce mot de passe ne correspondent pas."],
  ["This e-mail has an account already: sign in.", "Cette adresse e-mail a déjà un compte : connectez-vous."],
  ["A password of {Min} to 128 bytes.", "Un mot de passe de {Min} à 128 octets."],
  ["Signing up is closed: ask an administrator.", "Les inscriptions sont fermées : demandez à un administrateur."],
  ["Signing up is by invitation only: use the link of yours.", "L’inscription se fait seulement sur invitation : utilisez le lien de la vôtre."],
  ["Someone signed up at the same moment: send again.", "Quelqu’un s’est inscrit au même moment : renvoyez."],
  ["The tenant is being made: try again.", "L’espace est en cours de création : réessayez."],
  ["This invitation is not yours, or it has ended.", "Cette invitation n’est pas la vôtre, ou elle a expiré."],
  ["You are no member of this tenant.", "Vous n’êtes pas membre de cet espace."],
  ["Check your e-mail address first: open the link of the mail we sent you.", "Vérifiez d’abord votre adresse e-mail : ouvrez le lien du message que nous vous avons envoyé."],
  ["This link is not valid, or it has ended: ask for a new one.", "Ce lien n’est pas valide, ou il a expiré : demandez-en un nouveau."],
  ["The old password is not this one.", "L’ancien mot de passe n’est pas celui-ci."],
  ["Answer this challenge first, then send again with Proof.", "Répondez d’abord à ce défi, puis renvoyez avec Proof."],
  ["Only who has the role {Role} gives it or takes it.", "Seul qui a le rôle {Role} le donne ou le retire."],
  ["A tenant keeps one owner at least.", "Un espace garde au moins un propriétaire."],
  ["A tenant keeps one owner at least: give the role owner to another member first.", "Un espace garde au moins un propriétaire : donnez d’abord le rôle owner à un autre membre."],
  ["{Role} is no role of this app.", "{Role} n’est pas un rôle de cette application."],
  ["You may not disable yourself.", "Vous ne pouvez pas vous désactiver vous-même."],
  ["You may not take the role super from yourself.", "Vous ne pouvez pas vous retirer le rôle super."],
  ["Check your e-mail address for {App}", "Vérifiez votre adresse e-mail pour {App}"],
  ["Hello {Name},\n\nTo check that this address is yours, open this link within {Hours} hours:\n\n{Link}\n\nIf you didn't sign up for {App}, ignore this mail.\n", {
    one: "Bonjour {Name},\n\nPour vérifier que cette adresse est la vôtre, ouvrez ce lien dans l’heure :\n\n{Link}\n\nSi vous ne vous êtes pas inscrit à {App}, ignorez ce message.\n",
    other: "Bonjour {Name},\n\nPour vérifier que cette adresse est la vôtre, ouvrez ce lien dans les {Hours} heures :\n\n{Link}\n\nSi vous ne vous êtes pas inscrit à {App}, ignorez ce message.\n", By: "Hours"}],
  ["A new password for {App}", "Un nouveau mot de passe pour {App}"],
  ["Hello {Name},\n\nTo set a new password, open this link within {Hours} hours:\n\n{Link}\n\nIf you didn't ask for it, ignore this mail: your password stays as it is.\n", {
    one: "Bonjour {Name},\n\nPour choisir un nouveau mot de passe, ouvrez ce lien dans l’heure :\n\n{Link}\n\nSi vous ne l’avez pas demandé, ignorez ce message : votre mot de passe reste le même.\n",
    other: "Bonjour {Name},\n\nPour choisir un nouveau mot de passe, ouvrez ce lien dans les {Hours} heures :\n\n{Link}\n\nSi vous ne l’avez pas demandé, ignorez ce message : votre mot de passe reste le même.\n", By: "Hours"}],
  ["Someone tried to sign up with your address at {App}", "Quelqu’un a essayé de s’inscrire à {App} avec votre adresse"],
  ["Hello {Name},\n\nSomeone tried to sign up for {App} with this address, which has an account already. If it was you, sign in, or set a new password here:\n\n{Link}\n\nIf it wasn't you, ignore this mail: nothing changed.\n", "Bonjour {Name},\n\nQuelqu’un a essayé de s’inscrire à {App} avec cette adresse, qui a déjà un compte. Si c’était vous, connectez-vous, ou choisissez un nouveau mot de passe ici :\n\n{Link}\n\nSi ce n’était pas vous, ignorez ce message : rien n’a changé.\n"],
  ["This passkey's answer is not valid: bytes after its public key.", "La réponse de cette passkey n’est pas valide : des octets après sa clé publique."],
  ["This passkey's answer is not valid: it comes from another site than the app's.", "La réponse de cette passkey n’est pas valide : elle vient d’un autre site que celui de l’application."],
  ["This passkey's answer is not valid: it holds no credential.", "La réponse de cette passkey n’est pas valide : elle ne contient aucun identifiant."],
  ["This passkey's answer is not valid: it is for another site.", "La réponse de cette passkey n’est pas valide : elle est pour un autre site."],
  ["This passkey's answer is not valid: its attestation object.", "La réponse de cette passkey n’est pas valide : son objet d’attestation."],
  ["This passkey's answer is not valid: its attested credential data is too short.", "La réponse de cette passkey n’est pas valide : ses données d’identifiant attesté sont trop courtes."],
  ["This passkey's answer is not valid: its authenticator data is too short.", "La réponse de cette passkey n’est pas valide : ses données d’authentificateur sont trop courtes."],
  ["This passkey's answer is not valid: its challenge is not this ceremony's.", "La réponse de cette passkey n’est pas valide : son défi n’est pas celui de cette cérémonie."],
  ["This passkey's answer is not valid: its client data is no JSON.", "La réponse de cette passkey n’est pas valide : ses données de client ne sont pas du JSON."],
  ["This passkey's answer is not valid: its client data is of another ceremony.", "La réponse de cette passkey n’est pas valide : ses données de client sont d’une autre cérémonie."],
  ["This passkey's answer is not valid: its credential is no JSON of a public key.", "La réponse de cette passkey n’est pas valide : son identifiant n’est pas le JSON d’une clé publique."],
  ["This passkey's answer is not valid: its device didn't verify its user, which this app asks.", "La réponse de cette passkey n’est pas valide : son appareil n’a pas vérifié son utilisateur, ce que cette application demande."],
  ["This passkey's answer is not valid: its EC key.", "La réponse de cette passkey n’est pas valide : sa clé EC."],
  ["This passkey's answer is not valid: its flag of backup changed.", "La réponse de cette passkey n’est pas valide : son indicateur de sauvegarde a changé."],
  ["This passkey's answer is not valid: its id is not its credential's.", "La réponse de cette passkey n’est pas valide : son id n’est pas celui de son identifiant."],
  ["This passkey's answer is not valid: its key is of no algorithm this app takes (ES256, EdDSA, RS256, PS256).", "La réponse de cette passkey n’est pas valide : sa clé n’est d’aucun algorithme que cette application accepte (ES256, EdDSA, RS256, PS256)."],
  ["This passkey's answer is not valid: its public key is no COSE key.", "La réponse de cette passkey n’est pas valide : sa clé publique n’est pas une clé COSE."],
  ["This passkey's answer is not valid: its RSA key.", "La réponse de cette passkey n’est pas valide : sa clé RSA."],
  ["This passkey's answer is not valid: its user is not this passkey's.", "La réponse de cette passkey n’est pas valide : son utilisateur n’est pas celui de cette passkey."],
  ["This passkey's answer is not valid: it was made in a frame of another site.", "La réponse de cette passkey n’est pas valide : elle a été faite dans un cadre d’un autre site."],
  ["This passkey's answer is not valid: nobody was present.", "La réponse de cette passkey n’est pas valide : personne n’était présent."],
  ["This passkey's answer is not valid: the length of its credential's id.", "La réponse de cette passkey n’est pas valide : la longueur de l’id de son identifiant."],
  ["The provider's token is not valid: its issuer.", "Le jeton du fournisseur n’est pas valide : son émetteur."],
  ["The provider's token is not valid: it is for another app.", "Le jeton du fournisseur n’est pas valide : il est pour une autre application."],
  ["The provider's token is not valid: its nonce is not this sign-in's.", "Le jeton du fournisseur n’est pas valide : son nonce n’est pas celui de cette connexion."],
  ["The provider's token is not valid: its subject.", "Le jeton du fournisseur n’est pas valide : son sujet."],
  ["The provider's token is not valid: its time.", "Le jeton du fournisseur n’est pas valide : son heure."],
  ["The provider's token is not valid: The token's algorithm is none of those this app takes.", "Le jeton du fournisseur n’est pas valide : L’algorithme du jeton n’est aucun de ceux que cette application accepte."],
  ["The provider's token is not valid: The token's signature is wrong.", "Le jeton du fournisseur n’est pas valide : La signature du jeton est fausse."],
  ["The provider's token is not valid: No key of the provider is the token's.", "Le jeton du fournisseur n’est pas valide : Aucune clé du fournisseur n’est celle du jeton."],
  ["The provider's token is not valid: This is no token of three parts.", "Le jeton du fournisseur n’est pas valide : Ce n’est pas un jeton en trois parties."],
  ["A key of a program calls the app's endpoints, not those of the accounts.", "Une clé de programme appelle les points d’accès de l’application, pas ceux des comptes."],
  ["{Title} doesn't say that this address is yours: sign up another way.", "{Title} ne dit pas que cette adresse est la vôtre : inscrivez-vous autrement."],
  ["An account has this address: sign in to it, then link {Title} from your account.", "Un compte a cette adresse : connectez-vous-y, puis liez {Title} depuis votre compte."],
  ["Begin first: POST /auth/totp gives the secret.", "Commencez d’abord : POST /auth/totp donne le secret."],
  ["GitHub didn't give the user.", "GitHub n’a pas donné l’utilisateur."],
  ["Passkeys are off in this app.", "Les passkeys sont désactivées dans cette application."],
  ["Set up a second factor first: your app's code is asked from now on.", "Configurez d’abord un second facteur : le code de votre application est demandé désormais."],
  ["A second factor is needed: send the code of your app.", "Un second facteur est nécessaire : envoyez le code de votre application."],
  ["Signing in with a password is off: use a passkey or a provider.", "La connexion par mot de passe est désactivée : utilisez une passkey ou un fournisseur."],
  ["Signing up with a password is off: use a passkey or a provider.", "L’inscription par mot de passe est désactivée : utilisez une passkey ou un fournisseur."],
  ["Signing up with {Title} is off: sign up another way.", "L’inscription avec {Title} est désactivée : inscrivez-vous autrement."],
  ["The provider can't be reached: try again in a moment.", "Le fournisseur est injoignable : réessayez dans un instant."],
  ["The provider gave no ID token.", "Le fournisseur n’a donné aucun jeton d’identité."],
  ["The provider refused the code: sign in again.", "Le fournisseur a refusé le code : connectez-vous à nouveau."],
  ["The provider refused.", "Le fournisseur a refusé."],
  ["The provider refused: {Error}.", "Le fournisseur a refusé : {Error}."],
  ["The provider's answer names another issuer.", "La réponse du fournisseur nomme un autre émetteur."],
  ["The provider's discovery document can't be read: try again in a moment.", "Le document de découverte du fournisseur ne peut pas être lu : réessayez dans un instant."],
  ["The provider's discovery document names another issuer.", "Le document de découverte du fournisseur nomme un autre émetteur."],
  ["The provider's keys can't be read: try again in a moment.", "Les clés du fournisseur ne peuvent pas être lues : réessayez dans un instant."],
  ["There is no such flag.", "Ce drapeau n’existe pas."],
  ["There is no such provider in this app.", "Ce fournisseur n’existe pas dans cette application."],
  ["This account may not sign in.", "Ce compte ne peut pas se connecter."],
  ["This account of {Title} is linked to another user.", "Ce compte {Title} est lié à un autre utilisateur."],
  ["This ceremony has ended: ask its options again.", "Cette cérémonie a expiré : redemandez ses options."],
  ["This code is not the right one.", "Ce code n’est pas le bon."],
  ["This is your last way to sign in: add another first.", "C’est votre dernier moyen de vous connecter : ajoutez-en un autre d’abord."],
  ["This passkey is kept already.", "Cette passkey est déjà enregistrée."],
  ["This passkey is not known here.", "Cette passkey est inconnue ici."],
  ["This passkey's counter went back: it may be a copy. Use another way to sign in.", "Le compteur de cette passkey a reculé : c’est peut-être une copie. Connectez-vous autrement."],
  ["This passkey's signature is wrong.", "La signature de cette passkey est fausse."],
  ["This passkey was used at the same moment: sign in again.", "Cette passkey a servi au même moment : connectez-vous à nouveau."],
  ["This sign-in has ended: sign in again.", "Cette connexion a expiré : connectez-vous à nouveau."],
  ["This sign-in was not started in this browser, or it has ended: start it again.", "Cette connexion n’a pas commencé dans ce navigateur, ou elle a expiré : recommencez-la."],
  ["Turn two-factor on first.", "Activez d’abord la double authentification."],
  ["Two-factor is asked of you by this app: it stays on.", "Cette application vous demande la double authentification : elle reste activée."],
  ["Two-factor is off in this app.", "La double authentification est désactivée dans cette application."],
  ["Two-factor is on already: turn it off first, with a code.", "La double authentification est déjà activée : désactivez-la d’abord, avec un code."],
  ["You are invited to {Tenant} on {App}", "Vous êtes invité à {Tenant} sur {App}"],
  ["Hello,\n\n{By} invites you to {Tenant} on {App}. To accept, open this link within {Days} days:\n\n{Link}\n\nIf you don't know {App}, ignore this mail.\n", {one: "Bonjour,\n\n{By} vous invite à {Tenant} sur {App}. Pour accepter, ouvrez ce lien dans la journée :\n\n{Link}\n\nSi vous ne connaissez pas {App}, ignorez ce message.\n", other: "Bonjour,\n\n{By} vous invite à {Tenant} sur {App}. Pour accepter, ouvrez ce lien dans les {Days} jours :\n\n{Link}\n\nSi vous ne connaissez pas {App}, ignorez ce message.\n", By: "Days"}],
])
