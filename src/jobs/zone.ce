(* Time zones, for the schedules: the offset from UTC of a zone at an instant, and the instant of a time on its clock.
   A zone is read from the system's database of zones (tzdata, /usr/share/zoneinfo, in the format TZif of RFC 9636):
   its changes of offset as they were and as its law says they will be, the rule at its end (a TZ string of POSIX)
   giving those past the last one written, up to 2100. UTC needs no file. *)
use std/date
use std/dict
use std/list
use std/math
use std/result
use std/sys
use std/text
use std/value

(** The folder of the zones of the system, as Debian, Arch, Fedora and Alpine (with its package tzdata) put them. *)
ZoneFolder = "/usr/share/zoneinfo"

(** The zone UTC: no change of offset, ever.

      Offset(1794528000, Utc) --> 0 *)
Utc = {Name: "UTC", First: 0, At: [], Off: []}

defn zoneName(name)
  (** Is this the name of a zone, as Europe/Paris: letters, digits, _, -, + and /, no part that leaves the folder. *)
  if not value.IsText(name) or text.ByteLength(name) == 0 or text.ByteLength(name) > 64 or text.StartsWith("/", name)
    return false
  end
  if not value.IsMissing(text.ByteFindAny("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-+/", 1, name, not = true))
    return false
  end
  not (".." in text.Split("/", name)) and not ("" in text.Split("/", name))
end

defn Zone(name, folder = ZoneFolder)
  (** The zone of a name, as Europe/Paris or America/New_York, read from the system's zones: an Ok of it, or an Err
      that says what is missing. UTC (and Etc/UTC) needs no file. It needs the permission to read the folder,
      read=/usr/share/zoneinfo. *)
  if name == "UTC" or name == "Etc/UTC" or name == "Z"
    return result.Ok(Utc)
  end
  if not zoneName(name)
    return result.Err({Kind: "zone", Message: "$name is no name of a time zone, as Europe/Paris."})
  end
  bytes = sys.Read("$folder/$name")
  if result.IsErr(bytes)
    return result.Err({Kind: "zone", Message: "The time zone $name can't be read in $folder: is tzdata installed?"})
  end
  parsed = tzif(bytes.Value)
  if result.IsErr(parsed)
    return result.Err({Kind: "zone", Message: "The time zone $name: $(parsed.Error)"})
  end
  z = parsed.Value
  z.Name = name
  result.Ok(z)
end

defn be(bytes, at, n)
  (** The unsigned number of n bytes, big-endian, from position at (from 1). *)
  v = 0
  for k in 0..(n - 1)
    v = v * 256 + bytes[at + k]
  end
  v
end

signed32(v) = if v >= 2147483648 v - 4294967296 else v end   (* A 32-bit unsigned number read as two's complement. *)
signed8(v) = if v >= 128 v - 256 else v end   (* A byte read as two's complement. *)

defn time64(bytes, at)
  (** A signed 64-bit time, big-endian: its high half signed, as every time of a zone fits. *)
  signed32(be(bytes, at, 4)) * 4294967296 + be(bytes, at + 4, 4)
end

defn tzif(raw)
  (** The changes of a file of TZif, version 2 or later: an Ok of {First, At, Off}, First the offset before the first
      change, At the instants of the changes, Off the offset after each, or an Err. The data of version 1 is skipped
      for the 64-bit data that follows it; the TZ string at the end gives the changes past the last one written. *)
  b = text.Bytes(raw)
  n = value.Len(b)
  if n < 44 or text.ByteSlice(1, 4, raw) != "TZif" or b[5] < 50
    return result.Err("no file of TZif version 2 or later")
  end
  counts1 = [be(b, 21 + 4 * k, 4) for k in 0..5]
  skip = 44 + counts1[4] * 5 + counts1[5] * 6 + counts1[6] + counts1[3] * 8 + counts1[2] + counts1[1]
  h = skip + 1
  if n < h + 43 or text.ByteSlice(h, h + 3, raw) != "TZif"
    return result.Err("its second header is missing")
  end
  c = [be(b, h + 20 + 4 * k, 4) for k in 0..5]
  isut = c[1]
  isstd = c[2]
  leap = c[3]
  times = c[4]
  types = c[5]
  chars = c[6]
  at = h + 44
  if n < at + times * 9 + types * 6 + chars + leap * 12 + isstd + isut
    return result.Err("it is cut short")
  end
  instants = [time64(b, at + 8 * k) for k in 0..(times - 1)]
  idx = [b[at + times * 8 + k] for k in 0..(times - 1)]
  tt = at + times * 9
  offs = [signed32(be(b, tt + 6 * k, 4)) for k in 0..(types - 1)]
  if types == 0
    return result.Err("it has no type of time")
  end
  rest = at + times * 9 + types * 6 + chars + leap * 12 + isstd + isut
  footer = if rest <= n text.ByteSlice(rest, n, raw) else "" end
  rule = text.Trim(text.Replace("\n", " ", footer))
  z = {First: offs[1], At: instants, Off: [offs[i + 1] for i in idx]}
  if rule == ""
    return result.Ok(z)
  end
  posix = Posix(rule)
  if result.IsErr(posix)
    return posix
  end
  result.Ok(extended(z, posix.Value))
end

defn extended(z, p)
  (** A zone with the changes its rule gives after its last one written, up to 2100. A rule without summer time
      changes nothing. *)
  if value.IsMissing(p.Dst)
    if value.Len(z.At) == 0
      return {First: p.Std, At: [], Off: []}
    end
    return z
  end
  last = if value.Len(z.At) == 0 (-2208988800) else z.At[value.Len(z.At)] end
  from = list.Max([1970, civilYear(last)])
  at = z.At
  off = z.Off
  for y in from..2100
    pairs = [{At: ruleInstant(p.Start, y, p.Std), Off: p.Dst}, {At: ruleInstant(p.End, y, p.Dst), Off: p.Std}]
    if pairs[2].At < pairs[1].At
      pairs = [pairs[2], pairs[1]]
    end
    for q in pairs
      if q.At > last
        at = list.Append(q.At, at)
        off = list.Append(q.Off, off)
      end
    end
  end
  {First: if value.Len(z.At) == 0 p.Std else z.First end, At: at, Off: off}
end

defn civilYear(t)
  (** The year in UTC of an instant. *)
  days = math.Div(math.Floor(t), 86400)
  civil(days).Year
end

daysFrom(y, m, d) = math.Div(date.ToUnix(date.Date(y, m, d)), 86400)   (* The days since 1970-01-01 of a date. *)
civil(z) = date.FromUnix(z * 86400)   (* The date of a count of days since 1970-01-01: its Year, Month and Day. *)

leap(y) = math.Mod(y, 4) == 0 and (math.Mod(y, 100) != 0 or math.Mod(y, 400) == 0)   (* A year of 366 days. *)
weekday(days) = math.Mod(days + 4, 7)   (* The day of the week of a count of days since 1970: 0 for Sunday. *)

defn monthDays(y, m)
  (** The days of a month of a year. *)
  if m == 2
    return if leap(y) 29 else 28 end
  end
  if m in [4, 6, 9, 11] 30 else 31 end
end

defn ruleInstant(r, y, off)
  (** The instant of a date of a rule of POSIX in year y, its time read on a clock off seconds ahead of UTC. *)
  days = 0
  if r.Kind == "M"
    first = daysFrom(y, r.Month, 1)
    d = first + math.Mod(r.Day - weekday(first) + 7, 7) + 7 * (r.Week - 1)
    while d - first >= monthDays(y, r.Month)
      d -= 7
    end
    days = d
  else if r.Kind == "J"
    n = r.Day
    days = daysFrom(y, 1, 1) + n - 1 + (if leap(y) and n >= 60 1 else 0 end)
  else
    days = daysFrom(y, 1, 1) + r.Day
  end
  days * 86400 + r.Time - off
end

defn Posix(s)
  (** The rule of a TZ string of POSIX, as a file of TZif ends with: an Ok of {Std, Dst, Start, End}, the offsets in
      seconds ahead of UTC (Dst missing without summer time), the dates when summer time starts and ends, or an Err.

        Posix("CET-1CEST,M3.5.0,M10.5.0/3").Value.Std --> 3600
        Posix("JST-9").Value.Std --> 32400
        Posix("<+0330>-3:30").Value.Std --> 12600 *)
  p = nameEnd(s, 1)?
  o = clockOf(s, p)?
  std = 0 - o.Value
  at = o.At
  if at > text.ByteLength(s)
    return result.Ok({Std: std, Dst: missing, Start: missing, End: missing})
  end
  p = nameEnd(s, at)?
  at = p
  dst = std + 3600
  if at <= text.ByteLength(s) and text.ByteSlice(at, at, s) != ","
    o = clockOf(s, at)?
    dst = 0 - o.Value
    at = o.At
  end
  if at > text.ByteLength(s) or text.ByteSlice(at, at, s) != ","
    return result.Err("the TZ string $s has summer time without its dates")
  end
  a = ruleDate(s, at + 1)?
  if a.At > text.ByteLength(s) or text.ByteSlice(a.At, a.At, s) != ","
    return result.Err("the TZ string $s has summer time without its end")
  end
  e = ruleDate(s, a.At + 1)?
  result.Ok({Std: std, Dst: dst, Start: a.Rule, End: e.Rule})
end

defn nameEnd(s, at)
  (** The position after the name of a zone at position at: <...> or three letters or more. *)
  n = text.ByteLength(s)
  if at <= n and text.ByteSlice(at, at, s) == "<"
    close = text.ByteFind(">", at, s)
    return if value.IsMissing(close) result.Err("the TZ string $s has a < without its >") else result.Ok(close + 1) end
  end
  k = at
  while k <= n and not value.IsMissing(text.ByteFind(text.ByteSlice(k, k, s), 1, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"))
    k += 1
  end
  if k - at < 3 result.Err("the TZ string $s has no name of 3 letters at $at") else result.Ok(k) end
end

defn clockOf(s, at)
  (** A time [+-]hh[:mm[:ss]] at position at: an Ok of {Value, At}, Value in seconds, At the position after it. *)
  n = text.ByteLength(s)
  sign = 1
  k = at
  if k <= n and text.ByteSlice(k, k, s) in ["+", "-"]
    sign = if text.ByteSlice(k, k, s) == "-" (-1) else 1 end
    k += 1
  end
  parts = []
  for round in 1..3
    start = k
    while k <= n and not value.IsMissing(text.ByteFind(text.ByteSlice(k, k, s), 1, "0123456789"))
      k += 1
    end
    if k == start
      return result.Err("the TZ string $s has no number at $start")
    end
    parts = list.Append(text.Number(text.ByteSlice(start, k - 1, s)), parts)
    if k <= n and text.ByteSlice(k, k, s) == ":" and round < 3
      k += 1
    else
      break
    end
  end
  secs = parts[1] * 3600 + (if value.Len(parts) > 1 parts[2] * 60 else 0 end) + (if value.Len(parts) > 2 parts[3] else 0 end)
  result.Ok({Value: sign * secs, At: k})
end

defn ruleDate(s, at)
  (** A date of a rule at position at, Mm.w.d, Jn or n, and its time after a /, 02:00 when it has none: an Ok of {Rule, At}. *)
  n = text.ByteLength(s)
  rule = missing
  k = at
  if k <= n and text.ByteSlice(k, k, s) == "M"
    stop = k + 1
    while stop <= n and not value.IsMissing(text.ByteFind(text.ByteSlice(stop, stop, s), 1, "0123456789."))
      stop += 1
    end
    f = [text.Number(x) for x in text.Split(".", text.ByteSlice(k + 1, stop - 1, s))]
    if value.Len(f) != 3 or not list.All([value.IsInt(x) for x in f]) or f[1] < 1 or f[1] > 12 or f[2] < 1 or f[2] > 5 or f[3] < 0 or f[3] > 6
      return result.Err("the TZ string $s has a wrong date at $k")
    end
    rule = {Kind: "M", Month: f[1], Week: f[2], Day: f[3]}
    k = stop
  else
    julian = k <= n and text.ByteSlice(k, k, s) == "J"
    start = if julian k + 1 else k end
    stop = start
    while stop <= n and not value.IsMissing(text.ByteFind(text.ByteSlice(stop, stop, s), 1, "0123456789"))
      stop += 1
    end
    if stop == start
      return result.Err("the TZ string $s has no date at $k")
    end
    rule = {Kind: if julian "J" else "n" end, Day: text.Number(text.ByteSlice(start, stop - 1, s))}
    k = stop
  end
  rule.Time = 7200
  if k <= n and text.ByteSlice(k, k, s) == "/"
    t = clockOf(s, k + 1)?
    rule.Time = t.Value
    k = t.At
  end
  result.Ok({Rule: rule, At: k})
end

defn Offset(t, z)
  (** The seconds a zone's clock is ahead of UTC at an instant t, in seconds since 1970.

        Offset(1794528000, Utc) --> 0 *)
  n = value.Len(z.At)
  if n == 0 or t < z.At[1]
    return z.First
  end
  lo = 1
  hi = n
  while lo < hi
    mid = math.Div(lo + hi + 1, 2)
    if z.At[mid] <= t
      lo = mid
    else
      hi = mid - 1
    end
  end
  z.Off[lo]
end

defn changeAfter(t, z)
  (** The first change of offset after instant t, or missing. *)
  for at in z.At
    if at > t
      return at
    end
  end
  missing
end

defn Instant(wall, z)
  (** The instant of a time on a zone's clock, wall given in seconds since 1970 as if that clock were UTC. A time that
      the clock skips (the hour lost when summer time starts) is the instant of the change, the first minute that
      exists after it; a time the clock shows twice (the hour given back) is its first one.

        Instant(1794528000, Utc) --> 1794528000 *)
  before = Offset(wall - 86400, z)
  after = Offset(wall + 86400, z)
  t1 = wall - before
  t2 = wall - after
  ok1 = Offset(t1, z) == before
  ok2 = Offset(t2, z) == after
  if ok1 and ok2
    return list.Min([t1, t2])
  end
  if ok1
    return t1
  end
  if ok2
    return t2
  end
  change = changeAfter(list.Min([t1, t2]), z)
  if value.IsMissing(change) t1 else change end
end
