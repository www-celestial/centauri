(** Accounts: signing up and in with a password (Argon2id), sessions in a cookie (a token cut in two), tenants (one app
    of many tenants, or one tenant for all, by the setting Tenancy), sign-up open, by invitation or closed (SignUp),
    roles of the members of a tenant, the administration of users and tenants, and the defenses against bots and
    password guessing: limits per address and per login, a delay that doubles after LockAfter failures, proof of work
    under attack, a trap field for bots, a hash that takes as long for a login that doesn't exist. An app puts
    Module() first in its list: app.Of([auth.Module(), invoices.Module]).

    Module(facts = f) adds the app's facts to the group that makes the account: f(user, tenant, x) gives operations
    of cepheus.Write, with user and tenant new things of the group or ids, and x the fields of the sign-up, as its
    endpoint read them (api.SignUpOf adds fields of the app's own). *)
use deps/www-celestial/cepheus/cesia/cepheus
use src/api
use src/app
use src/jobs
use src/mail
use std/check
use std/crypto
use std/dict
use std/encode
use std/io
use std/json
use std/list
use std/log
use std/math
use std/result
use std/sys
use std/text
use std/value

(** The settings of the accounts, each from its variable APP_..., each with Centauri's default, which the app's
    defaults change and the environment overrides. *)
Settings = {
  Tenancy: check.OneOf(["multi", "single"], optional = true, default = "multi"),
  SignUp: check.OneOf(["open", "invite", "closed"], optional = true, default = "open"),
  OwnerRoles: check.Text(1, 400, optional = true, default = "owner"),
  MemberRoles: check.Text(1, 400, optional = true, default = "member"),
  PasswordMin: check.Int(12, 128, optional = true, default = 12),
  SessionIdle: check.Int(60, 31536000, optional = true, default = 28800),
  SessionMax: check.Int(60, 31536000, optional = true, default = 2592000),
  LockAfter: check.Int(1, 1000, optional = true, default = 5),
  LockMost: check.Int(1, 86400, optional = true, default = 900),
  SignInPerIp: check.Int(1, 100000, optional = true, default = 20),
  SignUpPerIp: check.Int(1, 100000, optional = true, default = 10),
  TenantsPerHour: check.Int(1, 1000000, optional = true, default = 100),
  Pow: check.OneOf(["off", "attack", "always"], optional = true, default = "attack"),
  PowBits: check.Int(1, 30, optional = true, default = 18),
  PowAfter: check.Int(1, 1000000, optional = true, default = 50),
  HashSlots: check.Int(1, 64, optional = true, default = 2),
  SessionCache: check.Int(0, 60, optional = true, default = 2),
  Honeypot: check.Text(0, 40, optional = true, default = "Website"),
  InviteTime: check.Int(60, 31536000, optional = true, default = 604800),
  EmailCheck: check.OneOf(["off", "required", "later"], optional = true, default = "off"),
  SignUpAnswer: check.OneOf(["tell", "neutral"], optional = true, default = "tell"),
  CheckTime: check.Int(300, 31536000, optional = true, default = 172800),
  ResetTime: check.Int(300, 86400, optional = true, default = 3600),
  CheckPage: check.Text(1, 200, optional = true, default = "/check-email"),
  ResetPage: check.Text(1, 200, optional = true, default = "/reset-password"),
  MailsPerHour: check.Int(1, 1000, optional = true, default = 5),
}

(** The mails of the accounts, as an app may write them in its own words: each a function of {Link, Name, Email, App,
    Hours} that gives {Subject, Text}, and Html if it has one. Check is the link that checks an address, Reset the
    one that sets a new password, Taken the mail to the owner of an address that someone tried to sign up with again,
    when the sign-up answers the same for every address (SignUpAnswer neutral). *)
Mails = {
  Check: x -> {Subject: "Check your e-mail address for $(x.App)", Text: "Hello $(x.Name),\n\nTo check that this address is yours, open this link within $(x.Hours) hours:\n\n$(x.Link)\n\nIf you didn't sign up for $(x.App), ignore this mail.\n"},
  Reset: x -> {Subject: "A new password for $(x.App)", Text: "Hello $(x.Name),\n\nTo set a new password, open this link within $(x.Hours) hours:\n\n$(x.Link)\n\nIf you didn't ask for it, ignore this mail: your password stays as it is.\n"},
  Taken: x -> {Subject: "Someone tried to sign up with your address at $(x.App)", Text: "Hello $(x.Name),\n\nSomeone tried to sign up for $(x.App) with this address, which has an account already. If it was you, sign in, or set a new password here:\n\n$(x.Link)\n\nIf it wasn't you, ignore this mail: nothing changed.\n"},
}

defn Module(signUp = api.SignUp, facts = missing, mails = Mails)
  (** The module of the accounts: its kinds, its endpoints (api.Accounts and api.AdminOfAccounts), the session of
      each request (Who, kept SessionCache seconds by the state of the process under SessionKey), its settings, and a
      keeper that forgets ended sessions, challenges, invitations and codes. signUp is api.SignUp or one of
      api.SignUpOf; mails the texts of its mails (Mails, or the app's own, as dict.Put("Check", f, auth.Mails)),
      sent by the jobs of the module of jobs, which the app lists with this one. *)
  m = dict.Merge(Mails, mails)
  checking = jobs.Kind("centauri.check", check.Record({User: check.Id(optional = true), Email: check.Email(optional = true)}), (job, env) -> checkJob(job, env, m.Check), tries = 10, lease = 120)
  resetting = jobs.Kind("centauri.reset", check.Record({Email: check.Email()}), (job, env) -> resetJob(job, env, m.Reset), tries = 10, lease = 120)
  taken = jobs.Kind("centauri.taken", check.Record({Email: check.Email()}), (job, env) -> takenJob(job, env, m.Taken), tries = 10, lease = 120)
  kinds = {Check: checking, Reset: resetting, Taken: taken}
  serve = [app.Serve(signUp, (r, x) -> signingUp(r, x, facts, kinds)), app.Serve(api.SignIn, (r, x) -> signingIn(r, x, kinds)), app.Serve(api.SignOut, signingOut),
    app.Serve(api.SignOutAll, signingOutAll), app.Serve(api.Me, me), app.Serve(api.Sessions, sessions), app.Serve(api.EndSession, endSession),
    app.Serve(api.ChangePassword, changePassword), app.Serve(api.Challenge, challenge), app.Serve(api.Members, members),
    app.Serve(api.Invite, invite), app.Serve(api.Join, joining), app.Serve(api.SetRoles, setRoles), app.Serve(api.RemoveMember, removeMember),
    app.Serve(api.MyTenants, myTenants), app.Serve(api.SwitchTenant, switchTenant), app.Serve(api.CheckEmail, checkEmail),
    app.Serve(api.SendCheck, (r, x) -> sendCheck(r, x, kinds)), app.Serve(api.Forgot, (r, x) -> forgot(r, x, kinds)), app.Serve(api.Reset, resetPassword)]
  made = app.Module("auth", kinds = Kinds, serve = list.Concat(serve, adminOfAccounts()), who = Who, key = SessionKey, ends = Ends,
    settings = dict.Merge(Settings, mail.Settings), start = keep, jobs = [checking, resetting, taken, mail.Job], verify = verified)
  dict.Put("Runner", jobs.Module(), made)
end

defn verified(env)
  (** The settings of the accounts at the start: a neutral sign-up needs addresses checked before a session (it can't
      give one to an address it doesn't tell is new), and mails need their transport. *)
  s = env.Settings
  if s.SignUpAnswer == "neutral" and s.EmailCheck != "required"
    return result.Err(["APP_SIGN_UP_ANSWER: neutral needs APP_EMAIL_CHECK=required: a sign-up that answers the same for a new address and a taken one gives a session to neither."])
  end
  if s.EmailCheck == "off"
    return result.Ok(missing)
  end
  mail.Verify(env)
end

roleList(t) = [text.Trim(x) for x in text.Split(",", t) if text.Trim(x) != ""]   (* The roles of a setting, "owner, admin". *)

(* The hash of a random password nobody knows (Argon2id, libsodium's interactive settings): a login that doesn't exist
   is checked against it, so it takes as long as a wrong password, and the time of a reply tells nobody which logins
   exist. *)
decoy = "$$argon2id$$v=19$$m=65536,t=2,p=1$$crNLABulUben0mWFZ8tnXQ$$42BLBYgOif7Au07gDm+Z4J0NtqJ8u7dlYFEZyNpKw5c"

defn hashed(password, env)
  (** The Argon2id hash of a password, in one of the slots of the hashes (64 MiB each), or a 503 when too many wait. *)
  if not app.Slot(env.State)
    return app.Fail(503, "Too many sign-ins at once: try again in a moment.")
  end
  h = crypto.HashPassword(password, env.Keys)
  app.Free(env.State)
  result.Ok(h)
end

defn matches(password, hash, env)
  (** Does a password match its hash, in a slot of the hashes. *)
  if not app.Slot(env.State)
    return app.Fail(503, "Too many sign-ins at once: try again in a moment.")
  end
  ok = crypto.CheckPassword(password, hash, env.Keys)
  app.Free(env.State)
  result.Ok(ok)
end

defn gate(key, per, period, r)
  (** A limit of the accounts, as many as per in period seconds, at once too: an Ok, or a 429. *)
  allowed = app.Allow([app.Limit(key, per, period, per)], r.Env.State)
  if allowed.Ok
    return result.Ok(true)
  end
  note(r, "limited", "Too many: $key.")
  result.Err({Kind: "api", Status: 429, Message: "Too many attempts: wait $(allowed.Retry) seconds.", Retry: allowed.Retry})
end

defn note(r, kind, detail, user = missing, tenant = missing, every = 60)
  (** An event of the accounts, at most once a minute for the same kind, address and detail (every = 0: always). *)
  if every == 0 or app.Fresh("$kind $(r.Ip) $detail", every, r.Env.State)
    _ = app.Note(r.Env, kind, detail, user = user, tenant = tenant, ip = r.Ip, route = r.Route)
  end
end

defn proven(x, needed, r)
  (** An Ok when no proof of work is needed or the proof given answers a fresh challenge, else a 428 with a new one. *)
  if not needed
    return result.Ok(true)
  end
  bits = r.Settings.PowBits
  if value.IsText(dict.Get("Proof", x)) and Proved(x.Proof, bits, r.Env)?
    return result.Ok(true)
  end
  note(r, "pow", "A proof of work was asked.")
  result.Err({Kind: "api", Status: 428, Message: "Answer this challenge first, then send again with Proof.", Challenge: {Challenge: NewChallenge(bits, r.Env), Bits: bits}})
end

defn honeypot(r)
  (** Did a bot fill the trap field (the setting Honeypot), which a page hides from people? *)
  name = r.Settings.Honeypot
  if name == "" or text.ByteLength(r.Body) > 65536
    return false
  end
  got = json.Parse(r.Body)
  v = if result.IsOk(got) and value.IsDict(got.Value) dict.Get(name, got.Value) else missing end
  not value.IsMissing(v) and v != ""
end

defn tenantName(id, db)
  t = if value.IsMissing(id) result.Ok(missing) else cepheus.Get(Tenant, id, db) end
  if result.IsOk(t) and not value.IsMissing(t.Value) dict.GetOr("Name", "", t.Value) else "" end
end

defn account(user, tenant, roles, db, table)
  (** The Account of a user in a tenant. *)
  u = cepheus.Get(User, user, db)?
  result.Ok({User: user, Email: u.Email, Name: dict.GetOr("Name", "", u), Tenant: tenant, TenantName: tenantName(tenant, db),
    Roles: app.Expand(roles, table), Super: u.Super == true, Checked: not value.IsMissing(dict.Get("Checked", u))})
end

defn single(env)
  (** The one tenant of a single-tenant app: an Ok of its id, made at its first use (its Key is unique). *)
  for attempt in 1..3
    found = cepheus.Find(1, t -> {Where: [[t, Tenant.Key, "single"]], Give: {T: t}}, env.Db)?
    if value.Len(found) > 0
      return result.Ok(found[1].T)
    end
    made = cepheus.Insert(Tenant, {Key: "single", Name: "", Search: "", Created: env.Now()}, env.Db, why = "the single tenant")
    if result.IsOk(made) or made.Error.Code != "unique"
      return made
    end
  end
  app.Fail(503, "The tenant is being made: try again.")
end

defn invitation(code, email, env)
  (** The invitation of a code for this e-mail, still open: an Ok of {Id, Tenant, Roles, Gone}, Gone the operations
      that take it once used, or a 403. *)
  bad = app.Fail(403, "This invitation is not yours, or it has ended.")
  if not value.IsText(code) or text.ByteLength(code) > 200
    return bad
  end
  found = cepheus.Find(1, i -> {Where: [[i, Invite.Hash, hashOf(code, env.Keys)]], Give: {Id: i}}, env.Db)?
  if value.Len(found) == 0
    return bad
  end
  id = found[1].Id
  inv = cepheus.Get(Invite, id, env.Db)?
  if value.IsMissing(inv) or inv.Email != email or inv.Ends < env.Now()
    return bad
  end
  result.Ok({Id: id, Tenant: inv.Tenant, Roles: inv.Roles, Gone: app.Gone(Invite, id, env.Db)?})
end

(* The answer of a sign-up whose address must be checked first: 202, no session, the same for a taken address when the
   answer is neutral. *)
waiting = app.Reply({}, status = 202)

defn signingUp(r, x, facts, kinds)
  (** POST /auth/signup. *)
  env = r.Env
  s = r.Settings
  if s.SignUp == "closed"
    return app.Fail(403, "Signing up is closed: ask an administrator.")
  end
  if s.SignUp == "invite" and value.IsMissing(x.Invite)
    return app.Fail(403, "Signing up is by invitation only: use the link of yours.")
  end
  if honeypot(r)
    note(r, "bot", "The trap field of signing up was filled.")
    return app.Fail(422, "Check the fields.")
  end
  gate("signup:$(r.Ip)", s.SignUpPerIp, 3600, r)?
  proven(x, s.Pow == "always" or (s.Pow == "attack" and app.Failures(env.State) >= s.PowAfter), r)?
  if text.ByteLength(x.Password) < s.PasswordMin
    return app.Fail(422, "Check the fields.", fields = {Password: "A password of $(s.PasswordMin) to 128 bytes."})
  end
  hash = hashed(x.Password, env)?
  now = env.Now()
  neutral = s.SignUpAnswer == "neutral"
  if neutral and value.Len(cepheus.Find(1, u -> {Where: [[u, User.Email, x.Email]], Give: {U: u}}, env.Db)?) > 0
    return takenAnswer(x, r, kinds)
  end
  ops = app.Facts(User, cepheus.New(1), {Email: x.Email, Name: x.Name, Hash: hash, Super: false, Disabled: false, Created: now})
  next = 2
  tenant = missing
  roles = []
  made = false
  if not value.IsMissing(x.Invite)
    inv = invitation(x.Invite, x.Email, env)?
    tenant = inv.Tenant
    roles = inv.Roles
    ops = list.Concat(ops, inv.Gone)
  else if s.Tenancy == "single"
    tenant = single(env)?
    t = cepheus.Get(Tenant, tenant, env.Db)?
    if value.IsMissing(t.Owner)
      roles = roleList(s.OwnerRoles)
      ops = list.Concat(ops, [cepheus.Expect(tenant, Tenant.Owner), cepheus.Add(tenant, Tenant.Owner, cepheus.New(1))])
    else
      roles = roleList(s.MemberRoles)
    end
  else
    gate("tenants", s.TenantsPerHour, 3600, r)?
    name = if value.IsMissing(x.Tenant) x.Name else x.Tenant end
    tenant = cepheus.New(next)
    next += 1
    made = true
    roles = roleList(s.OwnerRoles)
    ops = list.Concat(ops, app.Facts(Tenant, tenant, {Name: name, Search: text.Lower(name), Created: now, Owner: cepheus.New(1)}))
  end
  member = next
  ops = list.Concat(ops, app.Facts(Member, cepheus.New(member), {User: cepheus.New(1), Tenant: tenant, Roles: roles, Created: now}))
  required = s.EmailCheck == "required"
  session = NewSession(cepheus.New(1), cepheus.New(member), tenant, r, env, thing = member + 1)
  if not required
    ops = list.Concat(ops, session.Ops)
  end
  if s.EmailCheck != "off"
    ops = list.Concat(ops, jobs.Later(kinds.Check, {User: cepheus.New(1)}, thing = member + 2))
  end
  if not value.IsMissing(facts)
    ops = list.Concat(ops, facts(cepheus.New(1), tenant, x))
  end
  done = cepheus.Write(ops, env.Db, why = r.Why)
  if result.IsErr(done) and done.Error.Code == "unique"
    if neutral
      return takenAnswer(x, r, kinds)
    end
    return app.Fail(409, "Check the fields.", fields = {Email: "This e-mail has an account already: sign in."})
  end
  if result.IsErr(done) and done.Error.Code == "conflict" and s.Tenancy == "single"
    return app.Fail(409, "Someone signed up at the same moment: send again.")
  end
  things = done?.Things
  user = things[1]
  tenantId = if made things[2] else tenant end
  note(r, "signup", "Signed up.", user = user, tenant = tenantId, every = 0)
  if required
    return waiting
  end
  out = account(user, tenantId, roles, env.Db, env.Roles)?
  app.Reply(out, headers = [Cookie(session.Value(things[member + 1]), env, s.SessionMax)])
end

defn takenAnswer(x, r, kinds)
  (** The neutral answer to a sign-up with an address that has an account: the same 202 as for a new one, after one
      write as a new one makes, the job of a mail to the owner of the address, which tells him, and not the sender. *)
  _ = cepheus.Write(jobs.Later(kinds.Taken, {Email: x.Email}), r.Env.Db, why = r.Why)
  note(r, "signup-taken", "A sign-up with an address that has an account.")
  waiting
end

defn lockWait(f, s)
  (** The seconds a login waits after its failures in a row: none before LockAfter, then 1, 2, 4... up to LockMost. *)
  if f.Count < s.LockAfter 0 else list.Min([s.LockMost, pow2(list.Min([30, f.Count - s.LockAfter]))]) end
end

defn pow2(k)
  out = 1
  for i in 1..k
    out = out * 2
  end
  out
end

defn failureOf(key, db)
  (** The failures in a row of a login: an Ok of {Id, Count, Last}, or of missing. *)
  found = cepheus.Find(3, (f, c, l) -> {Where: [[f, Failure.Key, key], [f, Failure.Count, c], [f, Failure.Last, l]], Give: {Id: f, Count: c, Last: l}}, db)?
  result.Ok(if value.Len(found) > 0 found[1] else missing end)
end

defn failing(key, f, r)
  (** Counts a failure of a login, in Cepheus (every worker sees it) and in the failures of the last minute. *)
  app.Failed(r.Env.State)
  now = r.Env.Now()
  done = if value.IsMissing(f) cepheus.Insert(Failure, {Key: key, Count: 1, Last: now}, r.Env.Db, why = "sign-in failed")
    else cepheus.Write([cepheus.Incr(f.Id, Failure.Count), cepheus.Add(f.Id, Failure.Last, now)], r.Env.Db, why = "sign-in failed") end
  if result.IsErr(done)
    log.Warn("a failure of sign-in was not counted", {Code: dict.Get("Code", done.Error)})
  end
  note(r, "signin-failed", key)
end

defn membershipOf(user, tenant, db)
  (** The membership of a user in a tenant, or his first one when tenant is missing: an Ok of {Member, Tenant, Roles},
      or of missing. *)
  rows = if value.IsMissing(tenant)
    cepheus.Find(3, (m, t, c) -> {Where: [[m, Member.User, user], [m, Member.Tenant, t], [m, Member.Created, c]], Give: {Member: m, Tenant: t, Created: c}, Sort: [c, m], Limit: 1}, db)?
  else
    cepheus.Find(1, m -> {Where: [[m, Member.User, user], [m, Member.Tenant, tenant]], Give: {Member: m}}, db)?
  end
  if value.Len(rows) == 0
    return result.Ok(missing)
  end
  m = cepheus.Get(Member, rows[1].Member, db)?
  result.Ok({Member: rows[1].Member, Tenant: m.Tenant, Roles: m.Roles})
end

defn signingIn(r, x, kinds)
  (** POST /auth/signin. *)
  env = r.Env
  s = r.Settings
  gate("signin:$(r.Ip)", s.SignInPerIp, 60, r)?
  key = "login:$(x.Email)"
  f = failureOf(key, env.Db)?
  if not value.IsMissing(f)
    wait = f.Last + lockWait(f, s) - env.Now()
    if wait > 0
      note(r, "locked", key)
      return result.Err({Kind: "api", Status: 429, Message: "Too many failed sign-ins: wait $(math.Ceil(wait)) seconds.", Retry: math.Ceil(wait)})
    end
  end
  under = s.Pow == "always" or (s.Pow == "attack" and (app.Failures(env.State) >= s.PowAfter or (not value.IsMissing(f) and f.Count >= 3)))
  proven(x, under, r)?
  found = cepheus.Find(2, (u, h) -> {Where: [[u, User.Email, x.Email], [u, User.Hash, h]], Give: {User: u, Hash: h}}, env.Db)?
  ok = matches(x.Password, if value.Len(found) == 1 found[1].Hash else decoy end, env)?
  u = if value.Len(found) == 1 cepheus.Get(User, found[1].User, env.Db)? else missing end
  if not ok or value.IsMissing(u) or u.Disabled == true
    failing(key, f, r)
    return app.Fail(401, "This e-mail and password don't match.")
  end
  user = found[1].User
  if not value.IsMissing(f) and f.Count > 0
    _ = cepheus.Write([cepheus.Add(f.Id, Failure.Count, 0)], env.Db, why = "signed in")
  end
  if s.EmailCheck == "required" and value.IsMissing(dict.Get("Checked", u))
    if app.Fresh("check $user", 600, env.State)
      _ = cepheus.Write(jobs.Later(kinds.Check, {User: user}), env.Db, why = r.Why)
    end
    return app.Fail(403, "Check your e-mail address first: open the link of the mail we sent you.")
  end
  m = membershipOf(user, x.Tenant, env.Db)?
  if value.IsMissing(m) and not value.IsMissing(x.Tenant)
    return app.Fail(403, "You are no member of this tenant.")
  end
  opened(user, m, r, "signin")
end

defn opened(user, m, r, kind)
  (** A new session of a user in a membership (missing for none): its cookie, and the Account. *)
  env = r.Env
  member = if value.IsMissing(m) missing else m.Member end
  tenant = if value.IsMissing(m) missing else m.Tenant end
  session = NewSession(user, member, tenant, r, env)
  done = cepheus.Write(session.Ops, env.Db, by = user, why = r.Why)?
  note(r, kind, "Signed in.", user = user, tenant = tenant, every = 0)
  out = account(user, tenant, if value.IsMissing(m) [] else m.Roles end, env.Db, env.Roles)?
  app.Reply(out, headers = [Cookie(session.Value(done.Things[1]), env, r.Settings.SessionMax)])
end

defn signingOut(r)
  (** POST /auth/signout: the session ends, and its cookie. *)
  EndSessions([r.User.Session], r.User.Id, r.Why, r.Env.Db)?
  app.Reply(missing, headers = [Cookie("", r.Env, 0)])
end

defn signingOutAll(r)
  (** POST /auth/signout-all: every session of the user ends. *)
  EndSessions([x.Id for x in SessionsOf(r.User.Id, r.Env.Db)?], r.User.Id, r.Why, r.Env.Db)?
  note(r, "signout-all", "Every session ended.", user = r.User.Id, tenant = r.User.Tenant, every = 0)
  app.Reply(missing, headers = [Cookie("", r.Env, 0)])
end

defn me(r)
  (** GET /auth/me. *)
  u = r.User
  result.Ok({User: u.Id, Email: u.Email, Name: u.Name, Tenant: u.Tenant, TenantName: tenantName(u.Tenant, r.Db), Roles: u.Roles, Super: u.Super,
    Checked: dict.GetOr("Checked", false, u)})
end

defn sessions(r)
  (** GET /auth/sessions: the user's, this one marked. *)
  rows = SessionsOf(r.User.Id, r.Db)?
  result.Ok([dict.Put("Current", x.Id == r.User.Session, x) for x in rows])
end

defn endSession(r)
  (** DELETE /auth/sessions/:id: one of the user's own, else a 404. *)
  id = app.IdOf(r.Params.id)
  s = if value.IsMissing(id) missing else cepheus.Get(Session, id, r.Db)? end
  if value.IsMissing(s) or not value.Equal(s.User, r.User.Id)
    return app.Missing()
  end
  EndSessions([id], r.User.Id, r.Why, r.Db)?
  result.Ok(missing)
end

defn changePassword(r, x)
  (** POST /auth/password: the old password checked, the new one hashed, the user's other sessions ended. *)
  env = r.Env
  if text.ByteLength(x.New) < r.Settings.PasswordMin
    return app.Fail(422, "Check the fields.", fields = {New: "A password of $(r.Settings.PasswordMin) to 128 bytes."})
  end
  u = cepheus.Get(User, r.User.Id, r.Db)?
  if not matches(x.Old, u.Hash, env)?
    failing("login:$(u.Email)", failureOf("login:$(u.Email)", env.Db)?, r)
    return app.Fail(403, "The old password is not this one.")
  end
  hash = hashed(x.New, env)?
  cepheus.Write([cepheus.Expect(r.User.Id, User.Hash, u.Hash), cepheus.Add(r.User.Id, User.Hash, hash)], r.Db, by = r.User.Id, why = r.Why)?
  EndSessions([s.Id for s in SessionsOf(r.User.Id, r.Db)? if s.Id != r.User.Session], r.User.Id, r.Why, r.Db)?
  note(r, "password", "The password changed.", user = r.User.Id, tenant = r.User.Tenant, every = 0)
  result.Ok(missing)
end

defn challenge(r)
  (** GET /auth/challenge. *)
  s = r.Settings
  if s.Pow == "off" {Challenge: "", Bits: 0} else {Challenge: NewChallenge(s.PowBits, r.Env), Bits: s.PowBits} end
end

defn myTenants(r)
  (** GET /auth/tenants. *)
  rows = cepheus.Find(2, (m, t) -> {Where: [[m, Member.User, r.User.Id], [m, Member.Tenant, t]], Give: {Member: m, Tenant: t}, Sort: [t]}, r.Db)?
  result.Ok([{Tenant: x.Tenant, Name: tenantName(x.Tenant, r.Db), Roles: app.Expand(cepheus.Get(Member, x.Member, r.Db)?.Roles, r.Env.Roles)} for x in rows])
end

defn switchTenant(r, x)
  (** POST /auth/tenant: a new session in another tenant of the user; this one ends. *)
  m = membershipOf(r.User.Id, x.Tenant, r.Db)?
  if value.IsMissing(m)
    return app.Fail(403, "You are no member of this tenant.")
  end
  EndSessions([r.User.Session], r.User.Id, r.Why, r.Db)?
  opened(r.User.Id, m, r, "switch")
end

(* The answer of a request that sends a mail, or seems to: 202, the same whatever the address. *)
sent = app.Reply(missing, status = 202)

defn newCode(user, kind, seconds, env)
  (** A code of a mail for a user: {Ops, Code}, the operations that keep its hash until seconds from now, and the code,
      32 random bytes of the kernel in hex, which only the mail holds. *)
  code = encode.Hex(crypto.Random(32, env.Keys))
  {Ops: app.Facts(Code, cepheus.New(1), {User: user, Kind: kind, Hash: hashOf(code, env.Keys), Ends: env.Now() + seconds}), Code: code}
end

defn codeOf(code, kind, env)
  (** The code of a mail, of this kind and still open: an Ok of {Id, User, Gone}, Gone the operations that end it, or a
      403 that says nothing of why. *)
  bad = app.Fail(403, "This link is not valid, or it has ended: ask for a new one.")
  if not value.IsText(code) or text.ByteLength(code) != 64
    return bad
  end
  found = cepheus.Find(1, c -> {Where: [[c, Code.Hash, hashOf(code, env.Keys)]], Give: {Id: c}}, env.Db)?
  if value.Len(found) == 0
    return bad
  end
  c = cepheus.Get(Code, found[1].Id, env.Db)?
  if value.IsMissing(c) or c.Kind != kind or c.Ends < env.Now()
    return bad
  end
  result.Ok({Id: found[1].Id, User: c.User, Gone: list.Concat([cepheus.Expect(found[1].Id, Code.Ends, c.Ends)], app.Gone(Code, found[1].Id, env.Db)?)})
end

defn link(env, page, code)
  (** The link of a mail: the page of the front at Origin, the code in its fragment, which the browser never sends to a
      server, so that no log and no Referer holds it. *)
  "$(env.Settings.Origin)$page#code=$code"
end

defn mailed(user, kind, page, seconds, texts, env)
  (** The job of a mail with a code: the code made and kept, then the mail sent; an Err to try again. A user disabled,
      or gone, gets nothing. *)
  u = cepheus.Get(User, user, env.Db)?
  if value.IsMissing(u) or u.Disabled == true
    return result.Ok(missing)
  end
  c = newCode(user, kind, seconds, env)
  cepheus.Write(c.Ops, env.Db, why = env.Why)?
  words = texts({Link: link(env, page, c.Code), Name: dict.GetOr("Name", "", u), Email: u.Email, App: env.App.Name, Hours: math.Ceil(seconds / 3600)})
  m = {To: [u.Email], Subject: words.Subject, Text: words.Text}
  if dict.Has("Html", words)
    m.Html = words.Html
  end
  sent = mail.Send(env, m)
  if result.IsErr(sent) and dict.Get("Code", sent.Error) == "refused"
    return jobs.Stop(sent.Error.Message)
  end
  sent
end

defn checkJob(job, env, texts)
  (** The job of the mail that checks an address: of a user, or of the account of an address when its address is not
      yet checked. *)
  user = if value.IsMissing(dict.Get("User", job)) userOf(job.Email, env.Db)? else job.User end
  if value.IsMissing(user)
    return result.Ok(missing)
  end
  u = cepheus.Get(User, user, env.Db)?
  if value.IsMissing(dict.Get("User", job)) and not value.IsMissing(u) and not value.IsMissing(dict.Get("Checked", u))
    return result.Ok(missing)
  end
  mailed(user, "check", env.Settings.CheckPage, env.Settings.CheckTime, texts, env)
end

defn userOf(email, db)
  (** The user of an address, or missing. *)
  found = cepheus.Find(1, u -> {Where: [[u, User.Email, email]], Give: {U: u}}, db)?
  result.Ok(if value.Len(found) == 0 missing else found[1].U end)
end

defn resetJob(job, env, texts)
  (** The job of a forgotten password: the mail goes only to an address that has an account. *)
  user = userOf(job.Email, env.Db)?
  if value.IsMissing(user) result.Ok(missing) else mailed(user, "reset", env.Settings.ResetPage, env.Settings.ResetTime, texts, env) end
end

defn takenJob(job, env, texts)
  (** The job of the mail to the owner of an address that someone tried to sign up with: a link to set a new password,
      in case it was him and he forgot it. *)
  user = userOf(job.Email, env.Db)?
  if value.IsMissing(user) result.Ok(missing) else mailed(user, "reset", env.Settings.ResetPage, env.Settings.ResetTime, texts, env) end
end

defn mailGate(email, r)
  (** The limits of the mails of an address: MailsPerHour for each address, and the sign-ups of the sender's, so that
      nobody fills a stranger's box. *)
  gate("signup:$(r.Ip)", r.Settings.SignUpPerIp, 3600, r)?
  gate("mail:$email", r.Settings.MailsPerHour, 3600, r)
end

defn checkEmail(r, x)
  (** POST /auth/check: the address checked, the code ended, and a new session. *)
  env = r.Env
  gate("signin:$(r.Ip)", r.Settings.SignInPerIp, 60, r)?
  c = codeOf(x.Code, "check", env)?
  u = cepheus.Get(User, c.User, env.Db)?
  if value.IsMissing(u) or u.Disabled == true
    return app.Fail(403, "This link is not valid, or it has ended: ask for a new one.")
  end
  ops = c.Gone
  if value.IsMissing(dict.Get("Checked", u))
    ops = list.Append(cepheus.Add(c.User, User.Checked, env.Now()), ops)
  end
  done = cepheus.Write(ops, env.Db, by = c.User, why = r.Why)
  if result.IsErr(done)
    return app.Fail(403, "This link is not valid, or it has ended: ask for a new one.")
  end
  note(r, "checked", "The address was checked.", user = c.User, every = 0)
  opened(c.User, membershipOf(c.User, missing, env.Db)?, r, "checked")
end

defn sendCheck(r, x, kinds)
  (** POST /auth/check/send: one write, the job of the mail, whatever the address; the job sends it only to an
      account whose address is not yet checked. 202 always. *)
  mailGate(x.Email, r)?
  _ = cepheus.Write(jobs.Later(kinds.Check, {Email: x.Email}), r.Env.Db, why = r.Why)
  sent
end

defn forgot(r, x, kinds)
  (** POST /auth/forgot: one write, the job of the mail, whatever the address; the job sends it only to an account. *)
  mailGate(x.Email, r)?
  _ = cepheus.Write(jobs.Later(kinds.Reset, {Email: x.Email}), r.Env.Db, why = r.Why)
  sent
end

defn resetPassword(r, x)
  (** POST /auth/reset: the new password, the code ended, the address checked (the mail reached it), every session of
      the user ended, and a new one. *)
  env = r.Env
  s = r.Settings
  gate("signin:$(r.Ip)", s.SignInPerIp, 60, r)?
  if text.ByteLength(x.Password) < s.PasswordMin
    return app.Fail(422, "Check the fields.", fields = {Password: "A password of $(s.PasswordMin) to 128 bytes."})
  end
  c = codeOf(x.Code, "reset", env)?
  u = cepheus.Get(User, c.User, env.Db)?
  if value.IsMissing(u) or u.Disabled == true
    return app.Fail(403, "This link is not valid, or it has ended: ask for a new one.")
  end
  hash = hashed(x.Password, env)?
  ops = list.Concat(c.Gone, [cepheus.Expect(c.User, User.Hash, u.Hash), cepheus.Add(c.User, User.Hash, hash)])
  if value.IsMissing(dict.Get("Checked", u))
    ops = list.Append(cepheus.Add(c.User, User.Checked, env.Now()), ops)
  end
  done = cepheus.Write(ops, env.Db, by = c.User, why = r.Why)
  if result.IsErr(done)
    return app.Fail(403, "This link is not valid, or it has ended: ask for a new one.")
  end
  EndSessions([one.Id for one in SessionsOf(c.User, env.Db)?], c.User, r.Why, env.Db)?
  app.ForgetSessions(env.State)
  note(r, "password", "A new password by the link of a mail.", user = c.User, every = 0)
  opened(c.User, membershipOf(c.User, missing, env.Db)?, r, "reset")
end

defn keep(env)
  (** The keeper of the accounts, every minute: forgets the sessions that ended or stayed idle too long, the challenges
      answered that ended, the invitations that ended, 500 of each at most a round. *)
  while true
    sys.Sleep(60)
    _ = Sweep(env)
  end
end

defn Sweep(env)
  (** One round of the keeper: an Ok of how many sessions it ended and facts it took. *)
  now = env.Now()
  idle = now - env.Settings.SessionIdle
  old = cepheus.Find(2, (s, e) -> {Where: [[s, Session.Ends, e], cepheus.Below(e, now)], Give: {Id: s}, Limit: 500}, env.Db)?
  quiet = cepheus.Find(2, (s, e) -> {Where: [[s, Session.Seen, e], cepheus.Below(e, idle)], Give: {Id: s}, Limit: 500}, env.Db)?
  ids = list.Unique(list.Concat([x.Id for x in old], [x.Id for x in quiet]))
  EndSessions(ids, 0, "sessions ended", env.Db)?
  ops = []
  for p in cepheus.Find(2, (p, e) -> {Where: [[p, Proof.Ends, e], cepheus.Below(e, now)], Give: {Id: p}, Limit: 500}, env.Db)?
    ops = list.Concat(ops, app.Gone(Proof, p.Id, env.Db)?)
  end
  for i in cepheus.Find(2, (i, e) -> {Where: [[i, Invite.Ends, e], cepheus.Below(e, now)], Give: {Id: i}, Limit: 500}, env.Db)?
    ops = list.Concat(ops, app.Gone(Invite, i.Id, env.Db)?)
  end
  for c in cepheus.Find(2, (c, e) -> {Where: [[c, Code.Ends, e], cepheus.Below(e, now)], Give: {Id: c}, Limit: 500}, env.Db)?
    ops = list.Concat(ops, app.Gone(Code, c.Id, env.Db)?)
  end
  if value.Len(ops) > 0
    cepheus.Write(ops, env.Db, why = "challenges and invitations ended")?
  end
  result.Ok(value.Len(ids) + value.Len(ops))
end

defn Admin(a)
  (** A program that makes a super-admin of the app, or makes a user one: APP_ADMIN_EMAIL, APP_ADMIN_PASSWORD (12
      bytes at least) and the settings of the database come from the environment, never from the command line, which
      other users of the machine see. A task of the app runs it: cesia do admin. *)
  s = app.Load(a.Fields, defaults = a.Defaults)
  if result.IsErr(s)
    for l in s.Error
      io.PrintError("centauri: $l")
    end
    sys.Exit(2)
  end
  email = check.Read(check.Email(), sys.Env("APP_ADMIN_EMAIL"))
  password = sys.Env("APP_ADMIN_PASSWORD")
  if result.IsErr(email) or not value.IsText(password) or text.ByteLength(password) < 12 or text.ByteLength(password) > 128
    io.PrintError("centauri: APP_ADMIN_EMAIL is an e-mail address and APP_ADMIN_PASSWORD 12 to 128 bytes.")
    sys.Exit(2)
  end
  db = result.Unwrap(cepheus.Connect(s.Value.CepheusUrl, a.Kinds, token = dict.Get("CepheusToken", s.Value), ca = dict.Get("CepheusCa", s.Value)))
  made = MakeSuper(email.Value, password, result.Unwrap(crypto.Open()), db)
  if result.IsErr(made)
    io.PrintError("centauri: $(made.Error.Message)")
    sys.Exit(1)
  end
  io.Print("$(email.Value) is a super-admin.")
end

defn MakeSuper(email, password, keys, db, now = missing)
  (** A user of this e-mail becomes a super-admin, with this password; made when he doesn't exist. An Ok of his id. *)
  found = cepheus.Find(1, u -> {Where: [[u, User.Email, email]], Give: {User: u}}, db)?
  hash = crypto.HashPassword(password, keys)
  if value.Len(found) == 0
    at = if value.IsMissing(now) sys.Now() else now end
    return cepheus.Insert(User, {Email: email, Name: "", Hash: hash, Super: true, Disabled: false, Created: at, Checked: at}, db, why = "super-admin made")
  end
  id = found[1].User
  cepheus.Update(User, id, {Hash: hash, Super: true, Disabled: false, Checked: if value.IsMissing(now) sys.Now() else now end}, db, why = "super-admin made")?
  result.Ok(id)
end
